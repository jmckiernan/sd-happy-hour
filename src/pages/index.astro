        <select class="filter-btn" id="status-filter" aria-label="Filter directory by current status">
          <option value="">All spots</option>
          <option value="happy-hour-now">Happy Hour Now</option>
        </select>

        <select class="filter-btn" id="trust-filter" aria-label="Filter by trust status">
