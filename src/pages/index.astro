      <div class="results-info">
        <span><strong id="result-count">0</strong> spots</span>
        <span class="distance-info" id="distance-info" style="display: none;"></span>
        <span class="excluded-note" id="excluded-note" hidden aria-live="polite"></span>
      </div>

      <div class="save-alert-panel hidden" id="save-alert-panel">
        <input type="text" id="alert-name-input" placeholder="Name this alert (e.g. Friday Rooftop Wine)" maxlength="60">
        <label class="channel-check"><input type="checkbox" id="alert-channel-email" checked> Email</label>
        <label class="channel-check"><input type="checkbox" id="alert-channel-text"> Text <span class="channel-note" id="alert-text-note">(set up in <a href="/account/#section-preferences">My Stuff → Preferences</a>)</span></label>
        <button type="button" id="alert-save-confirm">Save Alert</button>
        <button type="button" class="secondary" id="alert-save-cancel">Cancel</button>
        <span class="status" id="alert-save-status" aria-live="polite"></span>
      </div>
    </div>
  </section>

  <!-- MAIN -->
  <main class="main">
    <div class="map-container" id="map-container">
      <div id="map" aria-label="Map of filtered happy hour venues"></div>
    </div>

    <div class="grid" id="grid"></div>

    <div class="empty-state" id="empty-state" style="display: none;">
      <h2>No spots found</h2>
      <p>Try adjusting your filters or check back later</p>
    </div>
  </main>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <script>
    import {
      deriveConsumerPromotionState,
      type ConsumerPromotionState,
    } from '../lib/consumerPromotionState';
    import {
      createLivePromotionFeed,
      type LivePromotionFeedSnapshot,
    } from '../lib/livePromotionFeed';
    import {
      formatSanDiegoTime,
    } from '../lib/promotionClientTime';
    import {
      getHappyHourOccurrenceForDate,
      getSanDiegoDayBounds,
      getSanDiegoParts,
    } from '../lib/sanDiegoTime';
    import { getListingImage, venuePath, venueSlug } from '../lib/venues';
    import { listingImageStyle } from '../lib/imageCrop';
    import { cardSpecials, cardTimeLabel } from '../lib/listingCopy';
    import { isPubliclyListed } from '../lib/listingVisibility';
    import { venueSearchText } from '../lib/venueSearchText';
    import {
      OFFERS_UNKNOWN_FILTER,
      readStoredDirectoryFilters,
      writeStoredDirectoryFilters,
      type DirectoryFiltersState,
    } from '../lib/directoryFilters';

    let baseHappyHours: any[] = [];
    let happyHours: any[] = [];
    let venueDirectoryLoaded = false;
    let venueDirectoryRefreshPromise: Promise<void> | null = null;
    let userLocation: { lat: number; lng: number } | null = null;
    let map: any = null;
    let markers: any[] = [];
    let accountUser: any = null;
    let saveConfirmation: { spotId: number; text: string } | null = null;
    const pendingSaveListSelections = new Map<number, string>();
    let dayFilterInitialized = false;
    let dayFilterTouched = false;
    let automaticDayFilter = '';
    let recurringBoundaryTimer: number | null = null;
    let lastRenderedHadFeedData = false;
    let lastRenderedPromotionSignature = '';
    let lastRenderedVenueStateSignature = '';
    let directoryFiltersRestored = false;
    let persistDirectoryFiltersTimer: number | null = null;

    const livePromotionFeed = createLivePromotionFeed();
    let feedSnapshot: LivePromotionFeedSnapshot = livePromotionFeed.getSnapshot();
    const EMPTY_CONSUMER_STATE: ConsumerPromotionState = {
      state: 'neither',
      happyHourOccurrence: null,
      liveDeals: [],
    };

    function escapeHTML(value: unknown) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      } as Record<string, string>)[char]);
    }

    function labelize(value: string) {
      return value.replace(/\b\w/g, (letter) => letter.toUpperCase());
    }

    const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const dayAbbrev = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
    const dayFilterEl = document.getElementById('day-filter') as HTMLSelectElement;

    function getServerNow() {
      return feedSnapshot.data?.clock.now() ?? null;
    }

    function syncServerTimePresentation(now: Date) {
      const sanDiego = getSanDiegoParts(now);
      document.getElementById('current-time')!.textContent = formatSanDiegoTime(now);
      if (!dayFilterInitialized || (!dayFilterTouched && dayFilterEl.value === automaticDayFilter)) {
        dayFilterEl.value = sanDiego.weekday;
        automaticDayFilter = sanDiego.weekday;
        dayFilterInitialized = true;
      }
      return dayNames.indexOf(sanDiego.weekday);
    }

    function refreshTimedPresentation(now: Date) {
      document.getElementById('current-time')!.textContent = formatSanDiegoTime(now);
    }

    function dateKeyAfter(dateKey: string, days: number) {
      const [year, month, day] = dateKey.split('-').map(Number);
      const value = new Date(Date.UTC(year, month - 1, day + days));
      return [
        value.getUTCFullYear(),
        String(value.getUTCMonth() + 1).padStart(2, '0'),
        String(value.getUTCDate()).padStart(2, '0'),
      ].join('-');
    }

    function scheduleRecurringBoundaryRefresh(now: Date) {
      if (recurringBoundaryTimer !== null) window.clearTimeout(recurringBoundaryTimer);
      const nowMilliseconds = now.getTime();
      let nextBoundary = getSanDiegoDayBounds(now).end.getTime();
      const todayKey = getSanDiegoDayBounds(now).dateKey;

      for (const venue of happyHours) {
        for (let offset = 0; offset <= 7; offset += 1) {
          const occurrence = getHappyHourOccurrenceForDate(venue, dateKeyAfter(todayKey, offset));
          if (!occurrence) continue;
          for (const boundary of [occurrence.startsAt, occurrence.endsAt]) {
            const boundaryMilliseconds = boundary.getTime();
            if (boundaryMilliseconds > nowMilliseconds && boundaryMilliseconds < nextBoundary) {
              nextBoundary = boundaryMilliseconds;
            }
          }
        }
      }

      recurringBoundaryTimer = window.setTimeout(() => {
        const anchoredNow = getServerNow();
        if (anchoredNow) render(anchoredNow);
      }, Math.max(25, nextBoundary - nowMilliseconds + 25));
    }

    function getDistance(lat1: number, lng1: number, lat2: number, lng2: number) {
      const R = 3959;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLng = (lng2 - lng1) * Math.PI / 180;
      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLng/2) * Math.sin(dLng/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return R * c;
    }

    function formatDistance(miles: number) {
      if (miles < 0.1) return 'Nearby';
      if (miles < 1) return `${(miles * 5280 / 1000).toFixed(1)}k ft`;
      return `${miles.toFixed(1)} mi`;
    }

    function setSelectValue(id: string, value: string | undefined) {
      const select = document.getElementById(id) as HTMLSelectElement | null;
      if (!select || value === undefined) return;
      if (!value || [...select.options].some((option) => option.value === value)) {
        select.value = value;
      }
    }

    function collectDirectoryFilters(): DirectoryFiltersState {
      const listViewActive = document.getElementById('list-view-btn')!.classList.contains('active');
      return {
        search: (document.getElementById('search-input') as HTMLInputElement).value,
        day: (document.getElementById('day-filter') as HTMLSelectElement).value,
        neighborhood: (document.getElementById('neighborhood-filter') as HTMLSelectElement).value,
        dealType: (document.getElementById('deal-filter') as HTMLSelectElement).value,
        status: (document.getElementById('status-filter') as HTMLSelectElement).value,
        trust: (document.getElementById('trust-filter') as HTMLSelectElement).value,
        nearMe: userLocation ? { ...userLocation } : null,
        view: listViewActive ? 'list' : 'map',
      };
    }

    function persistDirectoryFilters() {
      writeStoredDirectoryFilters(collectDirectoryFilters());
    }

    function schedulePersistDirectoryFilters() {
      if (persistDirectoryFiltersTimer !== null) window.clearTimeout(persistDirectoryFiltersTimer);
      persistDirectoryFiltersTimer = window.setTimeout(() => {
        persistDirectoryFiltersTimer = null;
        persistDirectoryFilters();
      }, 200);
    }

    function applyNearMeLocation(location: { lat: number; lng: number }) {
      userLocation = { lat: location.lat, lng: location.lng };
      const btn = document.getElementById('location-btn')!;
      const text = document.getElementById('location-text')!;
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      text.textContent = 'Sorted by distance';
      document.getElementById('distance-info')!.textContent = 'Sorted by distance';
      (document.getElementById('distance-info') as HTMLElement).style.display = 'inline';
      if (map) {
        map.setView([userLocation.lat, userLocation.lng], 13);
      }
    }

    function clearNearMeLocation() {
      userLocation = null;
      const btn = document.getElementById('location-btn')!;
      const text = document.getElementById('location-text')!;
      btn.classList.remove('active');
      btn.setAttribute('aria-pressed', 'false');
      text.textContent = 'Near me';
      (document.getElementById('distance-info') as HTMLElement).style.display = 'none';
    }

    function setViewMode(mode: 'list' | 'map') {
      const listBtn = document.getElementById('list-view-btn')!;
      const mapBtn = document.getElementById('map-view-btn')!;
      const mapContainer = document.getElementById('map-container')!;
      const grid = document.getElementById('grid')!;

      if (mode === 'list') {
        listBtn.classList.add('active');
        mapBtn.classList.remove('active');
        listBtn.setAttribute('aria-pressed', 'true');
        mapBtn.setAttribute('aria-pressed', 'false');
        mapContainer.classList.remove('active');
        grid.classList.remove('hidden');
        return;
      }

      mapBtn.classList.add('active');
      listBtn.classList.remove('active');
      mapBtn.setAttribute('aria-pressed', 'true');
      listBtn.setAttribute('aria-pressed', 'false');
      mapContainer.classList.add('active');
      grid.classList.add('hidden');

      if (!map) {
        initMap();
      }
      window.setTimeout(() => map.invalidateSize(), 100);
      updateMapMarkers();
    }

    function restoreDirectoryFilters() {
      const saved = readStoredDirectoryFilters();
      if (!saved) return;

      if (saved.search !== undefined) {
        (document.getElementById('search-input') as HTMLInputElement).value = saved.search;
      }
      if (saved.day !== undefined) {
        setSelectValue('day-filter', saved.day);
        dayFilterInitialized = true;
        dayFilterTouched = true;
      }
      setSelectValue('neighborhood-filter', saved.neighborhood);
      setSelectValue('deal-filter', saved.dealType);
      setSelectValue('status-filter', saved.status);
      setSelectValue('trust-filter', saved.trust);

      if (saved.nearMe) {
        applyNearMeLocation(saved.nearMe);
      } else if (saved.nearMe === null) {
        clearNearMeLocation();
      }

      if (saved.view === 'map') {
        setViewMode('map');
      } else if (saved.view === 'list') {
        setViewMode('list');
      }
    }

    document.getElementById('location-btn')!.addEventListener('click', () => {
      const btn = document.getElementById('location-btn')!;
      const text = document.getElementById('location-text')!;

      if (userLocation) {
        clearNearMeLocation();
        persistDirectoryFilters();
        render();
        return;
      }

      text.textContent = 'Locating...';

      let shareApproximateArea = localStorage.getItem('sdhh_area_analytics_consent') === 'v1';
      if (localStorage.getItem('sdhh_area_analytics_consent') === null) {
        shareApproximateArea = window.confirm(
          'Use your approximate market area to improve nearby results and anonymous audience insights? Exact coordinates are never stored.'
        );
        localStorage.setItem('sdhh_area_analytics_consent', shareApproximateArea ? 'v1' : 'no');
      }

      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          applyNearMeLocation({ lat: pos.coords.latitude, lng: pos.coords.longitude });
          persistDirectoryFilters();
          render();
          if (shareApproximateArea) {
            try {
              await fetch('/api/activity/area', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({
                  latitude: pos.coords.latitude,
                  longitude: pos.coords.longitude,
                  consent: true,
                }),
              });
            } catch {
              // Nearby sorting remains useful even if analytics is unavailable.
            }
          }
        },
        () => {
          text.textContent = 'Near me';
          alert('Could not get your location. Please enable location services.');
        }
      );
    });

    document.getElementById('list-view-btn')!.addEventListener('click', () => {
      setViewMode('list');
      persistDirectoryFilters();
    });

    document.getElementById('map-view-btn')!.addEventListener('click', () => {
      setViewMode('map');
      persistDirectoryFilters();
    });

    function initMap() {
      const center = userLocation || { lat: 32.7157, lng: -117.1611 };
      const cartoKey = import.meta.env.PUBLIC_CARTO_API_KEY?.trim();
      const tileUrl = cartoKey
        ? `https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=${encodeURIComponent(cartoKey)}`
        : 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';
      const attribution = cartoKey
        ? '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, &copy; <a href="https://carto.com/attributions">CARTO</a>'
        : '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>';
      // @ts-ignore - Leaflet loaded via script tag
      map = L.map('map').setView([center.lat, center.lng], 12);
      // @ts-ignore
      L.tileLayer(tileUrl, {
        attribution,
        maxZoom: 19,
      }).addTo(map);
    }

    function renderMapStatus(state: ConsumerPromotionState) {
      const primaryDeal = state.liveDeals[0];
      if (primaryDeal) {
        return `
          <div class="map-status">
            <span class="live-deal-badge live-deal-badge--secondary"><span class="live-deal-status-dot"></span>Live Deal</span>
            <p class="map-live-headline">${escapeHTML(primaryDeal.title)}</p>
            ${state.state === 'both' ? '<p class="map-secondary-status">Happy hour also happening now</p>' : ''}
          </div>
        `;
      }
      if (state.state === 'happy-hour-only') {
        return '<div class="map-status"><span class="happy-hour-now-badge happy-hour-now-badge--secondary">Happy Hour Now</span></div>';
      }
      return '';
    }

    function updateMapMarkers(
      now = getServerNow(),
      venueStates = buildVenueStates(now)
    ) {
      if (!map) return;
      markers.forEach((m) => map.removeLayer(m));
      markers = [];

      const filtered = getFilteredData(now, venueStates);

      filtered.forEach((h) => {
        const state = venueStates.get(h.id) ?? EMPTY_CONSUMER_STATE;
        const hasLiveDeal = state.state === 'live-deal-only' || state.state === 'both';
        const hasHappyHour = state.state === 'happy-hour-only' || state.state === 'both';
        const markerLabel = hasLiveDeal ? 'LD' : hasHappyHour ? 'HH' : '•';
        const statusLabel = state.state === 'both'
          ? 'Live Deal; Happy Hour Now also happening'
          : hasLiveDeal
            ? 'Live Deal'
            : hasHappyHour
              ? 'Happy Hour Now'
              : 'No current offer status';
        // @ts-ignore
        const icon = L.divIcon({
          className: 'custom-marker',
          html: `<div role="img" aria-label="${escapeHTML(h.name)} — ${statusLabel}" style="
            background: ${hasLiveDeal ? '#8B5CF6' : hasHappyHour ? '#16A34A' : '#FF6B35'};
            width: 36px; height: 36px;
            border-radius: 50%;
            border: 3px solid ${state.state === 'both' ? '#22C55E' : 'white'};
            box-shadow: 0 0 0 2px white, 0 2px 8px rgba(0,0,0,0.3);
            display: flex; align-items: center; justify-content: center;
            color: white; font-weight: 800; font-size: ${hasLiveDeal ? '10px' : '12px'};
          ">${markerLabel}</div>`,
          iconSize: [36, 36],
          iconAnchor: [18, 18]
        });

        // @ts-ignore
        const marker = L.marker([h.lat, h.lng], { icon })
          .bindPopup(`
            <div class="map-popup">
              <h3>${escapeHTML(h.name)}</h3>
              <div class="vibe">${escapeHTML(h.vibe)} · ${h.verified ? 'Verified' : 'Needs verification'}</div>
              ${renderMapStatus(state)}
              <div class="time">Regular happy hour: ${escapeHTML(cardTimeLabel(h) || `${formatTime(h.startTime)} – ${formatTime(h.endTime)}`)}</div>
              <div class="deals">${cardSpecials(h).slice(0, 2).map(escapeHTML).join(' • ')}</div>
              <a href="${venuePath(h)}">View details</a>
            </div>
          `)
          .addTo(map);

        markers.push(marker);
      });
    }

    async function loadAccount() {
      try {
        const res = await fetch('/api/account/me');
        const session = await res.json();
        accountUser = session.authenticated ? session.user : null;
      } catch {
        accountUser = null;
      }

      updateAlertTextNote();
      render();
    }

    function updateAlertTextNote() {
      const note = document.getElementById('alert-text-note');
      if (!note) return;
      const ready = Boolean(accountUser?.phone && accountUser?.smsOptedIn);
      note.innerHTML = ready
        ? `(texts go to ${accountUser.phone})`
        : '(set up in <a href="/account/#section-preferences">My Stuff → Preferences</a>)';
    }

    async function loadAccountKeepingVenueInPlace(venueId: number) {
      const selector = `[data-venue-card="${venueId}"]`;
      const beforeTop = document.querySelector(selector)?.getBoundingClientRect().top;
      await loadAccount();
      await new Promise<void>((resolve) => {
        requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
      });
      const afterTop = document.querySelector(selector)?.getBoundingClientRect().top;
      if (beforeTop !== undefined && afterTop !== undefined) {
        const previousScrollBehavior = document.documentElement.style.scrollBehavior;
        document.documentElement.style.scrollBehavior = 'auto';
        window.scrollBy(0, afterTop - beforeTop);
        document.documentElement.style.scrollBehavior = previousScrollBehavior;
      }
    }

    function getSavedVenue(spotId: number) {
      return accountUser?.saved?.venues?.find((item: any) => item.venueId === spotId);
    }

    function setSaveListMenuOpen(combobox: HTMLElement, open: boolean) {
      const trigger = combobox.querySelector('[data-list-menu-trigger]') as HTMLButtonElement | null;
      const menu = combobox.querySelector('[data-list-menu]') as HTMLElement | null;
      if (!trigger || !menu) return;
      menu.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
    }

    function closeSaveListMenus(except?: HTMLElement) {
      document.querySelectorAll('[data-list-menu-combobox]').forEach((element) => {
        const combobox = element as HTMLElement;
        if (combobox !== except) setSaveListMenuOpen(combobox, false);
      });
    }

    async function updateSavedVenueList(
      venueId: number,
      listId: string,
      picker: HTMLButtonElement,
      actionStatus: HTMLElement | null
    ) {
      picker.disabled = true;
      picker.setAttribute('aria-busy', 'true');
      try {
        if (listId === '__create') {
          const title = window.prompt('Name your new list');
          if (!title?.trim()) return;
          if (actionStatus) {
            actionStatus.classList.add('is-loading');
            actionStatus.textContent = `Creating ${title.trim()}…`;
          }
          const response = await fetch('/api/account/lists', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title, description: '', venueId }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error((data.errors || ['Could not create the list.']).join(' '));
          saveConfirmation = { spotId: venueId, text: `Added to ${data.list.title}` };
        } else {
          const saved = getSavedVenue(venueId);
          const included = saved?.lists?.some((membership: any) => membership.listId === listId);
          const selectedList = accountUser.saved?.lists?.find((list: any) => list.id === listId);
          const oppositeKey = selectedList?.systemKey === 'want_to_try'
            ? 'been_to'
            : selectedList?.systemKey === 'been_to'
              ? 'want_to_try'
              : null;
          const transitionedFrom = oppositeKey
            ? saved?.lists?.find((membership: any) => membership.systemKey === oppositeKey)
            : null;
          if (actionStatus) {
            actionStatus.classList.add('is-loading');
            actionStatus.textContent = included
              ? `Removing from ${selectedList?.title || 'list'}…`
              : `Adding to ${selectedList?.title || 'list'}…`;
          }
          const response = await fetch(`/api/lists/${encodeURIComponent(listId)}/items/${venueId}`, {
            method: included ? 'DELETE' : 'PUT',
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error((data.errors || ['Could not update the list.']).join(' '));
          saveConfirmation = {
            spotId: venueId,
            text: included
              ? `Removed from ${selectedList?.title || 'list'}`
              : transitionedFrom
                ? `Moved from ${transitionedFrom.title} to ${selectedList?.title}`
                : `Added to ${selectedList?.title || 'list'}`,
          };
        }
        await loadAccountKeepingVenueInPlace(venueId);
      } catch (error: any) {
        saveConfirmation = { spotId: venueId, text: error.message };
        render();
      } finally {
        if (picker.isConnected) {
          picker.disabled = false;
          picker.removeAttribute('aria-busy');
        }
      }
    }

    function populateSelect(id: string, values: string[], formatter: (v: string) => string = (v) => v) {
      const select = document.getElementById(id) as HTMLSelectElement;
      values.forEach((n) => {
        const opt = document.createElement('option');
        opt.value = n;
        opt.textContent = formatter(n);
        select.appendChild(opt);
      });
    }

    /** Lays each verified owner's own edits over the build-time record, and
     * drops venues that shouldn't be public.
     *
     * happy-hours.json is a static asset baked at deploy time; an owner
     * correcting their hours writes to venue_overrides instead and it takes
     * effect immediately (see src/lib/venueContent.ts). Without this merge the
     * cards here would disagree with the venue page, which does apply them.
     *
     * A plain spread is the whole merge: a stored patch only ever holds
     * complete values for owner-editable fields, and the endpoint filters it
     * to those fields on the way out.
     *
     * The visibility filter has to run *here*, after the response arrives,
     * rather than on the raw file: a venue the pipeline left unlisted becomes
     * public the moment it is cleared — domain or phone self-verify, or an
     * admin approving a manual claim — and that only shows up in this
     * endpoint's publishedVenueIds until the next deploy.
     */
    async function mergeOwnerEdits(venues: any[], failureFallback = venues) {
      try {
        const res = await fetch('/api/venue-overrides', { cache: 'no-store' });
        if (!res.ok) return failureFallback;
        const { overrides, publishedVenueIds } = await res.json();
        const published = new Set<number>(publishedVenueIds || []);
        return venues
          .filter((venue) => isPubliclyListed(venue, published))
          .map((venue) => {
            const patch = overrides?.[String(venue.id)];
            return patch ? { ...venue, ...patch } : venue;
          });
      } catch {
        // Keep the last successfully loaded record if reconciliation fails.
        return failureFallback;
      }
    }

    async function loadData() {
      const res = await fetch('/data/happy-hours.json');
      baseHappyHours = await res.json();
      happyHours = await mergeOwnerEdits(
        baseHappyHours,
        // If the live layer is unreachable, fall back to the static verdict
        // rather than showing everything.
        baseHappyHours.filter((venue) => isPubliclyListed(venue)),
      );
      venueDirectoryLoaded = true;

      populateSelect('neighborhood-filter', [...new Set(happyHours.map((h) => h.neighborhood))].sort());
      populateSelect('deal-filter', [...new Set(happyHours.flatMap((h) => h.dealTypes || []))].sort(), labelize);

      if (!directoryFiltersRestored) {
        restoreDirectoryFilters();
        directoryFiltersRestored = true;
      }

      await loadAccount();
      render();
    }

    /**
     * The homepage can survive an admin visit in the back/forward cache, and
     * it can stay open in another tab while an image is saved. Reconcile the
     * no-store override endpoint whenever the page becomes active again.
     * Keeping the static dataset separate also means removed overrides really
     * disappear instead of being merged over an already-merged stale record.
     */
    async function refreshVenueDirectory() {
      if (!venueDirectoryLoaded || !baseHappyHours.length) return;
      if (venueDirectoryRefreshPromise) return venueDirectoryRefreshPromise;

      venueDirectoryRefreshPromise = (async () => {
        const refreshed = await mergeOwnerEdits(baseHappyHours, happyHours);
        if (JSON.stringify(refreshed) === JSON.stringify(happyHours)) return;
        happyHours = refreshed;
        render();
      })();

      try {
        await venueDirectoryRefreshPromise;
      } finally {
        venueDirectoryRefreshPromise = null;
      }
    }

    function buildVenueStates(now: Date | null) {
      const states = new Map<number, ConsumerPromotionState>();
      for (const venue of happyHours) {
        states.set(
          venue.id,
          now && feedSnapshot.data
            ? deriveConsumerPromotionState({
                venueId: venue.id,
                schedule: venue,
                promotions: feedSnapshot.data.promotions,
                now,
              })
            : EMPTY_CONSUMER_STATE
        );
      }
      return states;
    }

    function promotionSignature() {
      return JSON.stringify(feedSnapshot.data?.promotions ?? []);
    }

    function venueStateSignature(states: Map<number, ConsumerPromotionState>) {
      return JSON.stringify([...states.entries()].map(([venueId, state]) => [
        venueId,
        state.state,
        state.happyHourOccurrence?.startsAt.toISOString() ?? null,
        state.liveDeals.map((promotion) => promotion.id),
      ]));
    }

    function directoryVenue(venueId: number) {
      return happyHours.find((venue) => venue.id === venueId);
    }

    function formatTime(time: string) {
      const [h, m] = time.split(':').map(Number);
      const ampm = h >= 12 ? 'PM' : 'AM';
      const hour = h % 12 || 12;
      return `${hour}:${m.toString().padStart(2, '0')} ${ampm}`;
    }

    /**
     * Keep three independently useful sources for every venue card:
     * the card-sized CDN URL, the original admin upload in case only that
     * transform failed, and the venue's stock image if the upload also fails.
     */
    function getCardImageSources(venue: any) {
      return {
        primary: getListingImage(venue, 'card'),
        original: typeof venue.image === 'string' ? venue.image : '',
        stock: getListingImage({ vibe: venue.vibe }, 'card'),
        // The admin's framing for this card's fixed 200px-tall frame. Empty
        // for a venue nobody has framed, and for the stock fallback, so those
        // cards render exactly as they always have.
        framing: listingImageStyle(venue, 'card'),
      };
    }

    function getTrustLabel(h: any) {
      if (h.verified && h.lastVerifiedAt) {
        return `Verified ${new Date(h.lastVerifiedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}`;
      }
      if (h.verified) return 'Verified';
      return 'Needs verification';
    }

    function matchesSearch(h: any, query: string) {
      if (!query) return true;
      const haystack = venueSearchText(h).join(' ').toLowerCase();
      return haystack.includes(query);
    }

    function stateSortRank(state: ConsumerPromotionState) {
      if (state.state === 'live-deal-only' || state.state === 'both') return 0;
      if (state.state === 'happy-hour-only') return 1;
      return 2;
    }

    /** Which facet to leave out of a pass over the data, so the excluded-count
     * note can say what that one facet is costing the visitor. */
    type IgnoredFacet = '' | 'day' | 'dealType';

    function getFilteredData(
      now = getServerNow(),
      venueStates = buildVenueStates(now),
      ignore: IgnoredFacet = ''
    ) {
      const searchQuery = (document.getElementById('search-input') as HTMLInputElement).value.trim().toLowerCase();
      const dayFilter = ignore === 'day' ? '' : (document.getElementById('day-filter') as HTMLSelectElement).value;
      const neighborhoodFilter = (document.getElementById('neighborhood-filter') as HTMLSelectElement).value;
      const dealFilter = ignore === 'dealType' ? '' : (document.getElementById('deal-filter') as HTMLSelectElement).value;
      const statusFilter = (document.getElementById('status-filter') as HTMLSelectElement).value;
      const trustFilter = (document.getElementById('trust-filter') as HTMLSelectElement).value;

      let filtered = [...happyHours];

      if (searchQuery) filtered = filtered.filter((h) => matchesSearch(h, searchQuery));
      if (dayFilter) filtered = filtered.filter((h) => h.days.includes(dayFilter));
      if (neighborhoodFilter) filtered = filtered.filter((h) => h.neighborhood === neighborhoodFilter);
      // A venue with no deal types is one whose offers nobody published, which
      // is what this option selects. It is not a deal type, so it can never be
      // matched by one.
      if (dealFilter === OFFERS_UNKNOWN_FILTER) {
        filtered = filtered.filter((h) => !(h.dealTypes || []).length);
      } else if (dealFilter) {
        filtered = filtered.filter((h) => (h.dealTypes || []).includes(dealFilter));
      }
      if (statusFilter === 'happy-hour-now') {
        filtered = filtered.filter((h) => Boolean(venueStates.get(h.id)?.happyHourOccurrence));
      }
      if (trustFilter === 'verified') filtered = filtered.filter((h) => h.verified);
      if (trustFilter === 'unverified') filtered = filtered.filter((h) => !h.verified);

      if (userLocation) {
        filtered = filtered.map((h) => ({
          ...h,
          distance: getDistance(userLocation!.lat, userLocation!.lng, h.lat, h.lng)
        }));
      }

      filtered.sort((left, right) => {
        const stateDifference =
          stateSortRank(venueStates.get(left.id) ?? EMPTY_CONSUMER_STATE) -
          stateSortRank(venueStates.get(right.id) ?? EMPTY_CONSUMER_STATE);
        if (stateDifference !== 0) return stateDifference;
        if (userLocation && left.distance !== right.distance) return left.distance - right.distance;
        return left.startTime.localeCompare(right.startTime);
      });

      return filtered;
    }

    /**
     * Says out loud what the current filters are leaving out, for the two
     * facets that exclude venues over something other than what the visitor
     * asked about.
     *
     * A deal-type selection drops every venue whose offers nobody published —
     * 140 of them — because they carry no deal types at all, and inventing one
     * to keep them in the result would put a venue in a "beer" browse on a
     * guess. And the day filter starts on today's weekday, which the page
     * chose rather than the visitor, so its exclusions are ours to explain.
     *
     * Both notes offer the widening as a button: a count nobody can act on is
     * trivia.
     */
    function paintExcludedNote(
      now: Date | null,
      venueStates: Map<number, ConsumerPromotionState>,
      shownCount: number
    ) {
      const note = document.getElementById('excluded-note')!;
      const dealFilter = (document.getElementById('deal-filter') as HTMLSelectElement).value;
      const dayFilter = dayFilterEl.value;
      const parts: string[] = [];

      if (dealFilter && dealFilter !== OFFERS_UNKNOWN_FILTER) {
        const unknownOffers = getFilteredData(now, venueStates, 'dealType')
          .filter((venue) => !(venue.dealTypes || []).length).length;
        if (unknownOffers) {
          parts.push(
            `${unknownOffers} more publish happy hour times but not what is on offer — `
            + `<button type="button" data-excluded-show="deal">show those instead</button>`
          );
        }
      }

      // Only when the page set the day itself. A visitor who picked Tuesday
      // knows Tuesday is excluding Wednesday.
      if (dayFilter && !dayFilterTouched && dayFilter === automaticDayFilter) {
        const anyDay = getFilteredData(now, venueStates, 'day').length;
        const closedToday = anyDay - shownCount;
        if (closedToday > 0) {
          parts.push(
            `${closedToday} are hidden because they have no happy hour on ${dayFilter} — `
            + `<button type="button" data-excluded-show="day">show every day</button>`
          );
        }
      }

      note.innerHTML = parts.join(' · ');
      note.hidden = parts.length === 0;
    }

    function render(now = getServerNow()) {
      const todayIndex = now ? syncServerTimePresentation(now) : -1;
      const venueStates = buildVenueStates(now);
      const filtered = getFilteredData(now, venueStates);

      const grid = document.getElementById('grid')!;
      const empty = document.getElementById('empty-state')!;
      const countEl = document.getElementById('result-count')!;
      const liveCountBig = document.getElementById('live-count-big')!;

      const happyHoursNow = [...venueStates.values()]
        .filter((state) => state.happyHourOccurrence !== null)
        .length;
      countEl.textContent = String(filtered.length);
      liveCountBig.textContent = String(happyHoursNow);
      paintExcludedNote(now, venueStates, filtered.length);

      if (filtered.length === 0) {
        (grid as HTMLElement).style.display = 'none';
        grid.innerHTML = '';
        (empty as HTMLElement).style.display = 'block';
      } else {
        (grid as HTMLElement).style.display = '';
        (empty as HTMLElement).style.display = 'none';

        grid.innerHTML = filtered.map((h) => {
          const state = venueStates.get(h.id) ?? EMPTY_CONSUMER_STATE;
          const primaryDeal = state.liveDeals[0];
          const hasLiveDeal = Boolean(primaryDeal);
          const hasHappyHour = state.happyHourOccurrence !== null;
          const imageSources = getCardImageSources(h);
          const hasDistance = h.distance !== undefined;
          const slug = venueSlug(h);
          const statusBadge = hasLiveDeal
            ? '<div class="card-status-badge"><span class="live-deal-badge"><span class="live-deal-status-dot"></span>Live Deal</span></div>'
            : hasHappyHour
              ? '<div class="card-status-badge"><span class="happy-hour-now-badge">Happy Hour Now</span></div>'
              : '';
          const stateClass = hasLiveDeal ? 'has-live-deal' : hasHappyHour ? 'is-happy-hour' : '';

          const weekDots = dayNames.map((day, i) => {
            const active = h.days.includes(day);
            const isToday = i === todayIndex;
            let cls = 'week-dot';
            if (active) cls += ' active';
            if (isToday) cls += ' today';
            return `<span class="${cls}">${dayAbbrev[i]}</span>`;
          }).join('');

          const trustClass = h.verified ? '' : ' unverified';

          const weekday = todayIndex >= 0 ? dayNames[todayIndex] : undefined;
          const specialChips = cardSpecials(h, weekday);
          const timeLabel = cardTimeLabel(h, weekday) || `${formatTime(h.startTime)} – ${formatTime(h.endTime)}`;

          return `
            <article class="card ${stateClass}" data-venue-card="${h.id}">
              <a href="/venues/${slug}/" style="text-decoration: none; color: inherit;">
                <div class="card-image">
                  <img
                    src="${escapeHTML(imageSources.primary)}"
                    alt="${escapeHTML(h.name)}"
                    width="800"
                    height="534"
                    loading="lazy"
                    decoding="async"
                    data-listing-image
                    data-original-src="${escapeHTML(imageSources.original)}"
                    data-stock-src="${escapeHTML(imageSources.stock)}"
                    style="${escapeHTML(imageSources.framing)}"
                  >
                  <div class="overlay"></div>
                  ${statusBadge}
                  ${hasDistance
                    ? `<span class="distance-tag">${formatDistance(h.distance)}</span>`
                    : `<span class="neighborhood-tag">${escapeHTML(h.neighborhood)}</span>`
                  }
                  <div class="time-overlay">
                    <span class="venue-name">${escapeHTML(h.name)}</span>
                    <span class="time-badge">${escapeHTML(timeLabel)}</span>
                  </div>
                </div>
              </a>

              <div class="card-body">
                <div class="card-meta">
                  <span class="card-vibe">${escapeHTML(h.vibe)}</span>
                  <span class="trust-badge${trustClass}">${getTrustLabel(h)}</span>
                  ${h.phone ? `<a class="card-phone" href="tel:${h.phone.replace(/[^0-9+]/g, '')}">${escapeHTML(h.phone)}</a>` : ''}
                  ${hasDistance ? `<span class="card-distance">${escapeHTML(h.neighborhood)}</span>` : ''}
                </div>

                ${primaryDeal ? `
                  <div class="card-live-summary">
                    <strong>${escapeHTML(primaryDeal.title)}</strong>
                    ${state.state === 'both' ? '<span>Happy hour also happening now</span>' : ''}
                  </div>
                ` : ''}

                <div class="trust-row">
                  <span>${h.verified ? 'Venue details checked' : 'Community-sourced listing'}</span>
                  <a href="/submit/">Report update</a>
                </div>

                ${renderSavePanel(h)}

                <div class="week-row">${weekDots}</div>

                <div class="card-deals">
                  <h3>Deals</h3>
                  <div class="deal-grid">
                    ${specialChips.map((d: string) => `<span class="deal">${escapeHTML(d)}</span>`).join('')}
                  </div>
                </div>

                <div class="card-footer">
                  <a class="card-address" data-directions-venue="${h.id}" href="https://maps.google.com/?q=${encodeURIComponent(h.address + ', San Diego, CA')}" target="_blank" rel="noopener">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    <span>${escapeHTML(h.address)}</span>
                  </a>
                  <a class="card-cta" href="/venues/${slug}/">
                    Details
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          `;
        }).join('');
      }

      lastRenderedHadFeedData = feedSnapshot.data !== null;
      lastRenderedPromotionSignature = promotionSignature();
      lastRenderedVenueStateSignature = venueStateSignature(venueStates);
      if (now) scheduleRecurringBoundaryRefresh(now);

      if (document.getElementById('map-container')!.classList.contains('active')) {
        updateMapMarkers(now, venueStates);
      }
    }

    function renderSavePanel(h: any) {
      if (!accountUser) {
        return `
          <div class="save-panel compact">
            <span>Save notes and lists</span>
            <button class="save-action" data-save-login>Log in</button>
          </div>
        `;
      }

      const saved = getSavedVenue(h.id);
      const lists = accountUser.saved?.lists || [];
      const defaultList = lists.find((list: any) => list.id === accountUser.saved?.defaultListId);
      const editableLists = lists.filter((list: any) => list.canEdit);
      const pendingListId = pendingSaveListSelections.get(h.id);
      const selectedListId = pendingListId === '__create' || editableLists.some((list: any) => list.id === pendingListId)
        ? pendingListId
        : editableLists.some((list: any) => list.id === defaultList?.id)
          ? defaultList.id
          : editableLists[0]?.id;
      const pickerLabel = (list: any) => {
        const oppositeKey = list.systemKey === 'want_to_try'
          ? 'been_to'
          : list.systemKey === 'been_to'
            ? 'want_to_try'
            : null;
        const replaced = oppositeKey
          ? saved?.lists?.find((membership: any) => membership.systemKey === oppositeKey)
          : null;
        return `${list.title}${replaced ? ` · moves from ${replaced.title}` : ''}`;
      };
      if (!saved) {
        const selectedListLabel = selectedListId === '__create'
          ? 'Create a new list…'
          : pickerLabel(editableLists.find((list: any) => list.id === selectedListId) || { title: 'Choose a list…' });
        return `
          <div class="save-panel">
            <div class="save-panel-row">
              <div class="save-list-combobox" data-list-menu-combobox data-save-list-combobox="${h.id}">
                <button
                  class="save-list-trigger"
                  type="button"
                  data-save-list-trigger="${h.id}"
                  data-list-menu-trigger
                  data-save-list-value="${escapeHTML(selectedListId || '__create')}"
                  aria-label="Choose a list for ${escapeHTML(h.name)}"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls="save-list-options-${h.id}"
                >
                  <span class="save-list-trigger-label" data-save-list-label>${escapeHTML(selectedListLabel)}</span>
                  <svg aria-hidden="true" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="save-list-options" id="save-list-options-${h.id}" role="listbox" aria-label="Lists for ${escapeHTML(h.name)}" data-list-menu data-save-list-menu hidden>
                  ${editableLists.map((list: any) => {
                    const label = pickerLabel(list);
                    const isSelected = list.id === selectedListId;
                    return `<button class="save-list-option${isSelected ? ' active' : ''}" type="button" role="option" aria-selected="${isSelected}" data-list-menu-option data-save-list-option="${escapeHTML(list.id)}" data-save-list-option-label="${escapeHTML(label)}"><span class="save-list-option-check" aria-hidden="true">✓</span><span>${escapeHTML(label)}</span></button>`;
                  }).join('')}
                  <button class="save-list-option create${selectedListId === '__create' ? ' active' : ''}" type="button" role="option" aria-selected="${selectedListId === '__create'}" data-list-menu-option data-save-list-option="__create" data-save-list-option-label="Create a new list…"><span class="save-list-option-check" aria-hidden="true">✓</span><span>+ Create a new list…</span></button>
                </div>
              </div>
              <button class="save-action" data-save-spot="${h.id}">Save</button>
            </div>
            <span class="save-confirm" data-list-action-status aria-live="polite"></span>
          </div>
        `;
      }

      const confirmation = saveConfirmation && saveConfirmation.spotId === h.id
        ? `&#10003; ${escapeHTML(saveConfirmation.text)}`
        : '';

      return `
        <div class="save-panel" data-saved-spot="${h.id}">
          <div class="save-list-chips">
            ${saved.lists.map((list: any) => `<span class="save-list-chip">${escapeHTML(list.title)}${list.role === 'viewer' ? ' · view only' : ''}</span>`).join('')}
          </div>
          <div class="save-list-combobox" data-list-menu-combobox data-manage-list-combobox="${h.id}">
            <button
              class="save-list-trigger"
              type="button"
              data-list-menu-trigger
              data-manage-list-trigger="${h.id}"
              aria-label="Manage lists for ${escapeHTML(h.name)}"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="manage-list-options-${h.id}"
            >
              <span class="save-list-trigger-label">Add or remove a list…</span>
              <svg aria-hidden="true" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="save-list-options" id="manage-list-options-${h.id}" role="listbox" aria-label="Manage lists for ${escapeHTML(h.name)}" aria-multiselectable="true" data-list-menu data-manage-list-menu hidden>
              ${lists.map((list: any) => {
                const membership = saved.lists.find((entry: any) => entry.listId === list.id);
                const label = `${pickerLabel(list)}${!list.canEdit ? ' · view only' : ''}`;
                return `<button class="save-list-option${membership ? ' active' : ''}" type="button" role="option" aria-selected="${Boolean(membership)}" ${!list.canEdit ? 'disabled' : ''} data-list-menu-option data-manage-list-option="${escapeHTML(list.id)}"><span class="save-list-option-check" aria-hidden="true">✓</span><span>${escapeHTML(label)}</span></button>`;
              }).join('')}
              <button class="save-list-option create" type="button" role="option" aria-selected="false" data-list-menu-option data-manage-list-option="__create"><span class="save-list-option-check" aria-hidden="true">✓</span><span>+ Create a new list…</span></button>
            </div>
          </div>
          <div class="save-actions">
            <a class="save-action secondary" href="/account/#section-spots" style="text-decoration:none;">Ratings, comments &amp; details</a>
            <span class="save-confirm" data-list-action-status aria-live="polite">${confirmation}</span>
          </div>
        </div>
      `;
    }

    /**
     * Image errors do not bubble, so use capture listeners on the permanent
     * grids. A failed Netlify transform first retries the original upload;
     * if that also fails, the venue-specific stock image takes over. Sources
     * are removed before retrying so a damaged stock asset cannot loop.
     */
    function restoreListingImage(event: Event) {
      const image = event.target;
      if (!(image instanceof HTMLImageElement) || !image.hasAttribute('data-listing-image')) return;

      const current = image.getAttribute('src') || '';
      const original = image.dataset.originalSrc || '';
      delete image.dataset.originalSrc;
      if (original && original !== current) {
        image.src = original;
        return;
      }

      const stock = image.dataset.stockSrc || '';
      delete image.dataset.stockSrc;
      if (stock && stock !== current) {
        image.src = stock;
        // The admin framed the venue's own photo, not the stock one every
        // venue with this vibe shares.
        image.removeAttribute('style');
      }
    }

    document.getElementById('grid')!.addEventListener('error', restoreListingImage, true);

    document.getElementById('search-input')!.addEventListener('input', () => {
      render();
      schedulePersistDirectoryFilters();
    });
    document.getElementById('day-filter')!.addEventListener('change', () => {
      dayFilterInitialized = true;
      dayFilterTouched = true;
      render();
      persistDirectoryFilters();
    });
    document.getElementById('neighborhood-filter')!.addEventListener('change', () => {
      render();
      persistDirectoryFilters();
    });
    document.getElementById('deal-filter')!.addEventListener('change', () => {
      render();
      persistDirectoryFilters();
    });
    document.getElementById('status-filter')!.addEventListener('change', () => {
      render();
      persistDirectoryFilters();
    });
    // The excluded-count note's own widenings, which move the filter the note
    // is describing rather than adding a second way to browse.
    document.getElementById('excluded-note')!.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest('[data-excluded-show]') as HTMLElement | null;
      if (!target) return;
      if (target.dataset.excludedShow === 'deal') {
        (document.getElementById('deal-filter') as HTMLSelectElement).value = OFFERS_UNKNOWN_FILTER;
      } else {
        dayFilterEl.value = '';
        dayFilterInitialized = true;
        dayFilterTouched = true;
      }
      render();
      persistDirectoryFilters();
    });
    document.getElementById('trust-filter')!.addEventListener('change', () => {
      render();
      persistDirectoryFilters();
    });

    // "Save as Alert" — captures whatever's currently in the filter bar
    // (day/neighborhood/deal/search) as a named, saved alert. Full
    // editing (multi-day, toggling, deleting, sharing) happens in My Stuff (/account/);
    // this is just the quick-capture entry point.
    const saveAlertPanel = document.getElementById('save-alert-panel')!;
    const saveAlertStatus = document.getElementById('alert-save-status')!;

    document.getElementById('save-alert-btn')!.addEventListener('click', () => {
      if (!accountUser) {
        window.location.href = '/account/';
        return;
      }
      saveAlertPanel.classList.toggle('hidden');
      if (!saveAlertPanel.classList.contains('hidden')) {
        (document.getElementById('alert-name-input') as HTMLInputElement).focus();
      }
    });

    document.getElementById('alert-save-cancel')!.addEventListener('click', () => {
      saveAlertPanel.classList.add('hidden');
      saveAlertStatus.textContent = '';
      saveAlertStatus.classList.remove('error');
    });

    document.getElementById('alert-save-confirm')!.addEventListener('click', async () => {
      const nameInput = document.getElementById('alert-name-input') as HTMLInputElement;
      const name = nameInput.value.trim();
      if (!name) {
        saveAlertStatus.classList.add('error');
        saveAlertStatus.textContent = 'Give this alert a name.';
        return;
      }

      const dayValue = (document.getElementById('day-filter') as HTMLSelectElement).value;
      const filters = {
        days: dayValue ? [dayValue] : [],
        neighborhood: (document.getElementById('neighborhood-filter') as HTMLSelectElement).value,
        dealType: (document.getElementById('deal-filter') as HTMLSelectElement).value,
        query: (document.getElementById('search-input') as HTMLInputElement).value.trim(),
      };
      const channels = {
        email: (document.getElementById('alert-channel-email') as HTMLInputElement).checked,
        text: (document.getElementById('alert-channel-text') as HTMLInputElement).checked,
      };
      if (channels.text && !(accountUser?.phone && accountUser?.smsOptedIn)) {
        saveAlertStatus.classList.add('error');
        saveAlertStatus.textContent = 'Set up text alerts in My Stuff → Preferences first.';
        return;
      }

      saveAlertStatus.classList.remove('error');
      saveAlertStatus.textContent = 'Saving...';
      try {
        const res = await fetch('/api/account/alerts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, filters, channels }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error((json.errors || ['Could not save alert.']).join(' '));
        saveAlertStatus.textContent = 'Saved — manage it in My Stuff.';
        nameInput.value = '';
        setTimeout(() => {
          saveAlertPanel.classList.add('hidden');
          saveAlertStatus.textContent = '';
        }, 1800);
      } catch (err: any) {
        saveAlertStatus.classList.add('error');
        saveAlertStatus.textContent = err.message;
      }
    });

    document.getElementById('grid')!.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;

      const directionsLink = target.closest('[data-directions-venue]') as HTMLAnchorElement | null;
      if (directionsLink) {
        void fetch('/api/analytics/events', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ event: 'directions_opened', venueId: Number(directionsLink.dataset.directionsVenue) }),
          keepalive: true,
        });
        return;
      }

      if (target.closest('[data-save-login]')) {
        window.location.href = '/account/';
        return;
      }

      const manageListOption = target.closest('[data-manage-list-option]') as HTMLButtonElement | null;
      if (manageListOption) {
        event.preventDefault();
        if (manageListOption.disabled) return;
        const combobox = manageListOption.closest('[data-manage-list-combobox]') as HTMLElement | null;
        const picker = combobox?.querySelector('[data-manage-list-trigger]') as HTMLButtonElement | null;
        const venueId = Number(combobox?.dataset.manageListCombobox);
        const listId = manageListOption.dataset.manageListOption;
        const actionStatus = combobox?.closest('.save-panel')?.querySelector('[data-list-action-status]') as HTMLElement | null;
        if (!combobox || !picker || !venueId || !listId) return;
        setSaveListMenuOpen(combobox, false);
        await updateSavedVenueList(venueId, listId, picker, actionStatus);
        return;
      }

      const manageListTrigger = target.closest('[data-manage-list-trigger]') as HTMLButtonElement | null;
      if (manageListTrigger) {
        event.preventDefault();
        const combobox = manageListTrigger.closest('[data-manage-list-combobox]') as HTMLElement | null;
        if (!combobox) return;
        const willOpen = manageListTrigger.getAttribute('aria-expanded') !== 'true';
        closeSaveListMenus(combobox);
        setSaveListMenuOpen(combobox, willOpen);
        return;
      }

      const saveListOption = target.closest('[data-save-list-option]') as HTMLButtonElement | null;
      if (saveListOption) {
        event.preventDefault();
        const combobox = saveListOption.closest('[data-save-list-combobox]') as HTMLElement | null;
        const trigger = combobox?.querySelector('[data-save-list-trigger]') as HTMLButtonElement | null;
        const label = trigger?.querySelector('[data-save-list-label]') as HTMLElement | null;
        const value = saveListOption.dataset.saveListOption;
        const venueId = Number(combobox?.dataset.saveListCombobox);
        if (!combobox || !trigger || !label || !value || !venueId) return;
        pendingSaveListSelections.set(venueId, value);
        trigger.dataset.saveListValue = value;
        label.textContent = saveListOption.dataset.saveListOptionLabel || saveListOption.textContent?.trim() || '';
        combobox.querySelectorAll('[data-save-list-option]').forEach((option) => {
          const selected = option === saveListOption;
          option.classList.toggle('active', selected);
          option.setAttribute('aria-selected', String(selected));
        });
        setSaveListMenuOpen(combobox, false);
        trigger.focus();
        return;
      }

      const saveListTrigger = target.closest('[data-save-list-trigger]') as HTMLButtonElement | null;
      if (saveListTrigger) {
        event.preventDefault();
        const combobox = saveListTrigger.closest('[data-save-list-combobox]') as HTMLElement | null;
        if (!combobox) return;
        const willOpen = saveListTrigger.getAttribute('aria-expanded') !== 'true';
        closeSaveListMenus(combobox);
        setSaveListMenuOpen(combobox, willOpen);
        return;
      }

      const saveButton = target.closest('[data-save-spot]') as HTMLElement | null;
      const spotId = saveButton?.dataset.saveSpot;
      if (!spotId) return;

      event.preventDefault();
      const venueId = Number(spotId);
      const savePanel = saveButton.closest('.save-panel');
      const picker = savePanel?.querySelector('[data-save-list-trigger]') as HTMLButtonElement | null;
      const actionStatus = savePanel?.querySelector('[data-list-action-status]') as HTMLElement | null;
      const listId = picker?.dataset.saveListValue;
      if (!picker || !listId) return;

      saveButton.setAttribute('aria-busy', 'true');
      saveButton.textContent = 'Saving…';
      saveButton.setAttribute('disabled', '');
      picker.disabled = true;

      try {
        if (listId === '__create') {
          const title = window.prompt('Name your new list');
          if (!title?.trim()) return;
          if (actionStatus) {
            actionStatus.classList.add('is-loading');
            actionStatus.textContent = `Creating ${title.trim()}…`;
          }
          const response = await fetch('/api/account/lists', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title, description: '', venueId }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error((data.errors || ['Could not create the list.']).join(' '));
          saveConfirmation = { spotId: venueId, text: `Added to ${data.list.title}` };
        } else {
          const selectedList = accountUser.saved?.lists?.find((list: any) => list.id === listId);
          if (actionStatus) {
            actionStatus.classList.add('is-loading');
            actionStatus.textContent = `Adding to ${selectedList?.title || 'list'}…`;
          }
          const response = await fetch(`/api/lists/${encodeURIComponent(listId)}/items/${venueId}`, {
            method: 'PUT',
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error((data.errors || ['Could not save.']).join(' '));
          saveConfirmation = { spotId: venueId, text: `Added to ${selectedList?.title || 'list'}` };
        }
        pendingSaveListSelections.delete(venueId);
        await loadAccountKeepingVenueInPlace(venueId);
      } catch (error: any) {
        if (actionStatus) {
          actionStatus.classList.remove('is-loading');
          actionStatus.textContent = error.message;
        }
      } finally {
        if (saveButton.isConnected) {
          saveButton.removeAttribute('aria-busy');
          saveButton.removeAttribute('disabled');
          saveButton.textContent = 'Save';
        }
        if (picker.isConnected) picker.disabled = false;
      }

      if (saveConfirmation) {
        const confirmedId = saveConfirmation.spotId;
        setTimeout(() => {
          if (saveConfirmation && saveConfirmation.spotId === confirmedId) {
            saveConfirmation = null;
            render();
          }
        }, 2000);
      }
    });

    document.getElementById('grid')!.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      const trigger = target.closest('[data-list-menu-trigger]') as HTMLButtonElement | null;
      if (trigger && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
        event.preventDefault();
        const combobox = trigger.closest('[data-list-menu-combobox]') as HTMLElement | null;
        if (!combobox) return;
        closeSaveListMenus(combobox);
        setSaveListMenuOpen(combobox, true);
        const options = Array.from(combobox.querySelectorAll('[data-list-menu-option]:not(:disabled)')) as HTMLButtonElement[];
        const selectedIndex = options.findIndex((option) => option.getAttribute('aria-selected') === 'true');
        const nextIndex = event.key === 'ArrowUp'
          ? (selectedIndex > 0 ? selectedIndex - 1 : options.length - 1)
          : (selectedIndex >= 0 && selectedIndex < options.length - 1 ? selectedIndex + 1 : 0);
        options[nextIndex]?.focus();
        return;
      }

      const option = target.closest('[data-list-menu-option]') as HTMLButtonElement | null;
      if (!option) return;
      const combobox = option.closest('[data-list-menu-combobox]') as HTMLElement | null;
      if (!combobox) return;
      const options = Array.from(combobox.querySelectorAll('[data-list-menu-option]:not(:disabled)')) as HTMLButtonElement[];
      const currentIndex = options.indexOf(option);
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const offset = event.key === 'ArrowDown' ? 1 : -1;
        options[(currentIndex + offset + options.length) % options.length]?.focus();
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        options[event.key === 'Home' ? 0 : options.length - 1]?.focus();
      } else if (event.key === 'Escape') {
        event.preventDefault();
        setSaveListMenuOpen(combobox, false);
        (combobox.querySelector('[data-list-menu-trigger]') as HTMLButtonElement | null)?.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!(event.target as HTMLElement).closest('[data-list-menu-combobox]')) closeSaveListMenus();
    });

    const unsubscribeFromLivePromotions = livePromotionFeed.subscribe((snapshot) => {
      feedSnapshot = snapshot;
      const now = getServerNow();
      const venueStates = buildVenueStates(now);
      const nextPromotionSignature = promotionSignature();
      const promotionsChanged = nextPromotionSignature !== lastRenderedPromotionSignature;
      const presentationChanged =
        (snapshot.data !== null) !== lastRenderedHadFeedData ||
        promotionsChanged ||
        venueStateSignature(venueStates) !== lastRenderedVenueStateSignature;

      if (presentationChanged) {
        render(now);
      } else if (now) {
        refreshTimedPresentation(now);
        scheduleRecurringBoundaryRefresh(now);
      }

      // A promotion response includes its current merged venue image. If that
      // snapshot changed while this page stayed open, reconcile the directory
      // endpoint so the homepage card stays current too.
      if (promotionsChanged) void refreshVenueDirectory();
    });

    window.addEventListener('sdhh:auth-changed', () => {
      void livePromotionFeed.authenticationChanged();
      void loadAccount();
    });

    window.addEventListener('focus', () => {
      void refreshVenueDirectory();
    });

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void refreshVenueDirectory();
    });

    window.addEventListener('pageshow', (event) => {
      if (!(event as PageTransitionEvent).persisted) return;
      // A different page may have signed the visitor out while this DOM was
      // in the back/forward cache. pagehide already redacted synchronously;
      // restarting the feed reconciles the canonical session-scoped payload.
      livePromotionFeed.start();
      void loadAccount();
      void refreshVenueDirectory();
    });

    const timedPresentationInterval = window.setInterval(() => {
      const now = getServerNow();
      if (now) refreshTimedPresentation(now);
    }, 30_000);

    window.addEventListener('pagehide', (event) => {
      persistDirectoryFilters();
      livePromotionFeed.stop();
      // A cached document must not retain session-only codes. This call
      // redacts synchronously before its promise waits for an aborted request.
      void livePromotionFeed.authenticationChanged();
      if ((event as PageTransitionEvent).persisted) return;
      window.clearInterval(timedPresentationInterval);
      if (recurringBoundaryTimer !== null) window.clearTimeout(recurringBoundaryTimer);
      unsubscribeFromLivePromotions();
    });

    livePromotionFeed.start();
    loadData();
  </script>
</Layout>
