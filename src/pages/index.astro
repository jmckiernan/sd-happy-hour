        <button class="location-btn" id="location-btn" type="button" aria-pressed="false">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
          <span id="location-text">Near me</span>
        </button>

        <div class="view-toggle">
          <button class="view-btn active" id="list-view-btn" type="button" aria-pressed="true">List</button>
          <button class="view-btn" id="map-view-btn" type="button" aria-pressed="false">Map</button>
