  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <script>
    import {
      classifyDealCode,
      deriveConsumerPromotionState,
      filterLiveDealsForDiscovery,
      type ConsumerPromotionState,
      type PublicLivePromotion,
    } from '../lib/consumerPromotionState';
    import {
      createLivePromotionFeed,
      type LivePromotionFeedSnapshot,
    } from '../lib/livePromotionFeed';
    import {
      formatCountdown,
      formatSanDiegoDateTime,
      formatSanDiegoTime,
    } from '../lib/promotionClientTime';
    import {
      getHappyHourOccurrenceForDate,
      getSanDiegoDayBounds,
      getSanDiegoParts,
    } from '../lib/sanDiegoTime';
    import { getListingImage } from '../lib/venues';

    let baseHappyHours: any[] = [];
    let happyHours: any[] = [];
    let venueDirectoryLoaded = false;
    let venueDirectoryRefreshPromise: Promise<void> | null = null;
    let userLocation: { lat: number; lng: number } | null = null;
    let map: any = null;
    let markers: any[] = [];
    let accountUser: any = null;
    let saveConfirmation: { spotId: number; text: string } | null = null;
    let dayFilterInitialized = false;
    let dayFilterTouched = false;
    let automaticDayFilter = '';
    let recurringBoundaryTimer: number | null = null;
    let lastRenderedHadFeedData = false;
    let lastRenderedPromotionSignature = '';
    let lastRenderedVenueStateSignature = '';

    const livePromotionFeed = createLivePromotionFeed();
    let feedSnapshot: LivePromotionFeedSnapshot = livePromotionFeed.getSnapshot();
    const EMPTY_CONSUMER_STATE: ConsumerPromotionState = {
      state: 'neither',
      happyHourOccurrence: null,
      liveDeals: [],
    };

    function escapeHTML(value: unknown) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      } as Record<string, string>)[char]);
    }

    function labelize(value: string) {
      return value.replace(/\b\w/g, (letter) => letter.toUpperCase());
    }

    const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const dayAbbrev = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];

    function slugify(name: string) {
      return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    }

    const dayFilterEl = document.getElementById('day-filter') as HTMLSelectElement;

    function getServerNow() {
      return feedSnapshot.data?.clock.now() ?? null;
    }

    function syncServerTimePresentation(now: Date) {
      const sanDiego = getSanDiegoParts(now);
      document.getElementById('current-time')!.textContent = formatSanDiegoTime(now);
      if (!dayFilterInitialized || (!dayFilterTouched && dayFilterEl.value === automaticDayFilter)) {
        dayFilterEl.value = sanDiego.weekday;
        automaticDayFilter = sanDiego.weekday;
        dayFilterInitialized = true;
      }
      return dayNames.indexOf(sanDiego.weekday);
    }

    function refreshTimedPresentation(now: Date) {
      document.getElementById('current-time')!.textContent = formatSanDiegoTime(now);
      for (const element of document.querySelectorAll<HTMLElement>('[data-live-deal-countdown]')) {
        const target = element.dataset.liveDealCountdown;
        const countdown = target ? formatCountdown(target, now) : null;
        element.hidden = countdown === null;
        element.textContent = countdown ? `Ends in ${countdown}` : '';
      }
    }

    function dateKeyAfter(dateKey: string, days: number) {
      const [year, month, day] = dateKey.split('-').map(Number);
      const value = new Date(Date.UTC(year, month - 1, day + days));
      return [
        value.getUTCFullYear(),
        String(value.getUTCMonth() + 1).padStart(2, '0'),
        String(value.getUTCDate()).padStart(2, '0'),
      ].join('-');
    }

    function scheduleRecurringBoundaryRefresh(now: Date) {
      if (recurringBoundaryTimer !== null) window.clearTimeout(recurringBoundaryTimer);
      const nowMilliseconds = now.getTime();
      let nextBoundary = getSanDiegoDayBounds(now).end.getTime();
      const todayKey = getSanDiegoDayBounds(now).dateKey;

      for (const venue of happyHours) {
        for (let offset = 0; offset <= 7; offset += 1) {
          const occurrence = getHappyHourOccurrenceForDate(venue, dateKeyAfter(todayKey, offset));
          if (!occurrence) continue;
          for (const boundary of [occurrence.startsAt, occurrence.endsAt]) {
            const boundaryMilliseconds = boundary.getTime();
            if (boundaryMilliseconds > nowMilliseconds && boundaryMilliseconds < nextBoundary) {
              nextBoundary = boundaryMilliseconds;
            }
          }
        }
      }

      recurringBoundaryTimer = window.setTimeout(() => {
        const anchoredNow = getServerNow();
        if (anchoredNow) render(anchoredNow);
      }, Math.max(25, nextBoundary - nowMilliseconds + 25));
    }

    function getDistance(lat1: number, lng1: number, lat2: number, lng2: number) {
      const R = 3959;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLng = (lng2 - lng1) * Math.PI / 180;
      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLng/2) * Math.sin(dLng/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return R * c;
    }

    function formatDistance(miles: number) {
      if (miles < 0.1) return 'Nearby';
      if (miles < 1) return `${(miles * 5280 / 1000).toFixed(1)}k ft`;
      return `${miles.toFixed(1)} mi`;
    }

    document.getElementById('location-btn')!.addEventListener('click', () => {
      const btn = document.getElementById('location-btn')!;
      const text = document.getElementById('location-text')!;

      if (userLocation) {
        userLocation = null;
        btn.classList.remove('active');
        btn.setAttribute('aria-pressed', 'false');
        text.textContent = 'Near me';
        (document.getElementById('distance-info') as HTMLElement).style.display = 'none';
        render();
        return;
      }

      text.textContent = 'Locating...';

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          userLocation = { lat: pos.coords.latitude, lng: pos.coords.longitude };
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          text.textContent = 'Sorted by distance';
          document.getElementById('distance-info')!.textContent = 'Sorted by distance';
          (document.getElementById('distance-info') as HTMLElement).style.display = 'inline';
          render();
          if (map) {
            map.setView([userLocation.lat, userLocation.lng], 13);
          }
        },
        () => {
          text.textContent = 'Near me';
          alert('Could not get your location. Please enable location services.');
        }
      );
    });

    document.getElementById('list-view-btn')!.addEventListener('click', () => {
      document.getElementById('list-view-btn')!.classList.add('active');
      document.getElementById('map-view-btn')!.classList.remove('active');
      document.getElementById('list-view-btn')!.setAttribute('aria-pressed', 'true');
      document.getElementById('map-view-btn')!.setAttribute('aria-pressed', 'false');
      document.getElementById('map-container')!.classList.remove('active');
      document.getElementById('grid')!.classList.remove('hidden');
    });

    document.getElementById('map-view-btn')!.addEventListener('click', () => {
      document.getElementById('map-view-btn')!.classList.add('active');
      document.getElementById('list-view-btn')!.classList.remove('active');
      document.getElementById('map-view-btn')!.setAttribute('aria-pressed', 'true');
      document.getElementById('list-view-btn')!.setAttribute('aria-pressed', 'false');
      document.getElementById('map-container')!.classList.add('active');
      document.getElementById('grid')!.classList.add('hidden');

      if (!map) {
        initMap();
      }
      setTimeout(() => map.invalidateSize(), 100);
      updateMapMarkers();
    });

    function initMap() {
      const center = userLocation || { lat: 32.7157, lng: -117.1611 };
      // @ts-ignore - Leaflet loaded via script tag
      map = L.map('map').setView([center.lat, center.lng], 12);
      // @ts-ignore
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19
      }).addTo(map);
    }

    function renderMapStatus(state: ConsumerPromotionState) {
      const primaryDeal = state.liveDeals[0];
      if (primaryDeal) {
        return `
          <div class="map-status">
            <span class="live-deal-badge live-deal-badge--secondary"><span class="live-deal-status-dot"></span>Live Deal</span>
            <p class="map-live-headline">${escapeHTML(primaryDeal.title)}</p>
            ${state.state === 'both' ? '<p class="map-secondary-status">Happy hour also happening now</p>' : ''}
          </div>
        `;
      }
      if (state.state === 'happy-hour-only') {
        return '<div class="map-status"><span class="happy-hour-now-badge happy-hour-now-badge--secondary">Happy Hour Now</span></div>';
      }
      return '';
    }

    function updateMapMarkers(
      now = getServerNow(),
      venueStates = buildVenueStates(now)
    ) {
      if (!map) return;
      markers.forEach((m) => map.removeLayer(m));
      markers = [];

      const filtered = getFilteredData(now, venueStates);

      filtered.forEach((h) => {
        const state = venueStates.get(h.id) ?? EMPTY_CONSUMER_STATE;
        const hasLiveDeal = state.state === 'live-deal-only' || state.state === 'both';
        const hasHappyHour = state.state === 'happy-hour-only' || state.state === 'both';
        const markerLabel = hasLiveDeal ? 'LD' : hasHappyHour ? 'HH' : '•';
        const statusLabel = state.state === 'both'
          ? 'Live Deal; Happy Hour Now also happening'
          : hasLiveDeal
            ? 'Live Deal'
            : hasHappyHour
              ? 'Happy Hour Now'
              : 'No current offer status';
        // @ts-ignore
        const icon = L.divIcon({
          className: 'custom-marker',
          html: `<div role="img" aria-label="${escapeHTML(h.name)} — ${statusLabel}" style="
            background: ${hasLiveDeal ? '#8B5CF6' : hasHappyHour ? '#16A34A' : '#FF6B35'};
            width: 36px; height: 36px;
            border-radius: 50%;
            border: 3px solid ${state.state === 'both' ? '#22C55E' : 'white'};
            box-shadow: 0 0 0 2px white, 0 2px 8px rgba(0,0,0,0.3);
            display: flex; align-items: center; justify-content: center;
            color: white; font-weight: 800; font-size: ${hasLiveDeal ? '10px' : '12px'};
          ">${markerLabel}</div>`,
          iconSize: [36, 36],
          iconAnchor: [18, 18]
        });

        // @ts-ignore
        const marker = L.marker([h.lat, h.lng], { icon })
          .bindPopup(`
            <div class="map-popup">
              <h3>${escapeHTML(h.name)}</h3>
              <div class="vibe">${escapeHTML(h.vibe)} · ${h.verified ? 'Verified' : 'Needs verification'}</div>
              ${renderMapStatus(state)}
              <div class="time">Regular happy hour: ${formatTime(h.startTime)} – ${formatTime(h.endTime)}</div>
              <div class="deals">${h.deals.slice(0, 2).map(escapeHTML).join(' • ')}</div>
              <a href="/venues/${slugify(h.name)}/">View details</a>
            </div>
          `)
          .addTo(map);

        markers.push(marker);
      });
    }

    async function loadAccount() {
      try {
        const res = await fetch('/api/account/me');
        const session = await res.json();
        accountUser = session.authenticated ? session.user : null;
      } catch {
        accountUser = null;
      }

      render();
    }

    function getSavedSpot(spotId: number) {
      return accountUser?.savedSpots?.find((item: any) => item.spotId === spotId);
    }

    function populateSelect(id: string, values: string[], formatter: (v: string) => string = (v) => v) {
      const select = document.getElementById(id) as HTMLSelectElement;
      values.forEach((n) => {
        const opt = document.createElement('option');
        opt.value = n;
        opt.textContent = formatter(n);
        select.appendChild(opt);
      });
    }

    /** Lays each verified owner's own edits over the build-time record.
     *
     * happy-hours.json is a static asset baked at deploy time; an owner
     * correcting their hours writes to venue_overrides instead and it takes
     * effect immediately (see src/lib/venueContent.ts). Without this merge the
     * cards here would disagree with the venue page, which does apply them.
     *
     * A plain spread is the whole merge: a stored patch only ever holds
     * complete values for owner-editable fields, and the endpoint filters it
     * to those fields on the way out.
     */
    async function mergeOwnerEdits(venues: any[], failureFallback = venues) {
      try {
        const res = await fetch('/api/venue-overrides', { cache: 'no-store' });
        if (!res.ok) return failureFallback;
        const { overrides } = await res.json();
        if (!overrides) return venues;
        return venues.map((venue) => {
          const patch = overrides[String(venue.id)];
          return patch ? { ...venue, ...patch } : venue;
        });
      } catch {
        // Keep the last successfully loaded record if reconciliation fails.
        return failureFallback;
      }
    }

    async function loadData() {
      const res = await fetch('/data/happy-hours.json');
      baseHappyHours = await res.json();
      happyHours = await mergeOwnerEdits(baseHappyHours);
      venueDirectoryLoaded = true;

      populateSelect('neighborhood-filter', [...new Set(happyHours.map((h) => h.neighborhood))].sort());
      populateSelect('deal-filter', [...new Set(happyHours.flatMap((h) => h.dealTypes || []))].sort(), labelize);
      populateSelect('feature-filter', [...new Set(happyHours.flatMap((h) => h.features || []))].sort(), labelize);

      await loadAccount();
      render();
    }

    /**
     * The homepage can survive an admin visit in the back/forward cache, and
     * it can stay open in another tab while an image is saved. Reconcile the
     * no-store override endpoint whenever the page becomes active again.
     * Keeping the static dataset separate also means removed overrides really
     * disappear instead of being merged over an already-merged stale record.
     */
    async function refreshVenueDirectory() {
      if (!venueDirectoryLoaded || !baseHappyHours.length) return;
      if (venueDirectoryRefreshPromise) return venueDirectoryRefreshPromise;

      venueDirectoryRefreshPromise = (async () => {
        const refreshed = await mergeOwnerEdits(baseHappyHours, happyHours);
        if (JSON.stringify(refreshed) === JSON.stringify(happyHours)) return;
        happyHours = refreshed;
        render();
      })();

      try {
        await venueDirectoryRefreshPromise;
      } finally {
        venueDirectoryRefreshPromise = null;
      }
    }

    function buildVenueStates(now: Date | null) {
      const states = new Map<number, ConsumerPromotionState>();
      for (const venue of happyHours) {
        states.set(
          venue.id,
          now && feedSnapshot.data
            ? deriveConsumerPromotionState({
                venueId: venue.id,
                schedule: venue,
                promotions: feedSnapshot.data.promotions,
                now,
              })
            : EMPTY_CONSUMER_STATE
        );
      }
      return states;
    }

    function promotionSignature() {
      return JSON.stringify(feedSnapshot.data?.promotions ?? []);
    }

    function venueStateSignature(states: Map<number, ConsumerPromotionState>) {
      return JSON.stringify([...states.entries()].map(([venueId, state]) => [
        venueId,
        state.state,
        state.happyHourOccurrence?.startsAt.toISOString() ?? null,
        state.liveDeals.map((promotion) => promotion.id),
      ]));
    }

    function directoryVenue(venueId: number) {
      return happyHours.find((venue) => venue.id === venueId);
    }

    function activeLiveDeals(now: Date | null) {
      if (!now || !feedSnapshot.data) return [];
      return feedSnapshot.data.promotions.filter((promotion) =>
        deriveConsumerPromotionState({
          venueId: promotion.venueId,
          schedule: null,
          promotions: [promotion],
          now,
        }).liveDeals.length > 0
      );
    }

    function getDiscoveryLiveDeals(now: Date | null) {
      const query = (document.getElementById('search-input') as HTMLInputElement).value.trim();
      const neighborhood = (document.getElementById('neighborhood-filter') as HTMLSelectElement).value;
      const filtered = filterLiveDealsForDiscovery(
        activeLiveDeals(now),
        {
          query,
          neighborhood,
          // Near Me currently means distance sorting, not a radius boundary.
          // Supplying coordinates here keeps an explicit radius a safe future addition.
          radius: null,
        },
        {
          venueSearchText: (venueId) => {
            const venue = directoryVenue(venueId);
            return venue
              ? [
                  venue.address,
                  venue.vibe,
                  ...(venue.deals || []),
                  ...(venue.dealTypes || []),
                  ...(venue.features || []),
                ]
              : null;
          },
          venueCoordinates: (venueId) => {
            const venue = directoryVenue(venueId);
            return venue && Number.isFinite(venue.lat) && Number.isFinite(venue.lng)
              ? { latitude: venue.lat, longitude: venue.lng }
              : null;
          },
          distanceMiles: (from, to) =>
            getDistance(from.latitude, from.longitude, to.latitude, to.longitude),
        }
      );

      return filtered.sort((left, right) => {
        if (userLocation) {
          const leftVenue = directoryVenue(left.venueId);
          const rightVenue = directoryVenue(right.venueId);
          const leftDistance = leftVenue
            ? getDistance(userLocation.lat, userLocation.lng, leftVenue.lat, leftVenue.lng)
            : Number.POSITIVE_INFINITY;
          const rightDistance = rightVenue
            ? getDistance(userLocation.lat, userLocation.lng, rightVenue.lat, rightVenue.lng)
            : Number.POSITIVE_INFINITY;
          if (leftDistance !== rightDistance) return leftDistance - rightDistance;
        }
        return left.effectiveEndsAt.localeCompare(right.effectiveEndsAt);
      });
    }

    function renderDealCode(promotion: PublicLivePromotion) {
      const codeState = classifyDealCode(promotion);
      if (codeState.kind === 'none') return '';
      if (codeState.kind === 'gated') {
        const next = encodeURIComponent(`/venues/${promotion.venue.slug}/`);
        return `
          <div class="live-deal-code-row">
            <span>Deal code available</span>
            <a class="live-deal-link" href="/account/?next=${next}">Sign in to see deal code</a>
          </div>
        `;
      }
      return `
        <div class="live-deal-code-row">
          <span>Deal code</span>
          <code class="live-deal-code">${escapeHTML(codeState.code)}</code>
        </div>
      `;
    }

    function renderLiveDeals(now: Date | null) {
      const section = document.getElementById('live-deals-section') as HTMLElement;
      const grid = document.getElementById('live-deals-grid')!;
      const count = document.getElementById('live-deals-count')!;
      const promotions = getDiscoveryLiveDeals(now);

      if (!now || promotions.length === 0) {
        section.hidden = true;
        grid.innerHTML = '';
        count.textContent = '';
        return;
      }

      section.hidden = false;
      count.textContent = `${promotions.length} ${promotions.length === 1 ? 'deal' : 'deals'} happening now`;
      grid.innerHTML = promotions.map((promotion) => {
        const venue = directoryVenue(promotion.venueId);
        // Prefer the freshly merged directory record over the image snapshot
        // embedded in the promotion feed. The two endpoints are fetched
        // independently, so that snapshot can briefly lag an admin save.
        const imageSources = getCardImageSources(venue, promotion.venue.image);
        const state = deriveConsumerPromotionState({
          venueId: promotion.venueId,
          schedule: venue ?? null,
          promotions: feedSnapshot.data?.promotions ?? [promotion],
          now,
        });
        const countdown = formatCountdown(promotion.effectiveEndsAt, now);
        const distance = userLocation && venue
          ? getDistance(userLocation.lat, userLocation.lng, venue.lat, venue.lng)
          : null;
        const venuePath = `/venues/${promotion.venue.slug}/`;
        const promotionType = labelize(promotion.type.replaceAll('_', ' '));

        return `
          <article class="live-deal-panel live-deal-discovery-card">
            <a class="live-deal-discovery-image" href="${venuePath}" aria-label="View ${escapeHTML(promotion.venue.name)}">
              <img
                src="${escapeHTML(imageSources.primary)}"
                alt="${escapeHTML(promotion.venue.name)}"
                loading="lazy"
                data-listing-image
                data-original-src="${escapeHTML(imageSources.original)}"
                data-stock-src="${escapeHTML(imageSources.stock)}"
              >
            </a>
            <div class="live-deal-discovery-body">
              <div class="live-deal-heading-row">
                <span class="live-deal-badge"><span class="live-deal-status-dot"></span>Live Deal</span>
                <span class="live-deal-type">${escapeHTML(promotionType)}</span>
              </div>
              <h3 class="live-deal-title">${escapeHTML(promotion.title)}</h3>
              <div class="live-deal-meta">
                <a class="live-deal-venue" href="${venuePath}">${escapeHTML(promotion.venue.name)}</a>
                <span>${escapeHTML(promotion.venue.neighborhood)}</span>
                ${distance === null ? '' : `<span>${formatDistance(distance)}</span>`}
              </div>
              <div class="live-deal-meta">
                ${countdown ? `<span class="live-deal-countdown" data-live-deal-countdown="${escapeHTML(promotion.effectiveEndsAt)}">Ends in ${escapeHTML(countdown)}</span>` : ''}
                <span>Ends ${escapeHTML(formatSanDiegoDateTime(promotion.effectiveEndsAt))}</span>
              </div>
              ${state.state === 'both' ? '<p class="live-deal-details"><strong>Happy hour also happening now</strong></p>' : ''}
              ${promotion.description ? `<p class="live-deal-details">${escapeHTML(promotion.description)}</p>` : ''}
              ${renderDealCode(promotion)}
              <div class="live-deal-meta">
                <a class="live-deal-link" href="${venuePath}">View venue details →</a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    function formatTime(time: string) {
      const [h, m] = time.split(':').map(Number);
      const ampm = h >= 12 ? 'PM' : 'AM';
      const hour = h % 12 || 12;
      return `${hour}:${m.toString().padStart(2, '0')} ${ampm}`;
    }

    /**
     * Keep three independently useful sources for every venue card:
     * the card-sized CDN URL, the original admin upload in case only that
     * transform failed, and the venue's stock image if the upload also fails.
     * The promotion image is used only until the directory data has loaded.
     */
    function getCardImageSources(venue: any, promotionImage = '') {
      if (!venue) {
        return { primary: promotionImage, original: promotionImage, stock: '' };
      }
      return {
        primary: getListingImage(venue, 'card'),
        original: typeof venue.image === 'string' ? venue.image : '',
        stock: getListingImage({ vibe: venue.vibe }, 'card'),
      };
    }

    function getTrustLabel(h: any) {
      if (h.verified && h.lastVerifiedAt) {
        return `Verified ${new Date(h.lastVerifiedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}`;
      }
      if (h.verified) return 'Verified';
      return 'Needs verification';
    }

    function matchesSearch(h: any, query: string) {
      if (!query) return true;
      const haystack = [h.name, h.neighborhood, h.address, h.vibe, ...(h.deals || []), ...(h.dealTypes || []), ...(h.features || [])]
        .join(' ')
        .toLowerCase();
      return haystack.includes(query);
    }

    function stateSortRank(state: ConsumerPromotionState) {
      if (state.state === 'live-deal-only' || state.state === 'both') return 0;
      if (state.state === 'happy-hour-only') return 1;
      return 2;
    }

    function getFilteredData(
      now = getServerNow(),
      venueStates = buildVenueStates(now)
    ) {
      const searchQuery = (document.getElementById('search-input') as HTMLInputElement).value.trim().toLowerCase();
      const dayFilter = (document.getElementById('day-filter') as HTMLSelectElement).value;
      const neighborhoodFilter = (document.getElementById('neighborhood-filter') as HTMLSelectElement).value;
      const dealFilter = (document.getElementById('deal-filter') as HTMLSelectElement).value;
      const featureFilter = (document.getElementById('feature-filter') as HTMLSelectElement).value;
      const statusFilter = (document.getElementById('status-filter') as HTMLSelectElement).value;
      const trustFilter = (document.getElementById('trust-filter') as HTMLSelectElement).value;

      let filtered = [...happyHours];

      if (searchQuery) filtered = filtered.filter((h) => matchesSearch(h, searchQuery));
      if (dayFilter) filtered = filtered.filter((h) => h.days.includes(dayFilter));
      if (neighborhoodFilter) filtered = filtered.filter((h) => h.neighborhood === neighborhoodFilter);
      if (dealFilter) filtered = filtered.filter((h) => (h.dealTypes || []).includes(dealFilter));
      if (featureFilter) filtered = filtered.filter((h) => (h.features || []).includes(featureFilter));
      if (statusFilter === 'happy-hour-now') {
        filtered = filtered.filter((h) => Boolean(venueStates.get(h.id)?.happyHourOccurrence));
      }
      if (statusFilter === 'live-deals') {
        filtered = filtered.filter((h) => Boolean(venueStates.get(h.id)?.liveDeals.length));
      }
      if (trustFilter === 'verified') filtered = filtered.filter((h) => h.verified);
      if (trustFilter === 'unverified') filtered = filtered.filter((h) => !h.verified);

      if (userLocation) {
        filtered = filtered.map((h) => ({
          ...h,
          distance: getDistance(userLocation!.lat, userLocation!.lng, h.lat, h.lng)
        }));
      }

      filtered.sort((left, right) => {
        const stateDifference =
          stateSortRank(venueStates.get(left.id) ?? EMPTY_CONSUMER_STATE) -
          stateSortRank(venueStates.get(right.id) ?? EMPTY_CONSUMER_STATE);
        if (stateDifference !== 0) return stateDifference;
        if (userLocation && left.distance !== right.distance) return left.distance - right.distance;
        return left.startTime.localeCompare(right.startTime);
      });

      return filtered;
    }

    function render(now = getServerNow()) {
      const todayIndex = now ? syncServerTimePresentation(now) : -1;
      const venueStates = buildVenueStates(now);
      const filtered = getFilteredData(now, venueStates);

      const grid = document.getElementById('grid')!;
      const empty = document.getElementById('empty-state')!;
      const countEl = document.getElementById('result-count')!;
      const liveCountBig = document.getElementById('live-count-big')!;

      const happyHoursNow = [...venueStates.values()]
        .filter((state) => state.happyHourOccurrence !== null)
        .length;
      countEl.textContent = String(filtered.length);
      liveCountBig.textContent = String(happyHoursNow);
      renderLiveDeals(now);

      if (filtered.length === 0) {
        (grid as HTMLElement).style.display = 'none';
        grid.innerHTML = '';
        (empty as HTMLElement).style.display = 'block';
      } else {
        (grid as HTMLElement).style.display = '';
        (empty as HTMLElement).style.display = 'none';

        grid.innerHTML = filtered.map((h) => {
          const state = venueStates.get(h.id) ?? EMPTY_CONSUMER_STATE;
          const primaryDeal = state.liveDeals[0];
          const hasLiveDeal = Boolean(primaryDeal);
          const hasHappyHour = state.happyHourOccurrence !== null;
          const imageSources = getCardImageSources(h);
          const hasDistance = h.distance !== undefined;
          const slug = slugify(h.name);
          const statusBadge = hasLiveDeal
            ? '<div class="card-status-badge"><span class="live-deal-badge"><span class="live-deal-status-dot"></span>Live Deal</span></div>'
            : hasHappyHour
              ? '<div class="card-status-badge"><span class="happy-hour-now-badge">Happy Hour Now</span></div>'
              : '';
          const stateClass = hasLiveDeal ? 'has-live-deal' : hasHappyHour ? 'is-happy-hour' : '';

          const weekDots = dayNames.map((day, i) => {
            const active = h.days.includes(day);
            const isToday = i === todayIndex;
            let cls = 'week-dot';
            if (active) cls += ' active';
            if (isToday) cls += ' today';
            return `<span class="${cls}">${dayAbbrev[i]}</span>`;
          }).join('');

          const trustClass = h.verified ? '' : ' unverified';
          const featureTags = (h.features || []).slice(0, 3)
            .map((tag: string) => `<span class="feature-tag">${escapeHTML(labelize(tag))}</span>`)
            .join('');

          return `
            <article class="card ${stateClass}">
              <a href="/venues/${slug}/" style="text-decoration: none; color: inherit;">
                <div class="card-image">
                  <img
                    src="${escapeHTML(imageSources.primary)}"
                    alt="${escapeHTML(h.name)}"
                    loading="lazy"
                    data-listing-image
                    data-original-src="${escapeHTML(imageSources.original)}"
                    data-stock-src="${escapeHTML(imageSources.stock)}"
                  >
                  <div class="overlay"></div>
                  ${statusBadge}
                  ${hasDistance
                    ? `<span class="distance-tag">${formatDistance(h.distance)}</span>`
                    : `<span class="neighborhood-tag">${escapeHTML(h.neighborhood)}</span>`
                  }
                  <div class="time-overlay">
                    <span class="venue-name">${escapeHTML(h.name)}</span>
                    <span class="time-badge">${formatTime(h.startTime)} – ${formatTime(h.endTime)}</span>
                  </div>
                </div>
              </a>

              <div class="card-body">
                <div class="card-meta">
                  <span class="card-vibe">${escapeHTML(h.vibe)}</span>
                  <span class="trust-badge${trustClass}">${getTrustLabel(h)}</span>
                  ${h.phone ? `<a class="card-phone" href="tel:${h.phone.replace(/[^0-9+]/g, '')}">${escapeHTML(h.phone)}</a>` : ''}
                  ${hasDistance ? `<span class="card-distance">${escapeHTML(h.neighborhood)}</span>` : ''}
                </div>

                ${primaryDeal ? `
                  <div class="card-live-summary">
                    <strong>${escapeHTML(primaryDeal.title)}</strong>
                    ${state.state === 'both' ? '<span>Happy hour also happening now</span>' : ''}
                  </div>
                ` : ''}

                <div class="tag-row">${featureTags}</div>

                <div class="trust-row">
                  <span>${h.verified ? 'Venue details checked' : 'Community-sourced listing'}</span>
                  <a href="/submit/">Report update</a>
                </div>

                ${renderSavePanel(h)}

                <div class="week-row">${weekDots}</div>

                <div class="card-deals">
                  <h3>Deals</h3>
                  <div class="deal-grid">
                    ${h.deals.slice(0, 3).map((d: string) => `<span class="deal">${escapeHTML(d)}</span>`).join('')}
                  </div>
                </div>

                <div class="card-footer">
                  <a class="card-address" href="https://maps.google.com/?q=${encodeURIComponent(h.address + ', San Diego, CA')}" target="_blank" rel="noopener">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    <span>${escapeHTML(h.address)}</span>
                  </a>
                  <a class="card-cta" href="/venues/${slug}/">
                    Details
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          `;
        }).join('');
      }

      lastRenderedHadFeedData = feedSnapshot.data !== null;
      lastRenderedPromotionSignature = promotionSignature();
      lastRenderedVenueStateSignature = venueStateSignature(venueStates);
      if (now) scheduleRecurringBoundaryRefresh(now);

      if (document.getElementById('map-container')!.classList.contains('active')) {
        updateMapMarkers(now, venueStates);
      }
    }

    function renderSavePanel(h: any) {
      if (!accountUser) {
        return `
          <div class="save-panel compact">
            <span>Save notes and lists</span>
            <button class="save-action" data-save-login>Log in</button>
          </div>
        `;
      }

      const saved = getSavedSpot(h.id);
      if (!saved) {
        return `
          <div class="save-panel compact">
            <span>Add to your happy hour list</span>
            <button class="save-action" data-save-spot="${h.id}">Save</button>
          </div>
        `;
      }

      const confirm = saveConfirmation && saveConfirmation.spotId === h.id
        ? `<span class="save-confirm">&#10003; ${escapeHTML(saveConfirmation.text)}</span>`
        : '';

      return `
        <div class="save-panel" data-saved-spot="${h.id}">
          <select data-save-status>
            <option value="favorite" ${saved.status === 'favorite' ? 'selected' : ''}>Favorite</option>
            <option value="want-to-try" ${saved.status === 'want-to-try' ? 'selected' : ''}>Want to try</option>
            <option value="been-to" ${saved.status === 'been-to' ? 'selected' : ''}>Been to</option>
          </select>
          <input data-save-note value="${escapeHTML(saved.note)}" placeholder="Private note or shareable tip" />
          <div class="save-actions">
            <button class="save-action" data-update-spot="${h.id}">Update</button>
            <button class="save-action secondary" data-remove-spot="${h.id}">Remove</button>
            ${confirm}
          </div>
        </div>
      `;
    }

    /**
     * Image errors do not bubble, so use capture listeners on the permanent
     * grids. A failed Netlify transform first retries the original upload;
     * if that also fails, the venue-specific stock image takes over. Sources
     * are removed before retrying so a damaged stock asset cannot loop.
     */
    function restoreListingImage(event: Event) {
      const image = event.target;
      if (!(image instanceof HTMLImageElement) || !image.hasAttribute('data-listing-image')) return;

      const current = image.getAttribute('src') || '';
      const original = image.dataset.originalSrc || '';
      delete image.dataset.originalSrc;
      if (original && original !== current) {
        image.src = original;
        return;
      }

      const stock = image.dataset.stockSrc || '';
      delete image.dataset.stockSrc;
      if (stock && stock !== current) image.src = stock;
    }

    document.getElementById('grid')!.addEventListener('error', restoreListingImage, true);
    document.getElementById('live-deals-grid')!.addEventListener('error', restoreListingImage, true);

    document.getElementById('search-input')!.addEventListener('input', () => render());
    document.getElementById('day-filter')!.addEventListener('change', () => {
      dayFilterInitialized = true;
      dayFilterTouched = true;
      render();
    });
    document.getElementById('neighborhood-filter')!.addEventListener('change', () => render());
    document.getElementById('deal-filter')!.addEventListener('change', () => render());
    document.getElementById('feature-filter')!.addEventListener('change', () => render());
    document.getElementById('status-filter')!.addEventListener('change', () => render());
    document.getElementById('trust-filter')!.addEventListener('change', () => render());

    // "Save as Alert" — captures whatever's currently in the filter bar
    // (day/neighborhood/deal/feature/search) as a named, saved alert. Full
    // editing (multi-day, toggling, deleting, sharing) happens in My Stuff (/account/);
    // this is just the quick-capture entry point.
    const saveAlertPanel = document.getElementById('save-alert-panel')!;
    const saveAlertStatus = document.getElementById('alert-save-status')!;

    document.getElementById('save-alert-btn')!.addEventListener('click', () => {
      if (!accountUser) {
        window.location.href = '/account/';
        return;
      }
      saveAlertPanel.classList.toggle('hidden');
      if (!saveAlertPanel.classList.contains('hidden')) {
        (document.getElementById('alert-name-input') as HTMLInputElement).focus();
      }
    });

    document.getElementById('alert-save-cancel')!.addEventListener('click', () => {
      saveAlertPanel.classList.add('hidden');
      saveAlertStatus.textContent = '';
      saveAlertStatus.classList.remove('error');
    });

    document.getElementById('alert-save-confirm')!.addEventListener('click', async () => {
      const nameInput = document.getElementById('alert-name-input') as HTMLInputElement;
      const name = nameInput.value.trim();
      if (!name) {
        saveAlertStatus.classList.add('error');
        saveAlertStatus.textContent = 'Give this alert a name.';
        return;
      }

      const dayValue = (document.getElementById('day-filter') as HTMLSelectElement).value;
      const filters = {
        days: dayValue ? [dayValue] : [],
        neighborhood: (document.getElementById('neighborhood-filter') as HTMLSelectElement).value,
        dealType: (document.getElementById('deal-filter') as HTMLSelectElement).value,
        feature: (document.getElementById('feature-filter') as HTMLSelectElement).value,
        query: (document.getElementById('search-input') as HTMLInputElement).value.trim(),
      };
      const channels = {
        email: (document.getElementById('alert-channel-email') as HTMLInputElement).checked,
        text: (document.getElementById('alert-channel-text') as HTMLInputElement).checked,
      };

      saveAlertStatus.classList.remove('error');
      saveAlertStatus.textContent = 'Saving...';
      try {
        const res = await fetch('/api/account/alerts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, filters, channels }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error((json.errors || ['Could not save alert.']).join(' '));
        saveAlertStatus.textContent = 'Saved — manage it in My Stuff.';
        nameInput.value = '';
        setTimeout(() => {
          saveAlertPanel.classList.add('hidden');
          saveAlertStatus.textContent = '';
        }, 1800);
      } catch (err: any) {
        saveAlertStatus.classList.add('error');
        saveAlertStatus.textContent = err.message;
      }
    });

    document.getElementById('grid')!.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;

      if (target.closest('[data-save-login]')) {
        window.location.href = '/account/';
        return;
      }

      const saveButton = target.closest('[data-save-spot]') as HTMLElement | null;
      const updateButton = target.closest('[data-update-spot]') as HTMLElement | null;
      const removeButton = target.closest('[data-remove-spot]') as HTMLElement | null;
      const spotId = saveButton?.dataset.saveSpot || updateButton?.dataset.updateSpot || removeButton?.dataset.removeSpot;
      if (!spotId) return;

      event.preventDefault();

      if (removeButton) {
        saveConfirmation = null;
        await fetch(`/api/account/spots/${spotId}`, { method: 'DELETE' });
      } else {
        const panel = target.closest('.save-panel');
        await fetch(`/api/account/spots/${spotId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            status: (panel?.querySelector('[data-save-status]') as HTMLSelectElement | null)?.value || 'favorite',
            note: (panel?.querySelector('[data-save-note]') as HTMLInputElement | null)?.value || '',
          }),
        });
        saveConfirmation = { spotId: Number(spotId), text: updateButton ? 'Updated' : 'Saved' };
      }
      await loadAccount();

      if (saveConfirmation) {
        const confirmedId = saveConfirmation.spotId;
        setTimeout(() => {
          if (saveConfirmation && saveConfirmation.spotId === confirmedId) {
            saveConfirmation = null;
            render();
          }
        }, 2000);
      }
    });

    const unsubscribeFromLivePromotions = livePromotionFeed.subscribe((snapshot) => {
      feedSnapshot = snapshot;
      const now = getServerNow();
      const venueStates = buildVenueStates(now);
      const nextPromotionSignature = promotionSignature();
      const promotionsChanged = nextPromotionSignature !== lastRenderedPromotionSignature;
      const presentationChanged =
        (snapshot.data !== null) !== lastRenderedHadFeedData ||
        promotionsChanged ||
        venueStateSignature(venueStates) !== lastRenderedVenueStateSignature;

      if (presentationChanged) {
        render(now);
      } else if (now) {
        refreshTimedPresentation(now);
        scheduleRecurringBoundaryRefresh(now);
      }

      // A promotion response includes its current merged venue image. If that
      // snapshot changed while this page stayed open, reconcile the directory
      // endpoint too so both homepage card types continue to agree.
      if (promotionsChanged) void refreshVenueDirectory();
    });

    window.addEventListener('sdhh:auth-changed', () => {
      void livePromotionFeed.authenticationChanged();
      void loadAccount();
    });

    window.addEventListener('focus', () => {
      void refreshVenueDirectory();
    });

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void refreshVenueDirectory();
    });

    window.addEventListener('pageshow', (event) => {
      if (!(event as PageTransitionEvent).persisted) return;
      // A different page may have signed the visitor out while this DOM was
      // in the back/forward cache. pagehide already redacted synchronously;
      // restarting the feed reconciles the canonical session-scoped payload.
      livePromotionFeed.start();
      void loadAccount();
      void refreshVenueDirectory();
    });

    const timedPresentationInterval = window.setInterval(() => {
      const now = getServerNow();
      if (now) refreshTimedPresentation(now);
    }, 30_000);

    window.addEventListener('pagehide', (event) => {
      livePromotionFeed.stop();
      // A cached document must not retain session-only codes. This call
      // redacts synchronously before its promise waits for an aborted request.
      void livePromotionFeed.authenticationChanged();
      if ((event as PageTransitionEvent).persisted) return;
      window.clearInterval(timedPresentationInterval);
      if (recurringBoundaryTimer !== null) window.clearTimeout(recurringBoundaryTimer);
      unsubscribeFromLivePromotions();
    });

    livePromotionFeed.start();
    loadData();
  </script>
</Layout>
