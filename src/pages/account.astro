    function optionList(values: string[], selected: string) {
      return `<option value="">Any</option>` + values.map((v) =>
        `<option value="${escapeHTML(v)}" ${v === selected ? 'selected' : ''}>${escapeHTML(labelize(v))}</option>`
      ).join('');
    }

    function filterFieldsHTML(filters: any = {}, happyHours: any[] = []) {
      const neighborhoods = [...new Set(happyHours.map((h: any) => h.neighborhood).filter(Boolean))].sort();
      const dealTypes = [...new Set(happyHours.flatMap((h: any) => h.dealTypes || []))].sort();
      const days = Array.isArray(filters?.days) ? filters.days : [];

      return `
        <div class="day-checks">
          ${dayNames.map((day, i) => `
            <label class="day-check">
              ${dayAbbrev[i]}
              <input type="checkbox" data-field="days" value="${day}" ${days.includes(day) ? 'checked' : ''}>
            </label>
          `).join('')}
        </div>
        <div class="filter-row">
          <select data-field="neighborhood">${optionList(neighborhoods, filters?.neighborhood || '')}</select>
          <select data-field="dealType">${optionList(dealTypes, filters?.dealType || '')}</select>
        </div>
        <div class="filter-row">
          <label>Starts after <input type="time" data-field="startTime" value="${escapeHTML(filters?.startTime || '')}"></label>
          <label>Ends before <input type="time" data-field="endTime" value="${escapeHTML(filters?.endTime || '')}"></label>
        </div>
        <input type="text" data-field="query" placeholder="Keyword (optional)" value="${escapeHTML(filters?.query || '')}">
      `;
    }

    function readFilterFields(container: HTMLElement) {
      const days = Array.from(container.querySelectorAll('[data-field="days"]:checked')).map((el) => (el as HTMLInputElement).value);
      return {
        days,
        neighborhood: (container.querySelector('[data-field="neighborhood"]') as HTMLSelectElement)?.value || '',
        dealType: (container.querySelector('[data-field="dealType"]') as HTMLSelectElement)?.value || '',
        query: (container.querySelector('[data-field="query"]') as HTMLInputElement)?.value || '',
        startTime: (container.querySelector('[data-field="startTime"]') as HTMLInputElement)?.value || '',
        endTime: (container.querySelector('[data-field="endTime"]') as HTMLInputElement)?.value || '',
      };
    }

    function readChannelFields(container: HTMLElement) {
      return {
        email: (container.querySelector('[data-field="channel-email"]') as HTMLInputElement)?.checked ?? true,
        text: (container.querySelector('[data-field="channel-text"]') as HTMLInputElement)?.checked ?? false,
      };
    }

    function smsTextEligible() {
      return Boolean(currentUser?.phone && currentUser?.smsOptedIn);
    }

    function channelFieldsHTML(channels: any = {}) {
      const eligible = smsTextEligible();
      const textNote = eligible
        ? '<span class="channel-note">(uses your phone from Preferences)</span>'
        : '<span class="channel-note">(<a href="#section-preferences">Set up text alerts</a> first)</span>';
      return `
        <div class="channel-row">
          <label class="channel-check">
            <input type="checkbox" data-field="channel-email" ${channels?.email !== false ? 'checked' : ''}>
            Email
          </label>
          <label class="channel-check">
            <input type="checkbox" data-field="channel-text" ${channels?.text ? 'checked' : ''}>
            Text ${textNote}
          </label>
        </div>
      `;
    }

    async function renderCreateAlertForm() {
      const form = document.getElementById('create-form')!;
      const happyHours = await getHappyHours();
      form.innerHTML = `
        <label>Alert name <input type="text" data-field="name" placeholder="e.g. Friday Rooftop Wine" required></label>
        ${filterFieldsHTML({}, happyHours)}
        ${channelFieldsHTML({ email: true, text: false })}
        <div class="alert-actions">
          <button type="submit">Save alert</button>
          <div class="status" id="create-status" aria-live="polite"></div>
        </div>
      `;
    }

    function matchCount(filters: any, happyHours: any[]) {
      return happyHours.filter((h: any) => alertMatchesVenue(filters || {}, h)).length;
    }

    async function renderAlertsList() {
      const grid = document.getElementById('alerts-grid')!;
      const alerts = currentUser?.alerts || [];
      document.getElementById('list-subtitle')!.textContent = `${alerts.length} alert${alerts.length === 1 ? '' : 's'}`;

      if (!alerts.length) {
        grid.innerHTML = '<div class="empty">No alerts yet. Create one above, or save a filter combo from the homepage.</div>';
        return;
      }

      const happyHours = await getHappyHours();
      grid.innerHTML = alerts.map((alert: any) => {
        const count = matchCount(alert.filters, happyHours);
        const confirm = alertSaveConfirmation && alertSaveConfirmation.alertId === alert.id
          ? `<span class="save-confirm">&#10003; ${escapeHTML(alertSaveConfirmation.text)}</span>`
          : '';
        return `
          <article class="alert-card${alert.active ? '' : ' is-inactive'}" data-id="${alert.id}">
            <div class="alert-card-top">
              <label class="toggle-row">
                <input type="checkbox" data-action="toggle" ${alert.active ? 'checked' : ''}>
                ${alert.active ? 'On' : 'Off'}
              </label>
              <span class="match-count">${count} spot${count === 1 ? '' : 's'} match right now</span>
            </div>
            <label>Alert name <input type="text" data-field="name" value="${escapeHTML(alert.name)}"></label>
            ${filterFieldsHTML(alert.filters, happyHours)}
            ${channelFieldsHTML(alert.channels)}
            <div class="alert-actions">
              <button data-action="save">Save changes</button>
              <button class="secondary" data-action="share">Copy share link</button>
              <button class="secondary" data-action="delete">Delete</button>
              ${confirm}
            </div>
          </article>
        `;
      }).join('');
    }

    document.getElementById('create-form')!.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const status = document.getElementById('create-status')!;
      const button = form.querySelector('button') as HTMLButtonElement;
      status.classList.remove('error');
      status.textContent = 'Saving...';
      button.disabled = true;
      try {
        await postJson('/api/account/alerts', {
          name: (form.querySelector('[data-field="name"]') as HTMLInputElement).value,
          filters: readFilterFields(form),
          channels: readChannelFields(form),
        });
        await loadAccount();
      } catch (err: any) {
        status.classList.add('error');
        status.textContent = err.message;
      } finally {
        button.disabled = false;
      }
    });

    document.getElementById('alerts-grid')!.addEventListener('change', async (event) => {
      const toggle = (event.target as HTMLElement).closest('[data-action="toggle"]') as HTMLInputElement | null;
      if (!toggle) return;
      const card = toggle.closest('.alert-card') as HTMLElement;
      const id = card.dataset.id!;
      await postJson(`/api/account/alerts/${id}`, { active: toggle.checked }, 'PUT');
      await loadAccount();
    });

    document.getElementById('alerts-grid')!.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
      if (!button) return;
      const card = button.closest('.alert-card') as HTMLElement;
      const id = card.dataset.id!;
      const action = button.dataset.action;

      if (action === 'delete') {
        alertSaveConfirmation = null;
        await postJson(`/api/account/alerts/${id}`, {}, 'DELETE');
        await loadAccount();
        return;
      }

      if (action === 'share') {
        const url = `${window.location.origin}/alerts/shared/?id=${encodeURIComponent(currentUser.shareId)}&alert=${encodeURIComponent(id)}`;
        await navigator.clipboard.writeText(url);
        alertSaveConfirmation = { alertId: id, text: 'Link copied' };
        renderAlertsList();
        setTimeout(() => { alertSaveConfirmation = null; renderAlertsList(); }, 2000);
        return;
      }

      if (action === 'save') {
        await postJson(`/api/account/alerts/${id}`, {
          name: (card.querySelector('[data-field="name"]') as HTMLInputElement).value,
          filters: readFilterFields(card),
          channels: readChannelFields(card),
        }, 'PUT');
        alertSaveConfirmation = { alertId: id, text: 'Saved' };
        await loadAccount();
        setTimeout(() => { alertSaveConfirmation = null; renderAlertsList(); }, 2000);
      }
    });

    // ---------------------------------------------------------------------
    // Preferences (weekly digest opt-in, phone + SMS opt-in)
    // ---------------------------------------------------------------------

    function renderPreferences() {
      const form = document.getElementById('preferences-form') as HTMLFormElement;
      const statusEl = document.getElementById('sms-status')!;
      const testBtn = document.getElementById('test-sms-btn') as HTMLButtonElement;
      (form.querySelector('[name="weeklyDigestOptIn"]') as HTMLInputElement).checked = Boolean(currentUser.weeklyDigestOptIn);
      (form.querySelector('[name="phone"]') as HTMLInputElement).value = currentUser.phone || '';
      (form.querySelector('[name="smsOptIn"]') as HTMLInputElement).checked = Boolean(currentUser.smsOptedIn);
      (form.querySelector('[name="locationAnalyticsOptIn"]') as HTMLInputElement).checked = Boolean(currentUser.locationAnalyticsOptIn);

      // Always pending or on once preferences are known — never leave empty.
      const ready = smsTextEligible();
      statusEl.classList.toggle('is-ready', ready);
      statusEl.classList.toggle('is-pending', !ready);
      statusEl.textContent = ready
        ? `Text alerts are on for ${currentUser.phone}. Enable the Text channel on any alert, then use Send test text or wait for a live match.`
        : 'Add your phone and check the opt-in box below to turn on text alerts.';
      testBtn.disabled = !ready;
    }

    document.getElementById('test-sms-btn')!.addEventListener('click', async () => {
      const status = document.getElementById('preferences-status')!;
      const button = document.getElementById('test-sms-btn') as HTMLButtonElement;
      status.classList.remove('error');
      status.textContent = 'Sending test text...';
      button.disabled = true;
      try {
        const result = await postJson('/api/account/preferences/test-sms', {}, 'POST');
        if (result.simulated) {
          status.textContent = 'Twilio env vars are missing. Add TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, and TWILIO_FROM_NUMBER to .env (or .env.local), then restart npm run dev:netlify.';
        } else if (result.twilioStatus === 'delivered' || result.twilioStatus === 'sent') {
          status.textContent = 'Test text delivered — check your phone.';
        } else if (result.errorCode === 30032) {
          status.classList.add('error');
          status.textContent = 'Twilio accepted the message but delivery was blocked (error 30032): your toll-free number is not verified yet. Complete Toll-Free Verification in the Twilio Console.';
        } else if (result.twilioStatus === 'undelivered' || result.twilioStatus === 'failed') {
          status.classList.add('error');
          status.textContent = result.errorMessage
            ? `Twilio could not deliver the text (${result.errorMessage}).`
            : `Twilio could not deliver the text (status: ${result.twilioStatus || 'unknown'}${result.errorCode ? `, code ${result.errorCode}` : ''}). Check Messaging logs in the Twilio Console.`;
        } else {
          status.textContent = `Twilio accepted the message (status: ${result.twilioStatus || 'queued'}). If nothing arrives in a minute, check Messaging logs in the Twilio Console.`;
        }
      } catch (err: any) {
        status.classList.add('error');
        status.textContent = err.message;
      } finally {
        button.disabled = !smsTextEligible();
      }
    });

    document.getElementById('preferences-form')!.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const status = document.getElementById('preferences-status')!;
      status.classList.remove('error');
      status.textContent = 'Saving...';
      try {
        await postJson('/api/account/preferences', {
          weeklyDigestOptIn: (form.querySelector('[name="weeklyDigestOptIn"]') as HTMLInputElement).checked,
          phone: (form.querySelector('[name="phone"]') as HTMLInputElement).value,
          smsOptIn: (form.querySelector('[name="smsOptIn"]') as HTMLInputElement).checked,
