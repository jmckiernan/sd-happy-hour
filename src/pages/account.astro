    });

    document.getElementById('logout')!.addEventListener('click', async () => {
      await fetch('/api/account/logout', { method: 'POST' });
      currentUser = null;
      render();
      // Sets currentUser directly rather than going through loadAccount(), so
      // the transition check there never sees this one.
      announceAuthChange(false, false);
    });

    watchStuffNav();
    loadAccount();
  </script>
</Layout>
