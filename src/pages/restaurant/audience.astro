---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import MerchantShell from '../../components/MerchantShell.astro';
import { isAdminEmail } from '../../lib/adminIdentity';
import { listMerchantReportVenues } from '../../lib/merchantEntitlements';
import { getSession } from '../../lib/session';
import { getUserById } from '../../lib/store';
import { accountSignInHref } from '../../lib/authRedirect';

const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect(accountSignInHref('/restaurant/audience/'));
const user = await getUserById(session.userId);
if (!user) return Astro.redirect(accountSignInHref('/restaurant/audience/'));

const venues = await listMerchantReportVenues(user.id, isAdminEmail(user.email));
const requestedVenueId = Number(Astro.url.searchParams.get('venueId'));
const selectedVenue = venues.find((venue) => venue.venueId === requestedVenueId) || venues[0] || null;
const publicVenues = venues.map(({ ownerUserId: _ownerUserId, ...venue }) => venue);

const shellRole =
  selectedVenue?.role === 'owner' || selectedVenue?.role === 'site_admin'
    ? 'owner'
    : selectedVenue?.role === 'full_admin'
      ? 'full_admin'
      : null;

const bootstrap = JSON.stringify({
  venues: publicVenues,
  selectedVenueId: selectedVenue?.venueId ?? null,
  email: user.email,
})
  .replace(/</g, '\\u003c');
---
<Layout
  title="Audience | Happy Hour SD"
  description="Current followers, savers, and alert preferences for your restaurant."
  noindex={true}
>
  <style is:global>
    .audience-page {
      margin: 0 auto;
      padding: 28px 24px 0;
    }

    .audience-intro {
      margin: 0 0 22px;
      max-width: none;
    }
    .audience-intro h2 {
      font-family: var(--font-display);
      font-size: 1.35rem;
      margin: 0 0 6px;
    }
    .audience-intro p {
      color: var(--night-soft);
      font-size: 0.9rem;
      line-height: 1.5;
      margin: 0;
      max-width: 640px;
    }

    .audience-status {
      align-items: center;
      color: var(--night-soft);
      display: flex;
      font-weight: 650;
      gap: 10px;
      justify-content: center;
      min-height: 120px;
      padding: 30px;
      text-align: center;
    }
    .audience-status[hidden] { display: none; }

    .audience-content[hidden] { display: none; }

    .audience-metrics {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      margin-bottom: 18px;
    }
    .audience-metric-card {
      background: var(--sand);
      border: 1px solid rgba(32, 18, 56, 0.06);
      border-radius: 14px;
      display: grid;
      gap: 6px;
      min-height: 104px;
      padding: 16px 17px;
    }
    .audience-metric-card .label {
      color: var(--night-soft);
      font-size: 0.72rem;
      font-weight: 850;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .audience-metric-card .value {
      color: var(--night);
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 2.2vw, 1.75rem);
      font-weight: 700;
      line-height: 1.1;
    }
    .audience-metric-card .meta {
      color: var(--night-soft);
      font-size: 0.8rem;
      font-weight: 650;
    }
    .audience-metric-card .meta.is-soon {
      color: var(--ocean-deep);
    }

    .audience-panels {
      display: grid;
      gap: 14px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 14px;
    }
    .audience-panel {
      background: white;
      border: 1px solid rgba(32, 18, 56, 0.07);
      border-radius: 16px;
      padding: 18px 18px 14px;
    }
    .audience-panel h3 {
      font-family: var(--font-display);
      font-size: 1.15rem;
      margin: 0 0 4px;
    }
    .audience-panel .panel-copy {
      color: var(--night-soft);
      font-size: 0.78rem;
      margin: 0 0 14px;
    }
    .audience-split-grid {
      display: grid;
      gap: 10px;
      grid-template-columns: 1fr 1fr;
    }
    .audience-split {
      background: var(--sand);
      border-radius: 12px;
      padding: 12px 13px;
    }
    .audience-split .split-label {
      color: var(--night-soft);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      margin-bottom: 8px;
      text-transform: uppercase;
    }
    .audience-split-row {
      align-items: baseline;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 3px 0;
    }
    .audience-split-row span {
      color: var(--night-soft);
      font-size: 0.8rem;
      font-weight: 650;
    }
    .audience-split-row strong {
      color: var(--night);
      font-size: 0.95rem;
      font-variant-numeric: tabular-nums;
      font-weight: 800;
    }

    .audience-events-panel {
      align-items: start;
      background: var(--sand);
      border: 1px solid rgba(32, 18, 56, 0.06);
      border-radius: 16px;
      display: grid;
      gap: 4px;
      margin-bottom: 14px;
      padding: 16px 18px;
    }
    .audience-events-panel strong {
      color: var(--night);
      font-size: 0.92rem;
    }
    .audience-events-panel p {
      color: var(--night-soft);
      font-size: 0.82rem;
      margin: 0;
    }

    .audience-overlap {
      background: var(--sand-warm);
      border-radius: 13px;
      color: var(--night-soft);
      font-size: 0.78rem;
      line-height: 1.55;
      padding: 14px 16px;
    }

    .audience-paid-gate {
      background: linear-gradient(145deg, #201238, #3e225e);
      border-radius: 18px;
      color: white;
      margin-top: 4px;
      padding: clamp(24px, 4vw, 42px);
      text-align: center;
    }
    .audience-paid-gate[hidden] { display: none; }
    .audience-paid-gate h2 {
      color: white;
      font-family: var(--font-display);
      font-size: 1.85rem;
      margin: 0 0 10px;
    }
    .audience-paid-gate p {
      color: rgba(255, 255, 255, 0.75);
      margin: 0 auto 18px;
      max-width: 560px;
    }
    .audience-paid-actions {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin-bottom: 16px;
    }
    .audience-paid-actions a {
      background: white;
      border-radius: 999px;
      color: var(--night);
      font-size: 0.86rem;
      font-weight: 850;
      padding: 11px 18px;
      text-decoration: none;
    }
    .audience-paid-actions a:hover { background: var(--sand-warm); }
    .audience-access-form {
      display: flex;
      gap: 8px;
      justify-content: center;
      margin: 0 auto;
      max-width: 470px;
    }
    .audience-access-form[hidden] { display: none; }
    .audience-access-form input {
      border: 2px solid transparent;
      border-radius: 999px;
      flex: 1;
      font: inherit;
      font-weight: 750;
      padding: 11px 16px;
      text-transform: uppercase;
    }
    .audience-access-form button {
      background: var(--sunset-start);
      border: 0;
      border-radius: 999px;
      color: white;
      cursor: pointer;
      font: inherit;
      font-size: 0.82rem;
      font-weight: 850;
      padding: 11px 17px;
      white-space: nowrap;
    }
    .audience-access-status {
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.78rem;
      margin-top: 12px;
      min-height: 1em;
    }

    .audience-empty {
      color: var(--night-soft);
      font-size: 0.9rem;
      padding: 28px 8px;
      text-align: center;
    }

    @media (max-width: 980px) {
      .audience-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 720px) {
      .audience-page { padding: 22px 14px 0; }
      .audience-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .audience-panels { grid-template-columns: 1fr; }
      .audience-access-form { flex-direction: column; }
    }
    @media (max-width: 480px) {
      .audience-metrics { grid-template-columns: 1fr; }
      .audience-split-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="audience-page">
    <MerchantShell
      activeTab="audience"
      venueName={selectedVenue?.venueName || 'Audience'}
      venueSlug={selectedVenue?.venueSlug || null}
      venueId={selectedVenue?.venueId ?? null}
      email={user.email}
      role={shellRole}
      verified={Boolean(selectedVenue)}
      publicHref={selectedVenue?.venueSlug ? `/venues/${encodeURIComponent(selectedVenue.venueSlug)}/` : null}
      venues={publicVenues.map((venue) => ({
        id: venue.venueId,
        name: venue.venueName,
        slug: venue.venueSlug,
      }))}
    >
      {venues.length === 0 ? (
        <div class="audience-empty">
          You need a verified owner or full-admin restaurant role before audience is available.
        </div>
      ) : (
        <>
          <div class="audience-intro">
            <h2>Audience now</h2>
            <p>Point-in-time followers, savers, and alert preferences — not a historical report.</p>
          </div>

          <section class="audience-paid-gate" id="audience-paid-gate" hidden>
            <h2>Audience access required</h2>
            <p id="audience-paid-copy">
              Current audience counts are part of paid reporting access. Redeem an access code on Billing, or enter it here if you are the owner.
            </p>
            <div class="audience-paid-actions">
              <a id="audience-billing-link" href="/restaurant/billing/">Go to Billing</a>
            </div>
            <form class="audience-access-form" id="audience-access-form">
              <input
                id="audience-access-code"
                name="code"
                autocomplete="off"
                placeholder="SDHH-XXXX-XXXX-XXXX"
                aria-label="Restaurant access code"
                required
              >
              <button type="submit">Redeem code</button>
            </form>
            <div class="audience-access-status" id="audience-access-status" role="status"></div>
          </section>

          <section class="audience-status" id="audience-status" role="status" aria-live="polite">
            <img class="drink-loader drink-loader--sm" src="/cocktail-loader.svg" alt="" aria-hidden="true">
            <span>Loading audience…</span>
          </section>

          <div class="audience-content" id="audience-content" hidden>
            <section class="audience-metrics" id="audience-metrics" aria-label="Audience totals"></section>

            <div class="audience-panels">
              <section class="audience-panel" id="hh-panel" aria-label="Happy hour alerts"></section>
              <section class="audience-panel" id="live-panel" aria-label="Live deal alerts"></section>
            </div>

            <section class="audience-events-panel" id="events-panel"></section>
            <div class="audience-overlap" id="audience-overlap"></div>
          </div>
        </>
      )}
    </MerchantShell>
  </div>

  <script id="audience-bootstrap" type="application/json" set:html={bootstrap}></script>
  <script>
    import {
      MERCHANT_VENUE_CHANGE_EVENT,
      onMerchantPageLoad,
      prefetchVisibleMerchantTabs,
      replaceMerchantUrl,
    } from '../../lib/merchantShellNav';
    import {
      getMerchantTabCache,
      invalidateMerchantTabCache,
      swrMerchantTabCache,
    } from '../../lib/merchantTabCache';

    interface VenueOption {
      venueId: number;
      venueName: string;
      venueSlug: string;
      neighborhood: string;
      role: string;
      paid: boolean;
    }
    interface Bootstrap {
      venues: VenueOption[];
      selectedVenueId: number | null;
      email: string;
    }
    interface AlertBreakdown {
      total: number;
      byChannel: { email: number; text: number };
      bySource: { venueFollow: number; listSubscription: number };
    }
    interface AudienceDetail {
      generatedAt: string;
      venue: { id: number; name: string; neighborhood: string };
      overlapNote: string;
      happyHourAlerts: AlertBreakdown;
      liveDeals: AlertBreakdown;
      events: { total: number; comingSoon: true; note: string };
      saves: { total: number };
      followers: { total: number };
    }

    // ClientRouter skips already-executed module scripts on soft-nav revisit.
    let pageAbort: AbortController | null = null;

    function startAudiencePage() {
      if (!document.getElementById('audience-bootstrap')) return;

      pageAbort?.abort();
      pageAbort = new AbortController();
      const signal = pageAbort.signal;

      const bootstrap: Bootstrap = JSON.parse(
        document.getElementById('audience-bootstrap')?.textContent || '{"venues":[],"selectedVenueId":null,"email":""}'
      );
      if (!bootstrap.venues.length) {
        // Empty state already rendered server-side.
        return;
      }

      const format = new Intl.NumberFormat('en-US');
      const statusEl = document.getElementById('audience-status')!;
      const contentEl = document.getElementById('audience-content')!;
      const paidGate = document.getElementById('audience-paid-gate')!;
      const paidCopy = document.getElementById('audience-paid-copy')!;
      const accessForm = document.getElementById('audience-access-form') as HTMLFormElement;
      const accessStatus = document.getElementById('audience-access-status')!;
      const billingLink = document.getElementById('audience-billing-link') as HTMLAnchorElement;
      let selectedVenueId = bootstrap.selectedVenueId ?? bootstrap.venues[0].venueId;
      let requestVersion = 0;

      const escapeHTML = (value: unknown) =>
        String(value ?? '').replace(/[&<>"']/g, (char) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[char]
        );

      const selectedVenue = () =>
        bootstrap.venues.find((venue) => venue.venueId === selectedVenueId) || bootstrap.venues[0];

      function shellRoleFor(role: string): 'owner' | 'full_admin' | 'promotions' {
        if (role === 'owner' || role === 'site_admin') return 'owner';
        if (role === 'full_admin') return 'full_admin';
        return 'promotions';
      }

      function tabHref(tab: string, venue: VenueOption): string {
        const id = venue.venueId;
        const slug = venue.venueSlug ? encodeURIComponent(venue.venueSlug) : '';
        switch (tab) {
          case 'promotions':
            return `/restaurant/?venueId=${id}`;
          case 'listing':
            return slug ? `/restaurant/manage/${slug}/?tab=listing` : '#';
          case 'photos':
            return slug ? `/restaurant/manage/${slug}/?tab=photos` : '#';
          case 'menu':
            return slug ? `/restaurant/manage/${slug}/?tab=menu` : '#';
          case 'audience':
            return `/restaurant/audience/?venueId=${id}`;
          case 'reports':
            return `/restaurant/reports/?venueId=${id}`;
          case 'billing':
            return `/restaurant/billing/?venueId=${id}`;
          case 'team':
            return slug ? `/restaurant/manage/${slug}/users/` : '#';
          default:
            return '#';
        }
      }

      function syncMerchantShell(venue: VenueOption): void {
        const shell = document.querySelector<HTMLElement>('[data-merchant-shell]');
        if (!shell) return;
        const nameEl = shell.querySelector('[data-merchant-shell-venue-name]');
        const emailEl = shell.querySelector('[data-merchant-shell-email]');
        const roleEl = shell.querySelector('[data-merchant-shell-role]');
        const roleSep = shell.querySelector<HTMLElement>('[data-merchant-shell-role-sep]');
        const verifiedEl = shell.querySelector<HTMLElement>('[data-merchant-shell-verified]');
        const publicEl = shell.querySelector<HTMLAnchorElement>('[data-merchant-shell-public]');
        const tabsEl = shell.querySelector<HTMLElement>('[data-merchant-shell-tabs]');
        const switcher = shell.querySelector<HTMLSelectElement>('[data-merchant-shell-switcher]');

        if (nameEl) nameEl.textContent = venue.venueName;
        if (emailEl) emailEl.textContent = bootstrap.email || '';
        const role = shellRoleFor(venue.role);
        const roleText = role === 'owner' ? 'Owner' : role === 'full_admin' ? 'Full Admin' : 'Promotions';
        if (roleEl) roleEl.textContent = venue.role === 'site_admin' ? 'Site admin' : roleText;
        if (roleSep) roleSep.hidden = !(roleText && bootstrap.email);
        if (verifiedEl) verifiedEl.hidden = false;
        shell.dataset.venueId = String(venue.venueId);

        if (publicEl) {
          if (venue.venueSlug) {
            publicEl.hidden = false;
            publicEl.href = `/venues/${encodeURIComponent(venue.venueSlug)}/`;
          } else {
            publicEl.hidden = true;
            publicEl.href = '#';
          }
        }

        if (tabsEl) {
          tabsEl.hidden = false;
          for (const tab of tabsEl.querySelectorAll<HTMLAnchorElement>('[data-merchant-shell-tab]')) {
            const tabId = tab.dataset.merchantShellTab || '';
            let visible = true;
            if (role === 'promotions') visible = tabId === 'promotions';
            else if (role === 'full_admin') visible = tabId !== 'team';
            else visible = true;
            tab.hidden = !visible;
            tab.classList.toggle('is-active', tabId === 'audience');
            if (tabId === 'audience') tab.setAttribute('aria-current', 'page');
            else tab.removeAttribute('aria-current');
            const href = tabHref(tabId, venue);
            const needsSlug = tabId === 'listing' || tabId === 'photos' || tabId === 'menu' || tabId === 'team';
            const disabled = needsSlug && !venue.venueSlug;
            tab.href = disabled ? '#' : href;
            if (disabled) tab.setAttribute('aria-disabled', 'true');
            else tab.removeAttribute('aria-disabled');
          }
        }

        if (switcher) {
          if (bootstrap.venues.length > 1) {
            switcher.hidden = false;
            switcher.innerHTML = bootstrap.venues
              .map(
                (entry) => `
              <option value="${entry.venueId}" data-slug="${escapeHTML(entry.venueSlug || '')}" ${entry.venueId === venue.venueId ? 'selected' : ''}>
                ${escapeHTML(entry.venueName)}
              </option>`
              )
              .join('');
          } else {
            switcher.hidden = true;
            switcher.innerHTML = '';
          }
        }
        prefetchVisibleMerchantTabs();
      }

      function status(message: string, loading = false): void {
        statusEl.innerHTML = `${
          loading
            ? '<img class="drink-loader drink-loader--sm" src="/cocktail-loader.svg" alt="" aria-hidden="true">'
            : ''
        }<span>${escapeHTML(message)}</span>`;
        statusEl.hidden = false;
        contentEl.hidden = true;
      }

      function metricCard(label: string, value: number, meta: string, metaClass = ''): string {
        return `<article class="audience-metric-card">
          <span class="label">${escapeHTML(label)}</span>
          <span class="value">${format.format(value)}</span>
          <span class="meta ${metaClass}">${escapeHTML(meta)}</span>
        </article>`;
      }

      function splitBlock(title: string, rows: Array<[string, number]>): string {
        return `<div class="audience-split">
          <div class="split-label">${escapeHTML(title)}</div>
          ${rows
            .map(
              ([label, value]) => `<div class="audience-split-row">
              <span>${escapeHTML(label)}</span>
              <strong>${format.format(value)}</strong>
            </div>`
            )
            .join('')}
        </div>`;
      }

      function alertPanel(title: string, copy: string, data: AlertBreakdown): string {
        return `
          <h3>${escapeHTML(title)}</h3>
          <p class="panel-copy">${escapeHTML(copy)} · ${format.format(data.total)} distinct users</p>
          <div class="audience-split-grid">
            ${splitBlock('By channel', [
              ['Email', data.byChannel.email],
              ['Text', data.byChannel.text],
            ])}
            ${splitBlock('By source', [
              ['Venue follow', data.bySource.venueFollow],
              ['List subscription', data.bySource.listSubscription],
            ])}
          </div>
        `;
      }

      function render(audience: AudienceDetail): void {
        document.getElementById('audience-metrics')!.innerHTML = [
          metricCard(
            'Happy hour alerts',
            audience.happyHourAlerts.total,
            `${format.format(audience.happyHourAlerts.byChannel.email)} email · ${format.format(audience.happyHourAlerts.byChannel.text)} text`
          ),
          metricCard(
            'Live deals',
            audience.liveDeals.total,
            `${format.format(audience.liveDeals.byChannel.email)} email · ${format.format(audience.liveDeals.byChannel.text)} text`
          ),
          metricCard('Events', audience.events.total, audience.events.note, 'is-soon'),
          metricCard('Saves', audience.saves.total, 'On a happy hour list'),
          metricCard('Followers', audience.followers.total, 'Venue follow rows'),
        ].join('');

        document.getElementById('hh-panel')!.innerHTML = alertPanel(
          'Happy hour alerts',
          'Users notified for happy hour at this venue',
          audience.happyHourAlerts
        );
        document.getElementById('live-panel')!.innerHTML = alertPanel(
          'Live deals',
          'Users notified for live / special deals',
          audience.liveDeals
        );
        document.getElementById('events-panel')!.innerHTML = `
          <strong>Events · ${format.format(audience.events.total)}</strong>
          <p>${escapeHTML(audience.events.note)}. Event alert preferences are reserved and will light up when Events ships.</p>
        `;
        document.getElementById('audience-overlap')!.textContent = audience.overlapNote;

        statusEl.hidden = true;
        contentEl.hidden = false;
      }

      async function loadAudience(): Promise<void> {
        const version = ++requestVersion;
        const venue = selectedVenue();
        selectedVenueId = venue.venueId;
        replaceMerchantUrl(`/restaurant/audience/?venueId=${selectedVenueId}`);
        syncMerchantShell(venue);
        billingLink.href = `/restaurant/billing/?venueId=${selectedVenueId}`;

        if (!venue.paid) {
          const canRedeem = venue.role === 'owner';
          accessForm.hidden = !canRedeem;
          accessStatus.textContent = canRedeem
            ? ''
            : 'Ask the restaurant owner to activate reporting access, or open Billing for plan details.';
          paidCopy.textContent = canRedeem
            ? 'Current audience counts are part of paid reporting access. Redeem an access code on Billing, or enter it here.'
            : 'Current audience counts are part of paid reporting access. Ask the restaurant owner to unlock access.';
          paidGate.hidden = false;
          statusEl.hidden = true;
          contentEl.hidden = true;
          return;
        }

        paidGate.hidden = true;
        const cached = getMerchantTabCache<AudienceDetail>(selectedVenueId, 'audience');
        if (cached) {
          render(cached.data);
        } else {
          status('Loading audience…', true);
        }

        try {
          await swrMerchantTabCache<AudienceDetail>({
            venueId: selectedVenueId,
            resource: 'audience',
            signal,
            fetcher: async () => {
              const response = await fetch(
                `/api/restaurant/audience?venueId=${encodeURIComponent(selectedVenueId)}`,
                { cache: 'no-store', credentials: 'same-origin', signal }
              );
              const data = await response.json();
              if (response.status === 402 || data.code === 'paid_required') {
                const err = new Error('paid_required') as Error & {
                  code?: string;
                  venues?: VenueOption[];
                };
                err.code = 'paid_required';
                err.venues = Array.isArray(data.venues) ? data.venues : undefined;
                throw err;
              }
              if (!response.ok) throw new Error((data.errors || ['Could not load audience.']).join(' '));
              return data.audience as AudienceDetail;
            },
            onFresh: (audience, { changed, fromCache }) => {
              if (signal.aborted || version !== requestVersion) return;
              if (!fromCache || changed) render(audience);
            },
          });
        } catch (error) {
          if (signal.aborted || version !== requestVersion) return;
          const paidErr = error as Error & { code?: string; venues?: VenueOption[] };
          if (paidErr?.code === 'paid_required') {
            invalidateMerchantTabCache(selectedVenueId, 'audience');
            venue.paid = false;
            if (Array.isArray(paidErr.venues)) {
              for (const item of paidErr.venues) {
                const match = bootstrap.venues.find((entry) => entry.venueId === item.venueId);
                if (match) match.paid = Boolean(item.paid);
              }
            }
            void loadAudience();
            return;
          }
          if (cached) return;
          status(error instanceof Error ? error.message : 'Could not load audience.');
        }
      }

      document.addEventListener('astro:before-swap', () => pageAbort?.abort(), { once: true });

      window.addEventListener(MERCHANT_VENUE_CHANGE_EVENT, ((event: CustomEvent<{ venueId?: number | null }>) => {
        const next = Number(event.detail?.venueId);
        if (!Number.isSafeInteger(next) || next <= 0) return;
        selectedVenueId = next;
        void loadAudience();
      }) as EventListener, { signal });

      accessForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        accessStatus.textContent = 'Checking code…';
        try {
          const response = await fetch('/api/restaurant/reports/redeem', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              venueId: selectedVenueId,
              code: (document.getElementById('audience-access-code') as HTMLInputElement).value,
            }),
          });
          const data = await response.json();
          if (!response.ok) throw new Error((data.errors || ['Could not redeem code.']).join(' '));
          selectedVenue().paid = true;
          invalidateMerchantTabCache(selectedVenueId, 'audience');
          invalidateMerchantTabCache(selectedVenueId, 'reports');
          invalidateMerchantTabCache(selectedVenueId, 'billing');
          accessStatus.textContent = 'Access unlocked. Loading audience…';
          void loadAudience();
        } catch (error) {
          accessStatus.textContent = error instanceof Error ? error.message : 'Could not redeem code.';
        }
      }, { signal });

      void loadAudience();
    }

    onMerchantPageLoad(startAudiencePage);
  </script>
</Layout>
