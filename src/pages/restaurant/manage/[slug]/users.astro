---
export const prerender = true;
import Layout from '../../../../layouts/Layout.astro';
import { getVenues, slugify } from '../../../../lib/venues';

export function getStaticPaths() {
  return getVenues().map((venue) => ({ params: { slug: slugify(venue.name) }, props: { venue } }));
}
const { venue } = Astro.props;
---
<Layout title={`Managing Users — ${venue.name} | SD Happy Hours`} description="Manage restaurant dashboard access.">
  <style>
    .mu-wrap { max-width: 820px; margin: 0 auto; padding: 32px 24px 80px; }
    .mu-back { color: var(--night-soft); display: inline-block; font-size: .88rem; font-weight: 700; margin-bottom: 18px; text-decoration: none; }
    .mu-wrap h1 { font-family: var(--font-display); font-size: 1.8rem; margin: 0 0 6px; }
    .mu-sub { color: var(--night-soft); line-height: 1.5; margin: 0 0 22px; }
    .mu-panel { background: white; border-radius: var(--radius); box-shadow: 0 8px 24px rgba(0,0,0,.06); margin-bottom: 18px; padding: 22px; }
    .mu-panel h2 { font-size: 1.15rem; margin: 0 0 8px; }
    .mu-hint, .mu-status { color: var(--night-soft); font-size: .85rem; line-height: 1.5; }
    .mu-status { min-height: 1.4em; margin-top: 10px; }
    .mu-status.error { color: #991b1b; }
    .mu-status.ok { color: #166534; }
    .mu-search-row { display: grid; gap: 10px; grid-template-columns: minmax(0,1fr) 180px; margin-top: 16px; }
    .mu-wrap input, .mu-wrap select { border: 2px solid var(--sand-warm); border-radius: var(--radius-sm); color: var(--night); font: inherit; min-height: 46px; padding: 10px 12px; width: 100%; }
    .mu-results, .mu-list { display: grid; gap: 9px; margin-top: 12px; }
    .mu-result, .mu-person { align-items: center; border: 1px solid var(--sand-warm); border-radius: var(--radius-sm); display: flex; gap: 12px; justify-content: space-between; padding: 12px; }
    .mu-person-copy { min-width: 0; }
    .mu-person-copy strong, .mu-person-copy span { display: block; overflow-wrap: anywhere; }
    .mu-person-copy span { color: var(--night-soft); font-size: .8rem; margin-top: 3px; }
    .mu-actions { align-items: center; display: flex; flex-wrap: wrap; gap: 7px; }
    .mu-actions select { min-height: 40px; width: auto; }
    .mu-btn { background: var(--night); border: 0; border-radius: 100px; color: white; cursor: pointer; font: inherit; font-size: .84rem; font-weight: 750; min-height: 40px; padding: 9px 15px; }
    .mu-btn.secondary { background: var(--sand-warm); color: var(--night); }
    .mu-btn.danger { background: #fee2e2; color: #991b1b; }
    .mu-btn:disabled { cursor: not-allowed; opacity: .55; }
    .mu-owner { background: #fff7ed; border-color: #fdba74; }
    .mu-empty { color: var(--night-soft); font-size: .86rem; margin: 0; }
    [hidden] { display: none !important; }
    @media (max-width: 620px) {
      .mu-search-row { grid-template-columns: 1fr; }
      .mu-result, .mu-person { align-items: stretch; display: grid; }
      .mu-actions { display: grid; grid-template-columns: 1fr; }
      .mu-actions select, .mu-actions .mu-btn { width: 100%; }
    }
  </style>

  <main class="mu-wrap" data-venue-id={venue.id} data-venue-name={venue.name}>
    <a class="mu-back" href="/restaurant/">← Restaurant dashboard</a>
    <h1>Managing Users</h1>
    <p class="mu-sub">{venue.name} · Only the owner can add, remove, or change managing users.</p>

    <section class="mu-panel" aria-labelledby="mu-add-title">
      <h2 id="mu-add-title">Add a managing user</h2>
      <p class="mu-hint">Search by at least three letters of a name, or enter a complete email address. If the email has no account yet, an invitation will be sent.</p>
      <div class="mu-search-row">
        <input id="mu-search" type="search" placeholder="Name or complete email" autocomplete="off" aria-label="Search users">
        <select id="mu-new-role" aria-label="Access level">
          <option value="full_admin">Full Admin</option>
          <option value="promotions">Promotions Only</option>
        </select>
      </div>
      <div class="mu-results" id="mu-results"></div>
      <div class="mu-status" id="mu-add-status" role="status" aria-live="polite"></div>
    </section>

    <section class="mu-panel" aria-labelledby="mu-current-title">
      <h2 id="mu-current-title">Current access</h2>
      <div class="mu-list" id="mu-current"><p class="mu-empty">Loading managing users…</p></div>
      <div class="mu-status" id="mu-list-status" role="status" aria-live="polite"></div>
    </section>
  </main>

  <script>
    const root = document.querySelector<HTMLElement>('.mu-wrap')!;
    const venueId = Number(root.dataset.venueId);
    const search = document.getElementById('mu-search') as HTMLInputElement;
    const newRole = document.getElementById('mu-new-role') as HTMLSelectElement;
    const results = document.getElementById('mu-results')!;
    const current = document.getElementById('mu-current')!;
    const addStatus = document.getElementById('mu-add-status')!;
    const listStatus = document.getElementById('mu-list-status')!;
    let searchTimer = 0;
    let searchVersion = 0;

    function escapeHTML(value: unknown) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string,string>)[char]);
    }
    function setStatus(el: HTMLElement, message: string, kind: '' | 'ok' | 'error' = '') {
      el.className = `mu-status${kind ? ` ${kind}` : ''}`;
      el.textContent = message;
    }
    async function api(path: string, options: RequestInit = {}) {
      const headers = new Headers(options.headers || {});
      headers.set('Accept', 'application/json');
      if (options.body) headers.set('Content-Type', 'application/json');
      const response = await fetch(path, { ...options, headers, credentials: 'same-origin', cache: 'no-store' });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error((data.errors || ['Something went wrong.']).join(' '));
      return data;
    }
    function roleOptions(selected: string) {
      return `<option value="full_admin"${selected === 'full_admin' ? ' selected' : ''}>Full Admin</option><option value="promotions"${selected === 'promotions' ? ' selected' : ''}>Promotions Only</option>`;
    }
    async function load() {
      try {
        const data = await api(`/api/restaurant/venues/${venueId}/managers`);
        const rows = [
          `<div class="mu-person mu-owner"><div class="mu-person-copy"><strong>${escapeHTML(data.owner?.name || 'Restaurant owner')}</strong><span>${escapeHTML(data.owner?.email || '')}</span></div><strong>Owner</strong></div>`,
          ...data.managers.map((person: any) => `<div class="mu-person" data-kind="manager" data-id="${escapeHTML(person.id)}"><div class="mu-person-copy"><strong>${escapeHTML(person.name || person.email)}</strong><span>${escapeHTML(person.email)}</span></div><div class="mu-actions"><select aria-label="Role for ${escapeHTML(person.name || person.email)}">${roleOptions(person.role)}</select><button class="mu-btn danger" data-action="remove">Remove</button></div></div>`),
          ...data.invites.map((invite: any) => `<div class="mu-person" data-kind="invite" data-id="${escapeHTML(invite.id)}" data-email="${escapeHTML(invite.email)}"><div class="mu-person-copy"><strong>${escapeHTML(invite.email)}</strong><span>Invitation pending · expires ${escapeHTML(new Date(invite.expiresAt).toLocaleDateString())}</span></div><div class="mu-actions"><select aria-label="Role for ${escapeHTML(invite.email)}">${roleOptions(invite.role)}</select><button class="mu-btn secondary" data-action="resend">Resend</button><button class="mu-btn danger" data-action="remove">Revoke</button></div></div>`),
        ];
        current.innerHTML = rows.join('');
      } catch (error: any) {
        current.innerHTML = '';
        setStatus(listStatus, error.message, 'error');
      }
    }
    async function add(input: { userId?: string; email?: string; role?: string }) {
      setStatus(addStatus, input.userId ? 'Adding user…' : 'Sending invitation…');
      try {
        const data = await api(`/api/restaurant/venues/${venueId}/managers`, { method: 'POST', body: JSON.stringify({ ...input, role: input.role || newRole.value }) });
        setStatus(addStatus, data.kind === 'invite'
          ? data.email?.simulated ? 'Invitation created. Email delivery is currently simulated.' : 'Invitation sent.'
          : 'Managing user added.', 'ok');
        search.value = '';
        results.innerHTML = '';
        await load();
      } catch (error: any) { setStatus(addStatus, error.message, 'error'); }
    }
    async function runSearch() {
      const query = search.value.trim();
      const isEmail = query.includes('@');
      const completeEmail = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(query);
      if ((!isEmail && query.length < 3) || (isEmail && !completeEmail)) { results.innerHTML = ''; return; }
      const version = ++searchVersion;
      try {
        const data = await api(`/api/restaurant/venues/${venueId}/manager-search?q=${encodeURIComponent(query)}`);
        if (version !== searchVersion) return;
        if (data.results.length) {
          results.innerHTML = data.results.map((user: any) => `<div class="mu-result"><div class="mu-person-copy"><strong>${escapeHTML(user.name || user.email)}</strong><span>${escapeHTML(user.email)}</span></div><button class="mu-btn" data-add-user="${escapeHTML(user.id)}" data-email="${escapeHTML(data.exactEmail ? user.email : '')}">Add</button></div>`).join('');
        } else if (completeEmail) {
          results.innerHTML = `<div class="mu-result"><div class="mu-person-copy"><strong>${escapeHTML(query.toLowerCase())}</strong><span>No account yet — send a 7-day invitation</span></div><button class="mu-btn" data-invite-email="${escapeHTML(query.toLowerCase())}">Send Invite</button></div>`;
        } else results.innerHTML = '<p class="mu-empty">No matching users.</p>';
      } catch (error: any) { setStatus(addStatus, error.message, 'error'); }
    }
    search.addEventListener('input', () => { window.clearTimeout(searchTimer); searchTimer = window.setTimeout(runSearch, 250); });
    results.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!button) return;
      if (button.dataset.addUser) void add({ userId: button.dataset.addUser });
      else if (button.dataset.inviteEmail) void add({ email: button.dataset.inviteEmail });
    });
    current.addEventListener('change', async (event) => {
      const select = (event.target as HTMLElement).closest<HTMLSelectElement>('select');
      const row = select?.closest<HTMLElement>('[data-id]');
      if (!select || !row) return;
      try {
        await api(`/api/restaurant/venues/${venueId}/managers`, { method: 'PATCH', body: JSON.stringify({ id: row.dataset.id, kind: row.dataset.kind, role: select.value }) });
        setStatus(listStatus, 'Access updated.', 'ok');
      } catch (error: any) { setStatus(listStatus, error.message, 'error'); await load(); }
    });
    current.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
      const row = button?.closest<HTMLElement>('[data-id]');
      if (!button || !row) return;
      if (button.dataset.action === 'resend') {
        await add({ email: row.dataset.email || '', role: row.querySelector('select')?.value });
        return;
      }
      if (!confirm(row.dataset.kind === 'invite' ? 'Revoke this invitation?' : 'Remove this managing user?')) return;
      try {
        await api(`/api/restaurant/venues/${venueId}/managers`, { method: 'DELETE', body: JSON.stringify({ id: row.dataset.id, kind: row.dataset.kind }) });
        setStatus(listStatus, row.dataset.kind === 'invite' ? 'Invitation revoked.' : 'Managing user removed.', 'ok');
        await load();
      } catch (error: any) { setStatus(listStatus, error.message, 'error'); }
    });
    void load();
  </script>
</Layout>
