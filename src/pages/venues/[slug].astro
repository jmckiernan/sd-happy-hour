---
export const prerender = true;
import VenueHappyHourPage from '../../components/VenueHappyHourPage.astro';
import VenueStubPage from '../../components/VenueStubPage.astro';
import { getVenues, venueSlug, hasSchedule } from '../../lib/venues';

// Every venue we know about gets a page, including the ones we carry only so
// an owner can find and claim them. Those have no happy hour to render, so
// they get a much smaller page instead of the full listing.
export async function getStaticPaths() {
  const venues = getVenues();
  return venues.map((venue) => ({
    params: { slug: venueSlug(venue) },
    props: { venue },
  }));
}

const { venue } = Astro.props;
---

{hasSchedule(venue)
  ? <VenueHappyHourPage venue={venue} />
  : <VenueStubPage venue={venue} />}
