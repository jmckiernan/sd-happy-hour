---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---
<Layout title="API Costs | Happy Hour SD Admin" description="Monitor API usage and costs across AI, email, SMS, and all services.">
  <style is:global>
    .ai-costs { max-width: 1200px; margin: 0 auto; padding: 0 24px 80px; }
    .ai-header { background: white; border-bottom: 1px solid rgba(15,23,42,.08); padding: 20px 24px 14px; position: sticky; top: 0; z-index: 5; }
    .ai-header-inner { max-width: 1200px; margin: auto; display: flex; justify-content: space-between; gap: 18px; align-items: center; flex-wrap: wrap; }
    .ai-header h1 { font-family: var(--font-display); font-size: 1.5rem; margin: 0; }
    .ai-header p { color: var(--night-soft); font-size: .86rem; }
    .ai-nav { max-width: 1200px; margin: 12px auto 0; display: flex; gap: 7px; flex-wrap: wrap; font-size: .82rem; }
    .ai-nav a { text-decoration: none; font-weight: 650; color: var(--night-soft); padding: 6px 12px; border-radius: 999px; background: var(--sand-warm); }
    .ai-nav a[aria-current="page"] { background: var(--night); color: white; }
    .ai-actions { display: flex; gap: 8px; align-items: center; }
    .ai-actions button { border: 0; border-radius: 999px; padding: 10px 16px; background: var(--sand-warm); color: var(--night); font: inherit; font-weight: 750; cursor: pointer; }
    .ai-status { margin: 20px 0 12px; color: var(--night-soft); font-weight: 650; min-height: 1.5em; }
    
    .ai-totals { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin: 20px 0; }
    .ai-total { background: white; border-radius: 14px; box-shadow: 0 2px 10px rgba(15,23,42,.05); padding: 18px; }
    .ai-total-value { font-size: 2rem; font-weight: 800; color: var(--night); }
    .ai-total-value.cost { color: #059669; }
    .ai-total-label { color: var(--night-soft); font-size: .82rem; margin-top: 4px; }
    
    .ai-section { background: white; border-radius: 14px; box-shadow: 0 2px 10px rgba(15,23,42,.05); padding: 20px; margin-bottom: 20px; }
    .ai-section h2 { font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 16px; }
    
    .ai-chart { height: 200px; display: flex; align-items: flex-end; gap: 4px; padding: 10px 0; }
    .ai-bar { flex: 1; background: linear-gradient(to top, #3B82F6, #60A5FA); border-radius: 4px 4px 0 0; min-height: 4px; position: relative; cursor: pointer; transition: opacity .15s; }
    .ai-bar:hover { opacity: .8; }
    .ai-bar-tooltip { display: none; position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); background: var(--night); color: white; font-size: .72rem; padding: 4px 8px; border-radius: 6px; white-space: nowrap; margin-bottom: 6px; z-index: 10; }
    .ai-bar:hover .ai-bar-tooltip { display: block; }
    .ai-chart-labels { display: flex; justify-content: space-between; font-size: .72rem; color: var(--night-soft); margin-top: 8px; }
    
    .ai-breakdown { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
    .ai-breakdown-list { list-style: none; padding: 0; margin: 0; }
    .ai-breakdown-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(15,23,42,.06); }
    .ai-breakdown-item:last-child { border-bottom: none; }
    .ai-breakdown-name { font-weight: 600; }
    .ai-breakdown-stats { display: flex; gap: 16px; font-size: .82rem; color: var(--night-soft); }
    .ai-breakdown-cost { font-weight: 700; color: #059669; }
    
    .ai-table { width: 100%; border-collapse: collapse; font-size: .82rem; margin-top: 12px; }
    .ai-table th, .ai-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid rgba(15,23,42,.06); }
    .ai-table th { font-weight: 700; color: var(--night-soft); font-size: .75rem; text-transform: uppercase; letter-spacing: .03em; }
    .ai-table tr:hover td { background: rgba(15,23,42,.02); }
    .ai-pill { display: inline-block; padding: 3px 8px; border-radius: 999px; font-size: .72rem; font-weight: 700; }
    .ai-pill.success { background: #DCFCE7; color: #166534; }
    .ai-pill.error { background: #FEE2E2; color: #991B1B; }
    .ai-pill.provider-anthropic { background: #FDF4FF; color: #86198F; }
    .ai-pill.provider-gemini { background: #EFF6FF; color: #1D4ED8; }
    .ai-pill.provider-openai { background: #F0FDF4; color: #166534; }
    .ai-pill.provider-resend { background: #FEF3C7; color: #92400E; }
    .ai-pill.provider-twilio { background: #FEE2E2; color: #991B1B; }
    .ai-pill.provider-google_places { background: #DBEAFE; color: #1E40AF; }
    
    .ai-empty { color: var(--night-soft); padding: 40px 20px; text-align: center; }
    .ai-locked { text-align: center; padding: 70px 20px; }
    
    @media(max-width:720px) { .ai-header { position: relative; } .ai-table { display: block; overflow-x: auto; } }
  </style>

  <div id="ai-locked" class="ai-locked" hidden>
    <h1>API Costs Dashboard</h1>
    <p>Authorized admin sign-in is required.</p>
    <a class="ai-actions button" href="/account/?next=%2Fadmin%2Fai-costs%2F" style="display:inline-block;text-decoration:none;border-radius:999px;padding:10px 16px;background:var(--night);color:white;font-weight:750;margin-top:12px;">Sign in</a>
  </div>

  <div id="ai-app" hidden>
    <header class="ai-header">
      <div class="ai-header-inner">
        <div>
          <h1>API Costs Dashboard</h1>
          <p>Monitor usage and costs across AI (Anthropic, Gemini), email (Resend), SMS (Twilio), and all services.</p>
        </div>
        <div class="ai-actions">
          <span id="ai-user" style="color:var(--night-soft);font-size:.82rem;"></span>
          <button id="ai-refresh">Refresh</button>
        </div>
      </div>
      <nav class="ai-nav">
        <a href="/admin/">Submissions</a>
        <a href="/admin/users/">Users</a>
        <a href="/admin/analytics/">Analytics</a>
        <a href="/admin/restaurants/">Restaurant Verifications</a>
        <a href="/admin/photos/">Photo Review</a>
        <a href="/admin/drafts/">Posts</a>
        <a href="/admin/content-engine/">Content Engine</a>
        <a href="/admin/ai-costs/" aria-current="page">AI Costs</a>
      </nav>
    </header>

    <main class="ai-costs">
      <div id="ai-status" class="ai-status" aria-live="polite">Loading AI costs…</div>
      
      <section id="ai-totals" class="ai-totals"></section>
      
      <section class="ai-section">
        <h2>Daily Costs (Last 30 Days)</h2>
        <div id="ai-chart" class="ai-chart"></div>
        <div id="ai-chart-labels" class="ai-chart-labels"></div>
      </section>
      
      <div class="ai-breakdown">
        <section class="ai-section">
          <h2>By Provider</h2>
          <ul id="ai-by-provider" class="ai-breakdown-list"></ul>
        </section>
        <section class="ai-section">
          <h2>By Feature</h2>
          <ul id="ai-by-feature" class="ai-breakdown-list"></ul>
        </section>
        <section class="ai-section">
          <h2>By Model</h2>
          <ul id="ai-by-model" class="ai-breakdown-list"></ul>
        </section>
      </div>
      
      <section class="ai-section">
        <h2>Recent API Calls</h2>
        <div id="ai-recent"></div>
      </section>
    </main>
  </div>

  <script>
    interface DailyCost { day: string; costCents: number; calls: number; }
    interface BreakdownItem { provider?: string; feature?: string; model?: string; costCents: number; calls: number; }
    interface RecentCall {
      id: string; provider: string; model: string; feature: string;
      costCents: number; inputTokens: number | null; outputTokens: number | null;
      imageCount: number | null; messageCount: number | null; success: boolean; createdAt: string;
    }
    interface CostSummary {
      totalCostCents: number; totalCalls: number;
      byProvider: BreakdownItem[]; byFeature: BreakdownItem[]; byModel: BreakdownItem[];
      recentCalls: RecentCall[];
    }
    interface CostData { summary: CostSummary; dailyCosts: DailyCost[]; }

    let data: CostData | null = null;
    const $ = (id: string) => document.getElementById(id)!;
    const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'} as any)[c]);
    const formatCost = (cents: number) => cents < 100 ? `${cents.toFixed(2)}¢` : `$${(cents / 100).toFixed(2)}`;
    const formatDate = (iso: string) => new Date(iso).toLocaleString('en-US', { timeZone: 'America/Los_Angeles', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    const formatFeature = (f: string) => f.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    
    function setStatus(msg: string) { $('ai-status').textContent = msg; }
    
    async function api(path: string) {
      const res = await fetch(path, { headers: { 'cache-control': 'no-cache' } });
      const json = await res.json();
      if (!res.ok) throw new Error((json.errors || [json.error || 'Request failed.']).join('\n'));
      return json;
    }
    
    function renderTotals() {
      const s = data!.summary;
      $('ai-totals').innerHTML = `
        <div class="ai-total"><div class="ai-total-value cost">${formatCost(s.totalCostCents)}</div><div class="ai-total-label">Total spend (30 days)</div></div>
        <div class="ai-total"><div class="ai-total-value">${s.totalCalls.toLocaleString()}</div><div class="ai-total-label">API calls</div></div>
        <div class="ai-total"><div class="ai-total-value">${s.byProvider.length}</div><div class="ai-total-label">Active providers</div></div>
        <div class="ai-total"><div class="ai-total-value">${s.byFeature.length}</div><div class="ai-total-label">Features tracked</div></div>
      `;
    }
    
    function renderChart() {
      const daily = data!.dailyCosts;
      if (!daily.length) {
        $('ai-chart').innerHTML = '<p class="ai-empty">No usage data yet.</p>';
        $('ai-chart-labels').innerHTML = '';
        return;
      }
      const maxCost = Math.max(...daily.map(d => d.costCents), 1);
      $('ai-chart').innerHTML = daily.map(d => {
        const height = Math.max((d.costCents / maxCost) * 100, 2);
        const dayLabel = new Date(d.day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        return `<div class="ai-bar" style="height:${height}%"><div class="ai-bar-tooltip">${dayLabel}: ${formatCost(d.costCents)} (${d.calls} calls)</div></div>`;
      }).join('');
      const first = new Date(daily[0].day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      const last = new Date(daily[daily.length - 1].day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      $('ai-chart-labels').innerHTML = `<span>${first}</span><span>${last}</span>`;
    }
    
    function renderBreakdown(items: BreakdownItem[], nameKey: 'provider' | 'feature' | 'model') {
      if (!items.length) return '<li class="ai-empty" style="padding:20px 0;">No data yet.</li>';
      return items.map(item => {
        const name = (item as any)[nameKey] || 'Unknown';
        const displayName = nameKey === 'feature' ? formatFeature(name) : name;
        const providerClass = nameKey === 'provider' ? ` ai-pill provider-${name}` : '';
        return `<li class="ai-breakdown-item">
          <span class="ai-breakdown-name">${nameKey === 'provider' ? `<span class="ai-pill${providerClass}">${esc(displayName)}</span>` : esc(displayName)}</span>
          <span class="ai-breakdown-stats">
            <span>${item.calls.toLocaleString()} calls</span>
            <span class="ai-breakdown-cost">${formatCost(item.costCents)}</span>
          </span>
        </li>`;
      }).join('');
    }
    
    function renderRecent() {
      const calls = data!.summary.recentCalls;
      if (!calls.length) {
        $('ai-recent').innerHTML = '<p class="ai-empty">No API calls recorded yet.</p>';
        return;
      }
      $('ai-recent').innerHTML = `
        <table class="ai-table">
          <thead><tr><th>Time</th><th>Provider</th><th>Model</th><th>Feature</th><th>Tokens</th><th>Cost</th><th>Status</th></tr></thead>
          <tbody>${calls.map(c => `
            <tr>
              <td>${formatDate(c.createdAt)}</td>
              <td><span class="ai-pill provider-${c.provider}">${esc(c.provider)}</span></td>
              <td style="font-family:monospace;font-size:.75rem;">${esc(c.model)}</td>
              <td>${formatFeature(c.feature)}</td>
              <td>${c.inputTokens || c.outputTokens ? `${(c.inputTokens || 0).toLocaleString()} / ${(c.outputTokens || 0).toLocaleString()}` : c.imageCount ? `${c.imageCount} img` : c.messageCount ? `${c.messageCount} msg` : '—'}</td>
              <td style="font-weight:600;color:#059669;">${formatCost(c.costCents)}</td>
              <td><span class="ai-pill ${c.success ? 'success' : 'error'}">${c.success ? 'OK' : 'Error'}</span></td>
            </tr>
          `).join('')}</tbody>
        </table>
      `;
    }
    
    function render() {
      renderTotals();
      renderChart();
      $('ai-by-provider').innerHTML = renderBreakdown(data!.summary.byProvider, 'provider');
      $('ai-by-feature').innerHTML = renderBreakdown(data!.summary.byFeature, 'feature');
      $('ai-by-model').innerHTML = renderBreakdown(data!.summary.byModel, 'model');
      renderRecent();
    }
    
    async function load() {
      setStatus('Loading API costs…');
      try {
        data = await api('/api/admin/ai-costs');
        render();
        setStatus('Last 30 days of API usage. Costs are estimates based on current pricing.');
      } catch (err: any) {
        setStatus(err.message);
      }
    }
    
    $('ai-refresh').addEventListener('click', () => load());
    
    (async () => {
      try {
        const session = await api('/api/admin/me');
        if (!session.authenticated) { $('ai-locked').hidden = false; return; }
        $('ai-user').textContent = session.email;
        $('ai-app').hidden = false;
        await load();
      } catch { $('ai-locked').hidden = false; }
    })();
  </script>
</Layout>
