---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';

const posthogWebAnalyticsUrl = 'https://us.posthog.com/project/575257/web';
const posthogBlogDashboardUrl = 'https://us.posthog.com/project/575257/dashboard/2028794';
const searchConsoleUrl = 'https://search.google.com/search-console/performance/search-analytics?resource_id=sc-domain%3Ahappyhoursd.com';
const richResultsUrl = 'https://search.google.com/test/rich-results?url=https%3A%2F%2Fhappyhoursd.com%2F';
const pageSpeedUrl = 'https://pagespeed.web.dev/analysis?url=https%3A%2F%2Fhappyhoursd.com%2F';
const bingWebmasterUrl = 'https://www.bing.com/webmasters/about';
const ahrefsUrl = 'https://ahrefs.com/webmaster-tools';
---
<Layout title="Analytics & SEO | Happy Hour SD Admin" description="Open the reporting tools for Happy Hour SD.">
  <style is:global>
    .admin-bar {
      background: white; border-bottom: 1px solid rgba(15,23,42,0.08);
      padding: 20px 24px; position: sticky; top: 0; z-index: 5;
    }
    .admin-bar-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; align-items: center; flex-wrap: wrap; }
    .admin-bar h1 { font-family: var(--font-display); font-size: 1.4rem; margin-bottom: 2px; }
    .admin-bar p { color: var(--night-soft); font-size: 0.85rem; max-width: 760px; line-height: 1.5; }
    .admin-actions { display: flex; gap: 8px; align-items: center; }
    .admin-user { color: var(--night-soft); font-size: 0.85rem; font-weight: 700; }
    button.secondary {
      background: var(--sand-warm); border: 0; border-radius: 100px; color: var(--night);
      cursor: pointer; font: inherit; font-weight: 700; padding: 9px 16px;
    }
    button.secondary:hover { background: var(--sunset-end); }

    .admin-subnav { display: flex; gap: 8px; max-width: 1100px; margin: 12px auto 0; padding: 0 24px; font-size: 0.85rem; flex-wrap: wrap; }
    .admin-subnav a {
      text-decoration: none; font-weight: 600; color: var(--night-soft);
      padding: 6px 14px; border-radius: 100px; background: var(--sand-warm);
    }
    .admin-subnav a:hover { background: var(--sunset-end); color: var(--night); }
    .admin-subnav a[aria-current="page"] { background: var(--night); color: white; }

    .admin-main { max-width: 1100px; margin: 0 auto; padding: 24px 24px 80px; }
    .tool-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
    .tool-card { background:white; border:1px solid rgba(15,23,42,.1); border-radius:22px; padding:22px; }
    .tool-card h2 { font-family:var(--font-display); font-size:1.35rem; margin-bottom:7px; }
    .tool-card p { color:var(--night-soft); line-height:1.55; margin-bottom:14px; }
    .actions { display:flex; gap:8px; flex-wrap:wrap; }
    .action { display:inline-flex; text-decoration:none; border-radius:100px; padding:10px 16px; background:var(--night); color:white; font-weight:750; }
    .action.secondary { background:var(--sand-warm); color:var(--night); }
    .event-list { margin:28px 0 0; background:white; border:1px solid rgba(15,23,42,.1); border-radius:22px; padding:22px; }
    .event-list h2 { font-family:var(--font-display); font-size:1.3rem; margin-bottom:10px; }
    .event-list ul { columns:2; padding-left:20px; color:var(--night-soft); line-height:1.8; }
    .notice { margin-top:18px; color:var(--night-soft); font-size:.88rem; }
    @media (max-width:700px) { .tool-grid { grid-template-columns:1fr; } .event-list ul { columns:1; } }
  </style>

  <div class="admin-bar">
    <div class="admin-bar-inner">
      <div>
        <h1>Analytics &amp; SEO</h1>
        <p>PostHog explains what readers do after reaching the site. Google Search Console explains which Google searches showed or sent readers to each page.</p>
      </div>
      <div class="admin-actions">
        <span class="admin-user" id="admin-user"></span>
        <button class="secondary" id="logout">Log out</button>
      </div>
    </div>
    <nav class="admin-subnav" aria-label="Admin sections">
      <a href="/admin/">Submissions</a>
      <a href="/admin/users/">Users</a>
      <a href="/admin/analytics/" aria-current="page">Analytics</a>
      <a href="/admin/venues/">Venues</a>
      <a href="/admin/photos/">Photo Review</a>
      <a href="/admin/drafts/">Posts</a>
      <a href="/admin/new-post/">Add Blog Post</a>
      <a href="/admin/content-engine/">Content Engine</a>
      <a href="/admin/ai-costs/">AI Costs</a>
    </nav>
  </div>

  <main class="admin-main">
    <div class="tool-grid">
      <section class="tool-card">
        <h2>PostHog Web Analytics</h2>
        <p>Blog visitors, pageviews, sessions, reading time, scroll depth, referrers, campaigns, web vitals, and clicked destinations.</p>
        <div class="actions">
          <a class="action" href={posthogWebAnalyticsUrl} target="_blank" rel="noreferrer">Open Web Analytics ↗</a>
          <a class="action secondary" href={posthogBlogDashboardUrl} target="_blank" rel="noreferrer">Open Blog &amp; SEO Dashboard ↗</a>
        </div>
      </section>
      <section class="tool-card">
        <h2>Google Search Console</h2>
        <p>Google queries, impressions, clicks, click-through rate, average position, indexed pages, sitemap status, and search issues.</p>
        <div class="actions">
          <a class="action" href={searchConsoleUrl} target="_blank" rel="noreferrer">Open Search Performance ↗</a>
        </div>
      </section>
      <section class="tool-card">
        <h2>Google validation tools</h2>
        <p>Test Core Web Vitals and confirm that Google can read the site's venue, article, and breadcrumb structured data after each deployment.</p>
        <div class="actions">
          <a class="action" href={pageSpeedUrl} target="_blank" rel="noreferrer">Run PageSpeed ↗</a>
          <a class="action secondary" href={richResultsUrl} target="_blank" rel="noreferrer">Test rich results ↗</a>
        </div>
      </section>
      <section class="tool-card">
        <h2>Free crawl and search tools</h2>
        <p>Bing Webmaster Tools provides search reporting and a site scan. Ahrefs Free adds a recurring crawl, backlink data, and on-page issue reports for a verified site.</p>
        <div class="actions">
          <a class="action" href={bingWebmasterUrl} target="_blank" rel="noreferrer">Open Bing Webmaster ↗</a>
          <a class="action secondary" href={ahrefsUrl} target="_blank" rel="noreferrer">Open Ahrefs Free ↗</a>
        </div>
      </section>
    </div>

    <section class="event-list">
      <h2>Blog events being collected</h2>
      <ul>
        <li>Blog index and post views</li>
        <li>Page-leave and session duration</li>
        <li>Active reading time</li>
        <li>25%, 50%, 75%, and 100% scroll depth</li>
        <li>Internal, venue, CTA, and external link clicks</li>
        <li>Referrer and UTM attribution</li>
        <li>Page-level web vitals</li>
      </ul>
      <p class="notice"><strong>Launch check:</strong> public crawlers currently receive Netlify's 401 access screen. Remove site-wide visitor protection before submitting the sitemap or running external crawls. Session replay, form-content capture, and broad click autocapture are disabled. Google may omit low-volume queries for searcher privacy.</p>
    </section>
  </main>

  <script>
    import { accountSignInHref, currentReturnPath } from '../../lib/authRedirect';
    const adminUserEl = document.getElementById('admin-user')!;

    async function logout() {
      await fetch('/api/account/logout', { method: 'POST' });
      window.location.href = '/';
    }

    (async () => {
      const session = await fetch('/api/admin/me', { headers:{ 'cache-control':'no-cache' } })
        .then((response) => response.json()).catch(() => ({ authenticated:false }));
      if (!session.authenticated) {
        window.location.href = accountSignInHref(currentReturnPath());
        return;
      }
      adminUserEl.textContent = `Logged in as ${session.email}`;
    })();

    document.getElementById('logout')!.addEventListener('click', logout);
  </script>
</Layout>
