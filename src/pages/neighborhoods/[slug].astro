---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getNeighborhoodProfiles } from '../../lib/neighborhoods';
import { breadcrumbSchema, itemListSchema } from '../../lib/seo';
import { formatTime, getListingImage, getVenueImage, venuePath, venueSlug } from '../../lib/venues';
import { listingImageStyle } from '../../lib/imageCrop';
import { cardSpecials } from '../../lib/listingCopy';
import { renderCardShareNotifyIcons } from '../../lib/cardShareNotify';

export function getStaticPaths() {
  return getNeighborhoodProfiles().map((profile) => ({
    params: { slug: profile.slug },
    props: { profile },
  }));
}

const { profile } = Astro.props;
const allNeighborhoods = getNeighborhoodProfiles();
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Neighborhoods', path: '/neighborhoods/' },
  { name: profile.name, path: `/neighborhoods/${profile.slug}/` },
];
const nearby = profile.nearby
  .map((name: string) => allNeighborhoods.find((area) => area.name === name))
  .filter(Boolean);
---
<Layout
  title={`Best Happy Hours in ${profile.name}, San Diego | Happy Hour SD`}
  description={profile.shortDescription}
  image={getListingImage(profile.venues[0], 'hero')}
  imageAlt={`Happy hour in ${profile.name}, San Diego`}
  structuredData={[
    breadcrumbSchema(breadcrumbs),
    itemListSchema(`Happy hours in ${profile.name}, San Diego`, profile.venues.map((venue: any) => ({
      name: venue.name,
      path: venuePath(venue),
    }))),
  ]}
>
  <Breadcrumbs items={breadcrumbs} />
  <header class="page-header neighborhood-header">
    <p class="eyebrow">San Diego neighborhood guide</p>
    <h1>Happy Hours in {profile.name}</h1>
    <p>{profile.shortDescription}</p>
  </header>

  <main class="neighborhood-main">
    <section class="local-intro" aria-labelledby="about-area">
      <h2 id="about-area">Plan a {profile.name} happy hour</h2>
      {profile.overview.map((paragraph: string) => <p>{paragraph}</p>)}
      <p class="planning-tip"><strong>Local planning tip:</strong> {profile.planningTip}</p>
    </section>

    <section aria-labelledby="area-listings">
      <h2 id="area-listings">Current {profile.name} happy hour listings</h2>
      <p class="freshness-note">Deals can change. Open a venue to review its details and use the official website link to confirm before visiting.</p>
      <div class="venue-grid" id="neighborhood-venue-grid">
        {profile.venues.map((venue: any) => (
          <article class="venue-result" data-venue-card={venue.id}>
            <a class="venue-image" href={venuePath(venue)} tabindex="-1" aria-hidden="true">
              <img
                src={getListingImage(venue, 'card')}
                style={listingImageStyle(venue, 'card') || undefined}
                alt=""
                width="800"
                height="534"
                loading="lazy"
                data-fallback-src={getVenueImage(venue.vibe, 'card')}
              />
            </a>
            <div class="venue-copy">
              <p class="schedule">{venue.days.join(', ')} · {formatTime(venue.startTime)}–{formatTime(venue.endTime)}</p>
              <h3><a href={venuePath(venue)}>{venue.name}</a></h3>
              <p class="address">{venue.address}, San Diego, CA</p>
              <ul>
                {cardSpecials(venue).map((deal: string) => <li>{deal}</li>)}
              </ul>
              <div class="card-actions-row">
                <a class="details" href={venuePath(venue)}>View Details</a>
                <div set:html={renderCardShareNotifyIcons({
                  venueId: venue.id,
                  venueName: venue.name,
                  slug: venueSlug(venue),
                })} />
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    {nearby.length > 0 && (
      <nav class="nearby" aria-label="Nearby San Diego happy hour neighborhoods">
        <h2>Explore nearby neighborhoods</h2>
        <div>{nearby.map((area: any) => <a href={`/neighborhoods/${area.slug}/`}>{area.name}</a>)}</div>
      </nav>
    )}
  </main>
  <script>
    import { accountSignInHref, currentReturnPath } from '../../lib/authRedirect';
    import { fetchBrowserSession } from '../../lib/browserSession';
    import {
      applyFollowStateToRoot,
      bindCardShareNotify,
      hydrateCardFollows,
      type CardFollowState,
    } from '../../lib/cardShareNotify';

    for (const image of document.querySelectorAll<HTMLImageElement>('img[data-fallback-src]')) {
      const useFallback = () => {
        const fallback = image.dataset.fallbackSrc;
        if (!fallback || image.src.endsWith(fallback)) return;
        image.src = fallback;
      };
      image.addEventListener('error', useFallback, { once: true });
      if (image.complete && image.naturalWidth === 0) useFallback();
    }

    const grid = document.getElementById('neighborhood-venue-grid');
    if (grid) {
      const follows = new Map<number, CardFollowState>();
      let signedIn = false;

      bindCardShareNotify({
        root: grid,
        follows,
        isSignedIn: () => signedIn,
        onSignInRequired: () => {
          window.location.href = accountSignInHref(currentReturnPath());
        },
      });

      void (async () => {
        try {
          const session = await fetchBrowserSession();
          signedIn = session.authenticated;
          if (signedIn) {
            await hydrateCardFollows(follows);
            applyFollowStateToRoot(grid, follows);
          }
        } catch {
          signedIn = false;
        }
      })();
    }
  </script>
</Layout>

<style>
  .neighborhood-header .eyebrow { color: var(--sunset-start); font-size: .74rem; font-weight: 800; letter-spacing: .08em; margin-bottom: 7px; text-transform: uppercase; }
  .neighborhood-main { max-width: 1040px; margin: 0 auto; padding: 34px 24px 80px; }
  .local-intro { background: rgba(255,255,255,.82); border-radius: var(--radius); margin-bottom: 42px; padding: 28px; }
  .local-intro h2, .neighborhood-main > section > h2, .nearby h2 { font-family: var(--font-display); margin-bottom: 12px; }
  .local-intro p { color: var(--night-soft); line-height: 1.7; margin-bottom: 13px; }
  .local-intro .planning-tip { background: var(--sand-warm); border-radius: var(--radius-sm); color: var(--night); margin: 18px 0 0; padding: 14px 16px; }
  .freshness-note { color: var(--night-soft); line-height: 1.55; margin: -4px 0 20px; }
  .venue-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .venue-result { background: white; border-radius: var(--radius); overflow: hidden; box-shadow: 0 8px 28px rgba(15,23,42,.08); }
  .venue-image { display: block; height: 210px; }
  .venue-image img { height: 100%; object-fit: cover; width: 100%; }
  .venue-copy { padding: 22px; }
  .schedule { color: var(--sunset-start); font-size: .74rem; font-weight: 800; line-height: 1.45; margin-bottom: 8px; text-transform: uppercase; }
  .venue-copy h3 { font-family: var(--font-display); font-size: 1.45rem; margin-bottom: 4px; }
  .venue-copy h3 a { text-decoration: none; }
  .address { color: var(--night-soft); font-size: .86rem; margin-bottom: 14px; }
  .venue-copy ul { margin: 0 0 16px 20px; line-height: 1.55; }
  .card-actions-row { align-items: center; display: flex; gap: 12px; justify-content: space-between; margin: 0; }
  .details { color: var(--ocean-deep); font-weight: 750; text-decoration: none; }
  .details:hover { text-decoration: underline; }
  :global(.card-action-icons) { align-items: center; display: inline-flex; flex-shrink: 0; gap: 6px; position: relative; }
  :global(.card-icon-btn) {
    align-items: center; appearance: none; background: var(--sand-warm); border: 2px solid rgba(15, 23, 42, .12);
    border-radius: 50%; color: var(--night); cursor: pointer; display: inline-flex; flex-shrink: 0;
    height: 36px; justify-content: center; padding: 0; width: 36px;
  }
  :global(.card-icon-btn svg) { height: 16px; width: 16px; }
  :global(.card-icon-btn:hover) { border-color: rgba(15, 23, 42, .24); color: var(--sunset-start); }
  :global(.card-icon-btn:focus-visible) { border-color: var(--sunset-start); box-shadow: 0 0 0 4px rgba(255,107,53,.12); outline: none; }
  :global(.card-notify-btn.is-following) { background: var(--ocean); border-color: var(--ocean); color: white; }
  :global(.card-notify-btn.is-following:hover) { background: var(--ocean-deep, #0c4a6e); border-color: var(--ocean-deep, #0c4a6e); color: white; }
  :global(.card-popover) {
    background: white; border: 1px solid rgba(15, 23, 42, .1); border-radius: var(--radius-sm);
    box-shadow: 0 18px 44px rgba(15, 23, 42, .24); display: grid; gap: 2px; padding: 8px;
    position: absolute; right: 0; top: calc(100% + 8px); width: min(220px, calc(100vw - 48px)); z-index: 40;
  }
  :global(.card-popover[hidden]) { display: none; }
  :global(.card-popover-title) { font-size: .78rem; padding: 6px 10px 4px; }
  :global(.card-popover-status) { color: #047857; font-size: .75rem; font-weight: 700; padding: 2px 10px 6px; }
  :global(.card-popover-status.is-error) { color: #B91C1C; }
  :global(.card-share-menu button), :global(.card-share-menu a) {
    align-items: center; appearance: none; background: transparent; border: 0; border-radius: 9px;
    color: var(--night); cursor: pointer; display: flex; font: inherit; font-size: .86rem; font-weight: 700;
    gap: 10px; padding: 10px 12px; text-align: left; text-decoration: none; width: 100%;
  }
  :global(.card-share-menu :is(button, a):hover),
  :global(.card-share-menu :is(button, a):focus-visible) { background: var(--sand-warm); outline: none; }
  :global(.card-share-menu .share-fb-mark) { flex-shrink: 0; }
  :global(.card-notify-pref) {
    align-items: center; border-radius: 9px; color: var(--night); cursor: pointer;
    display: grid; font-size: .86rem; font-weight: 700; gap: 10px; grid-template-columns: 16px minmax(0, 1fr);
    padding: 8px 10px;
  }
  :global(.card-notify-pref:hover) { background: var(--sand-warm); }
  :global(.card-notify-pref.is-disabled) { color: var(--night-soft); cursor: not-allowed; opacity: .72; }
  :global(.card-notify-pref.is-disabled:hover) { background: transparent; }
  :global(.card-notify-pref-label) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 6px; line-height: 1.25; min-width: 0; }
  :global(.card-notify-pref em) { color: var(--night-soft); font-size: .72rem; font-style: normal; font-weight: 650; }
  :global(.card-notify-pref input[type="checkbox"]) {
    accent-color: var(--ocean); align-self: center; flex-shrink: 0; height: 16px; justify-self: center;
    margin: 0; padding: 0; width: 16px;
  }
  .nearby { background: var(--sand-warm); border-radius: var(--radius); margin-top: 42px; padding: 24px; }
  .nearby div { display: flex; flex-wrap: wrap; gap: 10px; }
  .nearby a { background: white; border-radius: 100px; font-weight: 700; padding: 9px 15px; text-decoration: none; }
  @media (max-width: 720px) { .venue-grid { grid-template-columns: 1fr; } }
</style>
