---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { breadcrumbSchema, itemListSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const dates = [...new Set(posts.flatMap((post) => post.data.dates))].sort().reverse();
  return dates.map((date) => ({ params: { date }, props: { date, posts: posts.filter((post) => post.data.dates.includes(date)) } }));
}
const { date, posts } = Astro.props;
const friendly = new Date(`${date}T12:00:00-07:00`).toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric', timeZone:'America/Los_Angeles' });
const breadcrumbs = [{name:'Home',path:'/'},{name:'Blog',path:'/blog/'},{name:friendly,path:`/blog/date/${date}/`}];
---
<Layout title={`${friendly} San Diego Events | SD Happy Hours`} description={`Browse SD Happy Hours articles linked to ${friendly}, including current and archived San Diego County events and deals.`} structuredData={[breadcrumbSchema(breadcrumbs),itemListSchema(`Articles for ${friendly}`,posts.map((post)=>({name:post.data.title,path:`/blog/${post.id}/`})))]}>
  <Breadcrumbs items={breadcrumbs}/><header class="page-header"><h1>{friendly}</h1><p>San Diego County stories tagged to this date. Articles remain available after the event for reference and discovery.</p></header>
  <main class="archive-list">{posts.map((post)=><article><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p></article>)}</main>
  <style>.archive-list{max-width:820px;margin:28px auto 70px;padding:0 24px}.archive-list article{background:white;border-radius:14px;padding:20px;margin-bottom:12px}.archive-list a{text-decoration:none}.archive-list p{color:var(--night-soft);margin-top:7px}</style>
</Layout>
