---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPostImage, getVenueBySlug } from '../../lib/venues';

// Newest first, matching /blog/ — so the prev/next arrows on a post walk the
// index in the order the visitor saw it there.
export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const link = (entry: (typeof posts)[number] | undefined) =>
    entry ? { slug: entry.id, title: entry.data.title } : null;

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, prev: link(posts[index - 1]), next: link(posts[index + 1]) },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const wordCount = String(post.body || '').trim().split(/\s+/).filter(Boolean).length;
const venueKeywords = post.data.venues
  .map((slug) => getVenueBySlug(slug))
  .filter(Boolean)
  .flatMap((venue) => [venue!.name, `${venue!.neighborhood} happy hour`]);
const keywords = ['San Diego happy hour', ...venueKeywords, ...post.data.tags, ...post.data.locations, ...post.data.brands, ...post.data.eventTypes];
const heroImage = getPostImage(post.data.heroImage, post.data.venues, 'hero');
const heroFallback = getPostImage(undefined, post.data.venues, 'hero');
---
<BlogPost
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  heroImage={heroImage}
  heroFallback={heroFallback}
  venues={post.data.venues}
  slug={post.id}
  wordCount={wordCount}
  keywords={keywords}
  aiGenerated={post.data.aiGenerated}
  metaDescription={post.data.metaDescription}
  ogTitle={post.data.ogTitle}
  ogDescription={post.data.ogDescription}
  tags={post.data.tags}
  dates={post.data.dates}
  locations={post.data.locations}
  brands={post.data.brands}
  eventTypes={post.data.eventTypes}
  sourceUrls={post.data.sourceUrls}
  contentEngineId={post.data.contentEngineId}
  prev={prev}
  next={next}
>
  <Content />
</BlogPost>
