    function renderVenueCommand(venueId: number): void {
      const claim = claimForVenue(venueId);
      const card = claimsListEl.querySelector(`.claim-card[data-venue-id="${venueId}"]`);
      const current = card?.querySelector('[data-promotion-command]');
      if (!claim || !current) return;
      const activeElement = document.activeElement instanceof HTMLElement && current.contains(document.activeElement)
        ? document.activeElement
        : null;
      const focusedAction = activeElement?.closest<HTMLElement>('[data-promotion-action]')?.dataset.promotionAction || '';
      const focusedPromotionId = activeElement?.closest<HTMLElement>('[data-promotion-id]')?.dataset.promotionId || '';
      current.outerHTML = promotionCommandHTML(claim);
      if (focusedAction) {
        const updated = card!.querySelector('[data-promotion-command]')!;
        const matchingAction = [...updated.querySelectorAll<HTMLElement>('[data-promotion-action]')]
          .find((candidate) =>
            candidate.dataset.promotionAction === focusedAction &&
            (candidate.closest<HTMLElement>('[data-promotion-id]')?.dataset.promotionId || '') === focusedPromotionId
          );
        const fallback = document.getElementById('shell-create-promotion');
        (matchingAction || (fallback instanceof HTMLElement ? fallback : null))?.focus();
      }
    }

    function scheduleBoundaryRefresh(venueId: number): void {
      const state = ensurePromotionState(venueId);
      if (state.boundaryTimer !== null) window.clearTimeout(state.boundaryTimer);
      state.boundaryTimer = null;
      if (!state.clock || document.hidden) return;

      const anchoredNow = state.clock.now();
      const nowMs = anchoredNow.getTime();
      const boundaries = state.promotions.flatMap((promotion) => {
        if (promotion.state === 'scheduled' && promotion.startsAt) return [promotion.startsAt];
        if (promotion.state === 'live' && (promotion.effectiveEndsAt || promotion.endsAt)) {
          return [promotion.effectiveEndsAt || promotion.endsAt!];
        }
        return [];
      });
      const claim = claimForVenue(venueId);
      const happyHourOccurrence = claim?.happyHourSchedule
        ? getHappyHourOccurrenceForDate(claim.happyHourSchedule, getSanDiegoDateKey(anchoredNow))
        : null;
      if (happyHourOccurrence) {
        boundaries.push(
          happyHourOccurrence.startsAt.toISOString(),
          happyHourOccurrence.endsAt.toISOString()
        );
      }
      const boundaryTimes = boundaries.map((value) => parseInstant(value)?.getTime() ?? Number.NaN)
        .filter((value) => Number.isFinite(value) && value > nowMs)
        .sort((left, right) => left - right);
      if (!boundaryTimes.length) return;

      const delay = Math.min(Math.max(boundaryTimes[0] - nowMs + 25, 25), 2_147_000_000);
      state.boundaryTimer = window.setTimeout(() => {
        state.boundaryTimer = null;
        if (!document.hidden) {
          // Recurring Happy Hour is presentation-only, so repaint it from the
          // anchored clock at the exact boundary. Promotion lifecycle still
          // comes from the canonical backend refresh below.
          renderVenueCommand(venueId);
          scheduleBoundaryRefresh(venueId);
          void loadPromotions(venueId, true);
        }
      }, delay);
    }

    async function loadPromotions(venueId: number, silent = false): Promise<void> {
      const state = ensurePromotionState(venueId);
      const requestVersion = ++state.requestVersion;
      if (!silent) {
        state.loading = true;
        state.error = '';
        renderVenueCommand(venueId);
      }
      try {
        const result = await api(`/api/restaurant/promotions?venueId=${encodeURIComponent(venueId)}`);
        if (requestVersion !== state.requestVersion) return;
        const data = result.data;
        if (!Array.isArray(data?.promotions) || !data?.entitlement) {
          throw new Error('The promotions response was incomplete.');
        }
        state.promotions = data.promotions;
        state.entitlement = data.entitlement;
        state.clock = anchorClock(result, data.serverNow) || state.clock;
        state.loading = false;
        state.error = '';
        renderVenueCommand(venueId);
        state.message = '';
        state.messageKind = '';
        scheduleBoundaryRefresh(venueId);
      } catch (error: any) {
        if (requestVersion !== state.requestVersion) return;
        state.loading = false;
        if (error instanceof MerchantApiError && (error.status === 401 || error.status === 403)) {
          // Merchant DTOs may contain private deal codes. Never retain them
          // after the session or verified-claim authorization stops matching.
          state.promotions = [];
          state.entitlement = null;
          state.clock = null;
          if (editorContext?.venueId === venueId && promotionDialog.open) {
            promotionForm.reset();
            promotionDialog.close();
          }
          if (actionContext?.venueId === venueId && actionDialog.open) actionDialog.close();
        }
        state.error = error?.message || 'Could not load promotions.';
        renderVenueCommand(venueId);
      }
    }

    async function loadEverything(): Promise<void> {
      const requestVersion = ++dashboardRequestVersion;
      try {
        const me = (await api('/api/account/me')).data;
        if (requestVersion !== dashboardRequestVersion) return;
        currentUser = me.authenticated ? me.user : null;
        if (!currentUser) {
          window.location.replace(accountSignInHref('/restaurant/'));
          return;
        }

        const claimsResult = await api('/api/restaurant/claims');
        if (requestVersion !== dashboardRequestVersion) return;
        const claimsData = claimsResult.data;
        claimsClock = anchorClock(claimsResult, claimsData.serverNow) || claimsClock;
        claims = claimsData.claims || [];
        for (const claim of claims) {
          if (claim.status === 'verified') ensurePromotionState(claim.venueId);
        }
        render();
        for (const claim of claims) {
          if (claim.status === 'verified') void loadPromotions(claim.venueId);
        }
      } catch (error: any) {
        if (requestVersion !== dashboardRequestVersion) return;
        showLoadError(error?.message || 'Something went wrong loading this page.');
      }
    }

    function clearMerchantSensitiveState(): void {
      dashboardRequestVersion += 1;
      for (const state of promotionStates.values()) {
        state.requestVersion += 1;
        if (state.boundaryTimer !== null) window.clearTimeout(state.boundaryTimer);
      }
      promotionStates.clear();
      currentUser = null;
      claims = [];
      claimsClock = null;
      claimsListEl.innerHTML = '';
      document.getElementById('dashboard')!.classList.add('hidden');
      document.getElementById('error-panel')!.classList.add('hidden');
      document.getElementById('loading-panel')!.classList.remove('hidden');
      if (promotionDialog.open) promotionDialog.close();
      if (actionDialog.open) actionDialog.close();
    }

    function rememberFocus(source: HTMLElement, selector: string): void {
      returnFocusElement = source;
      returnFocusSelector = selector;
    }

    function restoreFocus(): void {
      queueMicrotask(() => {
        const target = returnFocusElement?.isConnected
          ? returnFocusElement
          : returnFocusSelector
            ? document.querySelector(returnFocusSelector)
            : null;
        if (target instanceof HTMLElement) target.focus();
        returnFocusElement = null;
        returnFocusSelector = '';
      });
    }

    function setDialogStatus(
      element: Element | null,
      message: string,
      kind: '' | 'error' | 'success' = ''
    ): void {
      if (!(element instanceof HTMLElement)) return;
      element.className = `merchant-dialog-status${kind ? ` ${kind}` : ''}`;
      element.textContent = message;
    }

    function selectedWhen(): WhenMode {
      return (promotionForm.elements.namedItem('when') as RadioNodeList).value === 'schedule'
        ? 'schedule'
        : 'now';
    }

    function localInput(name: 'startsAtLocal' | 'endsAtLocal'): HTMLInputElement {
      return promotionForm.elements.namedItem(name) as HTMLInputElement;
    }

    function occurrenceChoice(name: 'startsAtOccurrence' | 'endsAtOccurrence'): 'earlier' | 'later' | null {
      const value = (promotionForm.elements.namedItem(name) as RadioNodeList).value;
      return value === 'earlier' || value === 'later' ? value : null;
    }

    function clearOccurrence(name: 'startsAtOccurrence' | 'endsAtOccurrence'): void {
      const nodes = promotionForm.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`);
      nodes.forEach((node) => { node.checked = false; });
    }

    function resolveLocalInput(
      kind: 'start' | 'end',
      required: boolean
    ): string | null {
      const input = localInput(kind === 'start' ? 'startsAtLocal' : 'endsAtLocal');
      const fold = promotionForm.querySelector(`[data-${kind}-fold]`) as HTMLElement;
      const errorEl = promotionForm.querySelector(`[data-${kind}-error]`) as HTMLElement;
      const occurrenceName = kind === 'start' ? 'startsAtOccurrence' : 'endsAtOccurrence';
      const value = input.value.trim();

      input.setCustomValidity('');
      errorEl.textContent = '';
      if (!value) {
        fold.hidden = true;
        if (required) {
          const message = `${kind === 'start' ? 'Start' : 'End'} date and time is required.`;
          input.setCustomValidity(message);
          errorEl.textContent = message;
        }
        return null;
      }

      const resolution = resolveSanDiegoDateTimeLocal(value);
      if (resolution.status === 'resolved') {
        fold.hidden = true;
        return resolution.instant.toISOString();
      }
      if (resolution.status === 'ambiguous') {
        fold.hidden = false;
        const choice = occurrenceChoice(occurrenceName);
        if (!choice) {
          const message = 'This San Diego time occurs twice. Choose the first or second occurrence.';
          input.setCustomValidity(message);
          errorEl.textContent = message;
          return null;
        }
        return resolution[choice].toISOString();
      }

      fold.hidden = true;
      const message = resolution.status === 'nonexistent'
        ? 'This time does not exist in San Diego because the clocks move forward. Choose another time.'
        : 'Enter a valid San Diego date and time.';
      input.setCustomValidity(message);
      errorEl.textContent = message;
      return null;
    }

    function setOccurrenceFromInstant(
      kind: 'start' | 'end',
      instant: string | null
    ): void {
      if (!instant) return;
      const input = localInput(kind === 'start' ? 'startsAtLocal' : 'endsAtLocal');
      const resolution = resolveSanDiegoDateTimeLocal(input.value);
      if (resolution.status !== 'ambiguous') return;
      const name = kind === 'start' ? 'startsAtOccurrence' : 'endsAtOccurrence';
      const choice = resolution.later.toISOString() === instant ? 'later' : 'earlier';
      const radio = promotionForm.querySelector<HTMLInputElement>(`input[name="${name}"][value="${choice}"]`);
      if (radio) radio.checked = true;
    }

    function syncWhenFields(): void {
      const scheduled = selectedWhen() === 'schedule';
      const fields = promotionForm.querySelector('[data-schedule-fields]') as HTMLElement;
      const startNowChoice = promotionForm.querySelector<HTMLInputElement>('input[name="when"][value="now"]');
      const reviewButton = promotionDialog.querySelector('[data-review-promotion]') as HTMLButtonElement;
      fields.hidden = !scheduled;
      localInput('startsAtLocal').required = scheduled;
      reviewButton.disabled = editorContext?.intent === 'create' && !scheduled && Boolean(startNowChoice?.disabled);
      if (!scheduled) {
        localInput('startsAtLocal').setCustomValidity('');
        (promotionForm.querySelector('[data-start-error]') as HTMLElement).textContent = '';
      }
      updatePreview();
    }

    function previewInstant(kind: 'start' | 'end'): string | null {
      const input = localInput(kind === 'start' ? 'startsAtLocal' : 'endsAtLocal');
      const resolution = resolveSanDiegoDateTimeLocal(input.value);
      if (resolution.status === 'resolved') return resolution.instant.toISOString();
      if (resolution.status === 'ambiguous') {
        const choice = occurrenceChoice(kind === 'start' ? 'startsAtOccurrence' : 'endsAtOccurrence');
        return choice ? resolution[choice].toISOString() : null;
      }
      return null;
    }

    function updatePreview(): void {
      const title = (promotionForm.elements.namedItem('title') as HTMLInputElement).value.trim();
      const description = (promotionForm.elements.namedItem('description') as HTMLTextAreaElement).value.trim();
      const type = (promotionForm.elements.namedItem('type') as HTMLSelectElement).value as MerchantPromotionDto['type'];
      const previewTitle = promotionDialog.querySelector('[data-preview-title]')!;
      const previewDetails = promotionDialog.querySelector('[data-preview-details]')!;
      const previewTime = promotionDialog.querySelector('[data-preview-time]')!;
      previewTitle.textContent = title || 'Your promotion headline';
      previewDetails.textContent = description
        ? `${formatMerchantPromotionType(type)} · ${description}`
        : formatMerchantPromotionType(type);

      const end = previewInstant('end');
      if (selectedWhen() === 'now') {
        previewTime.textContent = end ? `Starts now · ends ${formatSanDiegoDateTime(end)}` : 'Starts now · end required';
      } else {
        const start = previewInstant('start');
        previewTime.textContent = start && end
          ? `${formatSanDiegoDateTime(start)} – ${formatSanDiegoDateTime(end)}`
          : 'Scheduled start and end required';
      }
    }

    function setWhenMode(mode: WhenMode, locked: boolean): void {
      const radios = promotionForm.querySelectorAll<HTMLInputElement>('input[name="when"]');
      radios.forEach((radio) => {
        radio.checked = radio.value === mode;
        radio.disabled = locked;
      });
      syncWhenFields();
    }

    function defaultTiming(venueId: number, mode: WhenMode): { start: string; end: string } {
      const state = ensurePromotionState(venueId);
      const now = state.clock?.now() || claimsClock?.now();
      if (!now) return { start: '', end: '' };
      if (mode === 'now') {
        return {
          start: '',
          end: formatSanDiegoDateTimeInput(new Date(now.getTime() + 2 * 60 * 60 * 1000)),
        };
      }
      const fifteenMinutes = 15 * 60 * 1000;
      const startMs = Math.ceil((now.getTime() + 30 * 60 * 1000) / fifteenMinutes) * fifteenMinutes;
      return {
        start: formatSanDiegoDateTimeInput(new Date(startMs)),
        end: formatSanDiegoDateTimeInput(new Date(startMs + 2 * 60 * 60 * 1000)),
      };
    }

    function openPromotionEditor(
      source: HTMLElement,
      claim: DashboardClaim,
      intent: EditorIntent,
      promotion: MerchantPromotionDto | null,
      requestedMode: WhenMode
    ): void {
      editorContext = {
        venueId: claim.venueId,
        promotionId: intent === 'create' ? null : promotion?.id || null,
        intent,
        stateAtOpen: promotion?.state || null,
      };
      const sourceAction = source.dataset.promotionAction;
      const createActionSelector = `#shell-create-promotion, .claim-card[data-venue-id="${claim.venueId}"] [data-promotion-action="create"]`;
      rememberFocus(
        source,
        promotion && sourceAction
          ? `.claim-card[data-venue-id="${claim.venueId}"] [data-promotion-id="${promotion.id}"] [data-promotion-action="${sourceAction}"], ${createActionSelector}`
          : createActionSelector
      );

      promotionForm.reset();
      setQuickEnd(null);
      clearOccurrence('startsAtOccurrence');
      clearOccurrence('endsAtOccurrence');
      (promotionDialog.querySelector('[data-editor-step]') as HTMLElement).hidden = false;
      (promotionDialog.querySelector('[data-confirmation-step]') as HTMLElement).hidden = true;
      setDialogStatus(promotionDialog.querySelector('[data-form-status]'), '');
      setDialogStatus(promotionDialog.querySelector('[data-confirmation-status]'), '');

      const mode: WhenMode = intent === 'start-now'
        ? 'now'
        : intent === 'publish' || promotion?.state === 'scheduled'
          ? 'schedule'
          : promotion?.startsAt && promotion?.endsAt
            ? 'schedule'
            : requestedMode;
      const lockedWhen = intent === 'start-now' || intent === 'publish' || promotion?.state === 'scheduled';
      setWhenMode(mode, lockedWhen);
      if (intent === 'create' && !ensurePromotionState(claim.venueId).entitlement?.canLaunchPromotion) {
        const startNowChoice = promotionForm.querySelector<HTMLInputElement>('input[name="when"][value="now"]');
        if (startNowChoice) startNowChoice.disabled = true;
      }

      (promotionForm.elements.namedItem('type') as HTMLSelectElement).value = promotion?.type || 'special_deal';
      (promotionForm.elements.namedItem('title') as HTMLInputElement).value = promotion?.title || '';
      (promotionForm.elements.namedItem('description') as HTMLTextAreaElement).value = promotion?.description || '';
      (promotionForm.elements.namedItem('dealCode') as HTMLInputElement).value = promotion?.dealCode || '';
      setPromotionImage(promotion?.imageKey || '', promotion?.imageUrl || '');

      const defaults = defaultTiming(claim.venueId, mode);
      localInput('startsAtLocal').value = promotion?.startsAt
        ? formatSanDiegoDateTimeInput(promotion.startsAt)
        : defaults.start;
      localInput('endsAtLocal').value = promotion?.endsAt
        ? formatSanDiegoDateTimeInput(promotion.endsAt)
        : defaults.end;
      setOccurrenceFromInstant('start', promotion?.startsAt || null);
      setOccurrenceFromInstant('end', promotion?.endsAt || null);

      const title = intent === 'create'
        ? 'Create Promotion'
        : intent === 'start-now'
          ? 'Start Promotion Now'
          : intent === 'publish'
            ? 'Schedule Draft'
            : 'Edit Promotion';
      promotionDialog.querySelector('[data-dialog-close]')?.setAttribute('aria-label', `Close ${title}`);
      document.getElementById('merchant-promotion-dialog-title')!.textContent = title;
      document.getElementById('merchant-promotion-dialog-venue')!.textContent = claim.venueName || `Venue #${claim.venueId}`;

      const saveDraft = promotionDialog.querySelector('[data-save-draft]') as HTMLButtonElement;
      saveDraft.hidden = promotion?.state === 'scheduled';
      const reviewButton = promotionDialog.querySelector('[data-review-promotion]') as HTMLButtonElement;
      reviewButton.hidden = intent === 'edit' && promotion?.state === 'draft';
      syncWhenFields();
      resolveLocalInput('end', false);
      if (mode === 'schedule') resolveLocalInput('start', false);
      updatePreview();

      promotionDialog.showModal();
      queueMicrotask(() => (promotionForm.elements.namedItem('title') as HTMLInputElement).focus());
    }

    interface CompleteFormData {
      content: {
        type: string;
        title: string;
        description: string;
        dealCode: string;
        imageKey?: string;
      };
      when: WhenMode;
      startsAt: string | null;
      endsAt: string;
    }

    function formContent(): CompleteFormData['content'] {
      const imageKey = (promotionForm.elements.namedItem('imageKey') as HTMLInputElement).value.trim();
      return {
        type: (promotionForm.elements.namedItem('type') as HTMLSelectElement).value,
        title: (promotionForm.elements.namedItem('title') as HTMLInputElement).value.trim(),
        description: (promotionForm.elements.namedItem('description') as HTMLTextAreaElement).value.trim(),
        dealCode: (promotionForm.elements.namedItem('dealCode') as HTMLInputElement).value.trim(),
        ...(imageKey || editorContext?.intent !== 'create' ? { imageKey } : {}),
      };
    }

    function collectCompleteForm(): CompleteFormData | null {
      const when = selectedWhen();
      const startsAt = when === 'schedule' ? resolveLocalInput('start', true) : null;
      const endsAt = resolveLocalInput('end', true);
      if (!promotionForm.checkValidity() || !endsAt || (when === 'schedule' && !startsAt)) {
        promotionForm.reportValidity();
        return null;
      }

      const reference = when === 'schedule'
        ? parseInstant(startsAt)
        : ensurePromotionState(editorContext!.venueId).clock?.now() || claimsClock?.now() || null;
      const end = parseInstant(endsAt);
      const anchoredNow = ensurePromotionState(editorContext!.venueId).clock?.now() || claimsClock?.now() || null;
      if (when === 'schedule' && reference && anchoredNow && reference.getTime() <= anchoredNow.getTime()) {
        const message = 'A scheduled promotion must start in the future. Choose Start Now to launch immediately.';
        localInput('startsAtLocal').setCustomValidity(message);
        (promotionForm.querySelector('[data-start-error]') as HTMLElement).textContent = message;
        promotionForm.reportValidity();
        return null;
      }
      if (!reference || !end || end.getTime() <= reference.getTime()) {
        const message = 'Promotion end must be later than its start.';
        localInput('endsAtLocal').setCustomValidity(message);
        (promotionForm.querySelector('[data-end-error]') as HTMLElement).textContent = message;
        promotionForm.reportValidity();
        return null;
      }
      if (end.getTime() - reference.getTime() > 24 * 60 * 60 * 1000) {
        const message = 'Promotion duration cannot exceed 24 hours.';
        localInput('endsAtLocal').setCustomValidity(message);
        (promotionForm.querySelector('[data-end-error]') as HTMLElement).textContent = message;
        promotionForm.reportValidity();
        return null;
      }
      return { content: formContent(), when, startsAt, endsAt };
    }

    function showConfirmation(data: CompleteFormData): void {
      if (!editorContext) return;
      const titleEl = promotionDialog.querySelector('[data-confirmation-title]')!;
      const copyEl = promotionDialog.querySelector('[data-confirmation-copy]')!;
      const button = promotionDialog.querySelector('[data-confirmation-submit]') as HTMLButtonElement;
      const isGoLive = editorContext.intent === 'start-now' || (editorContext.intent === 'create' && data.when === 'now');
      const isSchedule = editorContext.intent === 'publish' || (editorContext.intent === 'create' && data.when === 'schedule');

      titleEl.textContent = isGoLive ? 'Ready to go Live?' : isSchedule ? 'Ready to schedule?' : 'Save these changes?';
      copyEl.textContent = isGoLive
        ? 'This promotion will become visible as soon as the server starts it.'
        : isSchedule
          ? 'This promotion will automatically become Live at its scheduled San Diego time.'
          : editorContext.stateAtOpen === 'draft'
            ? 'This promotion will remain a draft until you schedule it or start it.'
            : 'The updated schedule will remain active.';
      promotionDialog.querySelector('[data-confirmation-headline]')!.textContent = data.content.title;
      promotionDialog.querySelector('[data-confirmation-time]')!.textContent = data.when === 'now'
        ? `Now–${formatSanDiegoDateTime(data.endsAt)}`
        : `${formatSanDiegoDateTime(data.startsAt!)} – ${formatSanDiegoDateTime(data.endsAt)}`;
      button.textContent = isGoLive ? 'GO LIVE' : isSchedule ? 'SCHEDULE PROMOTION' : 'SAVE CHANGES';
      (promotionDialog.querySelector('[data-editor-step]') as HTMLElement).hidden = true;
      (promotionDialog.querySelector('[data-confirmation-step]') as HTMLElement).hidden = false;
      setDialogStatus(promotionDialog.querySelector('[data-confirmation-status]'), '');
      button.focus();
    }

    function applyMutationResponse(
      venueId: number,
      result: ApiResult,
      message: string
    ): void {
      const state = ensurePromotionState(venueId);
      const data = result.data;
      state.clock = anchorClock(result, data.serverNow) || state.clock;
      if (data.entitlement) state.entitlement = data.entitlement;
      if (data.promotion) {
        const index = state.promotions.findIndex((promotion) => promotion.id === data.promotion.id);
        if (index === -1) state.promotions.unshift(data.promotion);
        else state.promotions[index] = data.promotion;
      }
      if (data.deletedId) {
        state.promotions = state.promotions.filter((promotion) => promotion.id !== data.deletedId);
      }
      state.error = '';
      state.message = message;
      state.messageKind = 'success';
      renderVenueCommand(venueId);
    }

    async function mutateAndReconcile(
      venueId: number,
      path: string,
      options: RequestInit,
      message: string
    ): Promise<ApiResult> {
      const result = await api(path, options);
      applyMutationResponse(venueId, result, message);
      await loadPromotions(venueId, true);
      return result;
    }

    async function reconcileInvalidTransition(venueId: number, error: unknown): Promise<boolean> {
      if (error instanceof MerchantApiError && error.status === 409 && error.code === 'invalid_transition') {
        const state = ensurePromotionState(venueId);
        state.message = 'This promotion changed on the server. The latest state is shown.';
        state.messageKind = 'error';
        await loadPromotions(venueId, true);
        return true;
      }
      return false;
    }

    async function reconcileQuotaFailure(venueId: number, error: unknown): Promise<boolean> {
      if (!(error instanceof MerchantApiError) || error.status !== 409 || error.code !== 'promotion_quota_exhausted') {
        return false;
      }
      const state = ensurePromotionState(venueId);
      const targetEntitlement = quotaEntitlementFromError(error);
      state.message = targetEntitlement
        ? `${formatMerchantQuotaEntitlement(targetEntitlement)} The latest promotion list has been refreshed; drafts remain available.`
        : `${error.message} The latest promotion list has been refreshed; drafts remain available.`;
      state.messageKind = 'error';
      // The error entitlement is for the attempted promotion's target month.
      // Refetch the collection and dashboard entitlement so a current-month
      // conflict never disables scheduling in a different month.
      await loadPromotions(venueId, true);
      return true;
    }

    async function reconcileMutationConflict(venueId: number, error: unknown): Promise<boolean> {
      return await reconcileQuotaFailure(venueId, error) ||
        await reconcileInvalidTransition(venueId, error);
    }

    async function runEditorMutation(data: CompleteFormData): Promise<void> {
      if (!editorContext) return;
      const context = editorContext;
      const confirmButton = promotionDialog.querySelector('[data-confirmation-submit]') as HTMLButtonElement;
      confirmButton.disabled = true;
      setDialogStatus(promotionDialog.querySelector('[data-confirmation-status]'), 'Saving…');

      let createdDraftThisAttempt = false;
      try {
        const operationIntent = context.intent;
        let promotionId = context.promotionId;
        if (operationIntent === 'create') {
          const draftBody: Record<string, unknown> = {
            venueId: context.venueId,
            ...data.content,
          };
          // Start Now intentionally sends no client-authored start time. Its
          // draft is untimed; the action endpoint supplies the DB timestamp.
          if (data.when === 'schedule') {
            draftBody.startsAt = data.startsAt;
            draftBody.endsAt = data.endsAt;
          }
          const draft = await mutateAndReconcile(
            context.venueId,
            '/api/restaurant/promotions',
            { method: 'POST', body: JSON.stringify(draftBody) },
            'Draft created.'
          );
          promotionId = draft.data.promotion.id;
          editorContext.promotionId = promotionId;
          editorContext.intent = data.when === 'now' ? 'start-now' : 'publish';
          editorContext.stateAtOpen = 'draft';
          createdDraftThisAttempt = true;
        } else if (operationIntent === 'edit') {
          const patch: Record<string, unknown> = { ...data.content };
          if (data.when === 'schedule') {
            patch.startsAt = data.startsAt;
            patch.endsAt = data.endsAt;
          } else if (context.stateAtOpen === 'draft') {
            patch.startsAt = null;
            patch.endsAt = null;
          }
          await mutateAndReconcile(
            context.venueId,
            `/api/restaurant/promotions/${encodeURIComponent(promotionId!)}`,
            { method: 'PATCH', body: JSON.stringify(patch) },
            context.stateAtOpen === 'draft' ? 'Draft saved.' : 'Scheduled promotion updated.'
          );
        } else {
          const patch: Record<string, unknown> = { ...data.content };
          if (operationIntent === 'publish') {
            patch.startsAt = data.startsAt;
            patch.endsAt = data.endsAt;
          }
          await mutateAndReconcile(
            context.venueId,
            `/api/restaurant/promotions/${encodeURIComponent(promotionId!)}`,
            { method: 'PATCH', body: JSON.stringify(patch) },
            context.stateAtOpen === 'draft' ? 'Draft saved.' : 'Promotion updated.'
          );
        }

        if (operationIntent === 'create' || operationIntent === 'publish' || operationIntent === 'start-now') {
          const goLive = operationIntent === 'start-now' || (operationIntent === 'create' && data.when === 'now');
          const action = goLive ? 'start-now' : 'publish';
          // Start Now accepts only endsAt. No client start is ever supplied.
          const body = goLive ? { endsAt: data.endsAt } : {};
          await mutateAndReconcile(
            context.venueId,
            `/api/restaurant/promotions/${encodeURIComponent(promotionId!)}/${action}`,
            { method: 'POST', body: JSON.stringify(body) },
            goLive ? 'Promotion is Live.' : 'Promotion scheduled.'
          );
        }

        setDialogStatus(promotionDialog.querySelector('[data-confirmation-status]'), 'Saved.', 'success');
        promotionDialog.close();
      } catch (error: any) {
        if (await reconcileMutationConflict(context.venueId, error)) {
          promotionDialog.close();
          return;
        }
        const suffix = createdDraftThisAttempt && editorContext?.promotionId
          ? ' Your draft is saved and appears in Drafts.'
          : '';
        setDialogStatus(
          promotionDialog.querySelector('[data-confirmation-status]'),
          `${error?.message || 'Could not save the promotion.'}${suffix}`,
          'error'
        );
      } finally {
        confirmButton.disabled = false;
      }
    }

    async function saveDraft(): Promise<void> {
      if (!editorContext) return;
      const context = editorContext;
      const button = promotionDialog.querySelector('[data-save-draft]') as HTMLButtonElement;
      const when = selectedWhen();
      const body: Record<string, unknown> = { ...formContent() };

      if (when === 'schedule') {
        const startsAt = resolveLocalInput('start', false);
        const endsAt = resolveLocalInput('end', false);
        const hasEither = Boolean(localInput('startsAtLocal').value || localInput('endsAtLocal').value);
        if (hasEither && (!startsAt || !endsAt)) {
          promotionForm.reportValidity();
          return;
        }
        if (startsAt && endsAt) {
          const start = parseInstant(startsAt)!;
          const end = parseInstant(endsAt)!;
          if (end.getTime() <= start.getTime() || end.getTime() - start.getTime() > 24 * 60 * 60 * 1000) {
            setDialogStatus(
              promotionDialog.querySelector('[data-form-status]'),
              end.getTime() <= start.getTime()
                ? 'Promotion end must be later than its start.'
                : 'Promotion duration cannot exceed 24 hours.',
              'error'
            );
            return;
          }
          body.startsAt = startsAt;
          body.endsAt = endsAt;
        }
      } else if (context.promotionId && context.stateAtOpen === 'draft') {
        body.startsAt = null;
        body.endsAt = null;
      }

      button.disabled = true;
      setDialogStatus(promotionDialog.querySelector('[data-form-status]'), 'Saving draft…');
      try {
        if (context.promotionId) {
          await mutateAndReconcile(
            context.venueId,
            `/api/restaurant/promotions/${encodeURIComponent(context.promotionId)}`,
            { method: 'PATCH', body: JSON.stringify(body) },
            'Draft saved.'
          );
        } else {
          await mutateAndReconcile(
            context.venueId,
            '/api/restaurant/promotions',
            { method: 'POST', body: JSON.stringify({ venueId: context.venueId, ...body }) },
            'Draft saved.'
          );
        }
        promotionDialog.close();
      } catch (error: any) {
        if (await reconcileMutationConflict(context.venueId, error)) {
          promotionDialog.close();
          return;
        }
        setDialogStatus(
          promotionDialog.querySelector('[data-form-status]'),
          error?.message || 'Could not save the draft.',
          'error'
        );
      } finally {
        button.disabled = false;
      }
    }

    function openActionConfirmation(
      source: HTMLElement,
      venueId: number,
      promotion: MerchantPromotionDto,
      action: ActionContext['action']
    ): void {
      actionContext = { venueId, promotionId: promotion.id, action };
      rememberFocus(
        source,
        `.claim-card[data-venue-id="${venueId}"] [data-promotion-id="${promotion.id}"] [data-promotion-action="${action}"], #shell-create-promotion`
      );
      const title = action === 'delete'
        ? 'Delete this draft?'
        : action === 'cancel'
          ? 'Cancel this scheduled promotion?'
          : 'End this Live promotion?';
      const copy = action === 'delete'
        ? 'The unpublished draft will be removed permanently.'
        : action === 'cancel'
          ? 'It will move to Past and will not start at its scheduled time.'
          : 'The promotion will stop appearing publicly as soon as the server ends it.';
      actionDialog.querySelector('[data-action-dialog-title]')!.textContent = title;
      actionDialog.querySelector('[data-action-dialog-copy]')!.textContent = copy;
      (actionDialog.querySelector('[data-action-dialog-confirm]') as HTMLButtonElement).textContent = action === 'delete'
        ? 'Delete draft'
        : action === 'cancel'
          ? 'Cancel promotion'
          : 'End promotion';
      setDialogStatus(actionDialog.querySelector('[data-action-dialog-status]'), '');
      actionDialog.showModal();
      queueMicrotask(() => (actionDialog.querySelector('[data-action-dialog-cancel]') as HTMLButtonElement).focus());
    }

    async function runActionMutation(): Promise<void> {
      if (!actionContext) return;
      const context = actionContext;
      const confirmButton = actionDialog.querySelector('[data-action-dialog-confirm]') as HTMLButtonElement;
      confirmButton.disabled = true;
      setDialogStatus(actionDialog.querySelector('[data-action-dialog-status]'), 'Working…');
      try {
        if (context.action === 'delete') {
          await mutateAndReconcile(
            context.venueId,
            `/api/restaurant/promotions/${encodeURIComponent(context.promotionId)}`,
            { method: 'DELETE' },
            'Draft deleted.'
          );
        } else {
          await mutateAndReconcile(
            context.venueId,
            `/api/restaurant/promotions/${encodeURIComponent(context.promotionId)}/${context.action}`,
            { method: 'POST', body: JSON.stringify({}) },
            context.action === 'cancel' ? 'Promotion cancelled.' : 'Promotion ended.'
          );
        }
        actionDialog.close();
      } catch (error: any) {
        if (await reconcileMutationConflict(context.venueId, error)) {
          actionDialog.close();
          return;
        }
        setDialogStatus(
          actionDialog.querySelector('[data-action-dialog-status]'),
          error?.message || 'Could not update the promotion.',
          'error'
        );
      } finally {
        confirmButton.disabled = false;
      }
    }

    document.getElementById('retry-btn')?.addEventListener('click', () => {
      document.getElementById('error-panel')!.classList.add('hidden');
      document.getElementById('loading-panel')!.classList.remove('hidden');
      void loadEverything();
    });

    document.getElementById('venue-search')!.addEventListener('input', async (event) => {
      const query = (event.target as HTMLInputElement).value.trim();
      const resultsEl = document.getElementById('venue-results')!;
      if (!query) {
        resultsEl.innerHTML = '';
        return;
      }
      try {
        const data = (await api(`/api/restaurant/venues?q=${encodeURIComponent(query)}`)).data;
        const matches = data.venues || [];
        resultsEl.innerHTML = matches.map((venue: any) => `
          <button class="venue-result ${venue.alreadyClaimed ? 'claimed' : ''}" type="button" data-venue-id="${venue.id}" ${venue.alreadyClaimed ? 'disabled' : ''}>
            <span>
              <strong>${escapeHTML(venue.name)}</strong>
              <span>${escapeHTML(venue.neighborhood)} · ${escapeHTML(venue.address)}</span>
            </span>
            ${venue.alreadyClaimed
              ? '<span class="tag">Claimed</span>'
              : venue.listingStatus === 'unlisted'
                ? '<span class="tag">Not on the public site yet</span>'
                : '<span class="tag">Claim</span>'}
          </button>
        `).join('') || '<div class="status">No matches.</div>';
      } catch {
        resultsEl.innerHTML = '<div class="status error">Search failed.</div>';
      }
    });

    document.getElementById('venue-results')!.addEventListener('click', async (event) => {
      const result = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-venue-id]');
      if (!result || result.disabled) return;
      try {
        const claimedVenueId = Number(result.dataset.venueId);
        await postJson('/api/restaurant/claim', { venueId: claimedVenueId });
        selectedVenueId = claimedVenueId;
        writeVenueIdToUrl(claimedVenueId);
        await loadEverything();
      } catch (error: any) {
        window.alert(error?.message || 'Could not claim that listing.');
      }
    });

    document.getElementById('shell-create-promotion')?.addEventListener('click', (event) => {
      const claim = selectedClaim();
      if (!claim || claim.status !== 'verified') return;
      openPromotionEditor(event.currentTarget as HTMLElement, claim, 'create', null, 'now');
    });

    document.querySelector('[data-merchant-shell-switcher]')?.addEventListener('change', (event) => {
      const value = Number((event.currentTarget as HTMLSelectElement).value);
      if (!Number.isSafeInteger(value) || value <= 0) return;
      selectedVenueId = value;
      promoFilter = 'all';
      writeVenueIdToUrl(value);
      render();
      const claim = claimForVenue(value);
      if (claim?.status === 'verified') void loadPromotions(value);
    });

    claimsListEl.addEventListener('click', (event) => {
      const filter = (event.target as HTMLElement).closest<HTMLElement>('[data-promo-filter]');
      if (!filter) return;
      const next = filter.dataset.promoFilter as PromoFilter | undefined;
      if (!next || next === promoFilter) return;
      promoFilter = next;
      if (selectedVenueId != null) renderVenueCommand(selectedVenueId);
    });

    claimsListEl.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const card = target.closest<HTMLElement>('.claim-card');
      if (!card) return;
      const venueId = Number(card.dataset.venueId);
      const claim = claimForVenue(venueId);
      if (!claim) return;

      const promotionButton = target.closest<HTMLElement>('[data-promotion-action]');
      if (promotionButton) {
        const action = promotionButton.dataset.promotionAction!;
        if (action === 'retry') {
          void loadPromotions(venueId);
          return;
        }
        if (action === 'create') {
          openPromotionEditor(
            promotionButton,
            claim,
            'create',
            null,
            'now'
          );
          return;
        }

        const promotionCard = promotionButton.closest<HTMLElement>('[data-promotion-id]');
        const promotion = promotionCard?.dataset.promotionId
          ? promotionFor(venueId, promotionCard.dataset.promotionId)
          : null;
        if (!promotion) {
          void loadPromotions(venueId);
          return;
        }

        if (action === 'rerun' && promotion.state === 'ended') {
          openPromotionEditor(
            promotionButton,
            claim,
            'create',
            { ...promotion, startsAt: null, endsAt: null, effectiveEndsAt: null },
            'now'
          );
        } else if (action === 'edit' && promotion.allowedActions.update) {
          openPromotionEditor(promotionButton, claim, 'edit', promotion, promotion.state === 'scheduled' ? 'schedule' : 'now');
        } else if (action === 'publish' && promotion.allowedActions.publish) {
          openPromotionEditor(promotionButton, claim, 'publish', promotion, 'schedule');
        } else if (action === 'start-now' && promotion.allowedActions.startNow) {
          openPromotionEditor(promotionButton, claim, 'start-now', promotion, 'now');
        } else if (action === 'delete' && promotion.allowedActions.delete) {
          openActionConfirmation(promotionButton, venueId, promotion, 'delete');
        } else if (action === 'cancel' && promotion.allowedActions.cancel) {
          openActionConfirmation(promotionButton, venueId, promotion, 'cancel');
        } else if (action === 'end' && promotion.allowedActions.end) {
          openActionConfirmation(promotionButton, venueId, promotion, 'end');
        } else {
          void loadPromotions(venueId, true);
        }
        return;
      }

      if (target.closest('[data-action="send-code"]')) {
        const status = card.querySelector('[data-phone-status]')!;
        status.classList.remove('error');
        status.textContent = 'Sending…';
        try {
          const result = await postJson('/api/restaurant/claim/send-code', { venueId });
          card.querySelector('[data-code-entry]')!.classList.remove('hidden');
          status.textContent = result.simulated
            ? 'Code generated — provider not configured, check the server log.'
            : "Code sent — check the venue's phone.";
        } catch (error: any) {
          status.classList.add('error');
          status.textContent = error?.message || 'Could not send a code.';
        }
        return;
      }

      if (target.closest('[data-action="verify-code"]')) {
        const status = card.querySelector('[data-phone-status]')!;
        const codeInput = card.querySelector('[data-code-input]') as HTMLInputElement;
        status.classList.remove('error');
        status.textContent = 'Verifying…';
        try {
          await postJson('/api/restaurant/claim/verify-code', { venueId, code: codeInput.value.trim() });
          status.textContent = 'Verified!';
          await loadEverything();
        } catch (error: any) {
          status.classList.add('error');
          status.textContent = error?.message || 'Could not verify that code.';
        }
      }
    });

    claimsListEl.addEventListener('submit', async (event) => {
      const form = (event.target as HTMLElement).closest<HTMLFormElement>('[data-resubmit-form]');
      if (!form) return;
      event.preventDefault();
      const card = form.closest<HTMLElement>('.claim-card')!;
      const venueId = Number(card.dataset.venueId);
      const status = card.querySelector('[data-resubmit-status]')!;
      status.classList.remove('error');
      status.textContent = 'Submitting…';
      try {
        await postJson('/api/restaurant/claim', {
          venueId,
          claimNote: (form.elements.namedItem('claimNote') as HTMLTextAreaElement).value,
        });
        status.textContent = 'Submitted for review.';
        await loadEverything();
      } catch (error: any) {
        status.classList.add('error');
        status.textContent = error?.message || 'Could not submit for review.';
      }
    });

    promotionForm.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === 'when') syncWhenFields();
      if (target.name === 'startsAtLocal') {
        setQuickEnd(null);
        clearOccurrence('startsAtOccurrence');
        resolveLocalInput('start', false);
      }
      if (target.name === 'endsAtLocal') {
        setQuickEnd(null);
        clearOccurrence('endsAtOccurrence');
        resolveLocalInput('end', false);
      }
      updatePreview();
    });

    promotionForm.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === 'startsAtOccurrence') resolveLocalInput('start', true);
      if (target.name === 'endsAtOccurrence') resolveLocalInput('end', true);
      updatePreview();
    });

    promotionForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = collectCompleteForm();
      if (data) showConfirmation(data);
    });

    promotionDialog.querySelector('[data-dialog-close]')!.addEventListener('click', () => promotionDialog.close());
    promotionDialog.querySelector('[data-confirmation-back]')!.addEventListener('click', () => {
      (promotionDialog.querySelector('[data-confirmation-step]') as HTMLElement).hidden = true;
      (promotionDialog.querySelector('[data-editor-step]') as HTMLElement).hidden = false;
      (promotionDialog.querySelector('[data-review-promotion]') as HTMLButtonElement).focus();
    });
    promotionDialog.querySelector('[data-confirmation-submit]')!.addEventListener('click', () => {
      const data = collectCompleteForm();
      if (data) void runEditorMutation(data);
    });
    promotionDialog.querySelector('[data-save-draft]')!.addEventListener('click', () => void saveDraft());
    promotionDialog.querySelector<HTMLInputElement>('[data-promotion-image-file]')!.addEventListener('change', async (event) => {
      if (!editorContext) return;
      const input = event.currentTarget as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      const status = promotionDialog.querySelector('[data-promotion-image-status]') as HTMLElement;
      status.textContent = 'Uploading and checking image…';
      input.disabled = true;
      try {
        const body = new FormData();
        body.set('venueId', String(editorContext.venueId));
        body.set('file', file);
        const result = await api('/api/restaurant/promotions/images', { method: 'POST', body });
        setPromotionImage(result.data.imageKey, result.data.url);
      } catch (error: any) {
        status.textContent = error?.message || 'Could not upload that image.';
      } finally {
        input.disabled = false;
        input.value = '';
      }
    });
    promotionDialog.querySelector('[data-promotion-image-remove]')!.addEventListener('click', () => setPromotionImage());
    promotionDialog.querySelectorAll<HTMLButtonElement>('[data-quick-end]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!editorContext) return;
        let base = selectedWhen() === 'schedule'
          ? parseInstant(resolveLocalInput('start', true))
          : ensurePromotionState(editorContext.venueId).clock?.now() || claimsClock?.now() || null;
        if (!base) {
          setDialogStatus(promotionDialog.querySelector('[data-form-status]'), 'Choose a valid start time first.', 'error');
          return;
        }
        const hours = Number(button.dataset.quickEnd);
        localInput('endsAtLocal').value = formatSanDiegoDateTimeInput(
          new Date(base.getTime() + hours * 60 * 60 * 1000)
        );
        clearOccurrence('endsAtOccurrence');
        resolveLocalInput('end', false);
        setQuickEnd(hours);
        updatePreview();
      });
    });
    promotionDialog.addEventListener('close', restoreFocus);

    actionDialog.querySelector('[data-action-dialog-cancel]')!.addEventListener('click', () => actionDialog.close());
    actionDialog.querySelector('[data-action-dialog-confirm]')!.addEventListener('click', () => void runActionMutation());
    actionDialog.addEventListener('close', restoreFocus);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) return;
      for (const claim of claims) {
        if (claim.status === 'verified') void loadPromotions(claim.venueId, true);
      }
    });
    const AUTH_CHANGED_EVENT = 'sdhh:auth-changed';
    window.addEventListener(AUTH_CHANGED_EVENT, () => {
      clearMerchantSensitiveState();
      void loadEverything();
    });
    window.addEventListener('pagehide', (event) => {
      if ((event as PageTransitionEvent).persisted) clearMerchantSensitiveState();
    });
    window.addEventListener('pageshow', (event) => {
      if ((event as PageTransitionEvent).persisted) {
        void loadEverything();
        return;
      }
      for (const claim of claims) {
        if (claim.status === 'verified') void loadPromotions(claim.venueId, true);
      }
    });
    window.setInterval(() => {
      if (document.hidden) return;
      for (const claim of claims) {
        if (claim.status === 'verified') void loadPromotions(claim.venueId, true);
      }
    }, 60_000);

    void loadEverything();
  </script>
</Layout>
