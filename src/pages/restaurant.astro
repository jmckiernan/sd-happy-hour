    function metricsHTML(claim: DashboardClaim, state: VenuePromotionState): string {
      const clock = state.clock || claimsClock;
      let hhValue = '—';
      let hhMeta = "Checking today's recurring schedule…";
      let hhLive = false;
      if (clock) {
        const today = getTodayHappyHourPresentation(claim.happyHourSchedule, clock.now());
        hhValue = today.timeRange || 'None today';
        hhMeta = today.statusText;
        hhLive = today.state === 'live';
      }

      const groups = groupMerchantPromotions(state.promotions);
      const liveCount = groups.active.length;
      const scheduledCount = groups.scheduled.length;
      const liveValue = liveCount === 0 ? 'None running' : String(liveCount);
      const liveMeta = `${liveCount} active · ${scheduledCount} scheduled`;

      let allowanceValue = 'Loading…';
      let allowanceMeta = 'Monthly promotion credits';
      if (state.entitlement) {
        const entitlement = state.entitlement;
        if (entitlement.isUnlimited || entitlement.remainingThisMonth === null || entitlement.allowance === null) {
          allowanceValue = 'Unlimited';
          allowanceMeta = formatAllowanceReset(entitlement.monthKey);
        } else {
          allowanceValue = `${entitlement.remainingThisMonth} of ${entitlement.allowance} left`;
          allowanceMeta = formatAllowanceReset(entitlement.monthKey);
        }
      }

      return `
        <div class="merchant-metrics" aria-label="Promotion metrics">
          <article class="merchant-metric-card">
            <span class="label">Recurring happy hour</span>
            <span class="value">${escapeHTML(hhValue)}</span>
            <span class="meta ${hhLive ? 'is-live' : ''}">${escapeHTML(hhMeta)}</span>
          </article>
          <article class="merchant-metric-card">
            <span class="label">Live promotions</span>
            <span class="value">${escapeHTML(liveValue)}</span>
            <span class="meta">${escapeHTML(liveMeta)}</span>
          </article>
          <article class="merchant-metric-card">
            <span class="label">Monthly allowance</span>
            <span class="value">${escapeHTML(allowanceValue)}</span>
            <span class="meta">${escapeHTML(allowanceMeta)}</span>
          </article>
        </div>
      `;
    }

