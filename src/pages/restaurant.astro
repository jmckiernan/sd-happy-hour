---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import MerchantShell from '../components/MerchantShell.astro';
import MerchantPromotionUI from '../components/MerchantPromotionUI.astro';
---
<Layout
  title="Restaurant Dashboard | Happy Hour SD"
  description="Manage your restaurant listing and launch or schedule limited-time promotions."
>
  <style is:global>
    .restaurant-page { padding: 28px 24px 0; }
    .restaurant-workspace form { display: grid; gap: 12px; }
    .restaurant-workspace label {
      color: var(--night-soft); display: grid; font-size: 0.72rem; font-weight: 700;
      gap: 6px; letter-spacing: 0.05em; text-transform: uppercase;
    }
    .restaurant-workspace input,
    .restaurant-workspace textarea {
      border: 2px solid var(--sand-warm); border-radius: var(--radius-sm); color: var(--night);
      font: inherit; min-height: 44px; padding: 11px 12px; width: 100%;
    }
    .restaurant-workspace input:focus,
    .restaurant-workspace textarea:focus {
      border-color: var(--sunset-start); box-shadow: 0 0 0 4px rgba(255,107,53,0.12); outline: none;
    }
    .claim-listing-help { margin-bottom: 16px; }
    .restaurant-workspace textarea { min-height: 90px; resize: vertical; }

    .restaurant-workspace button:not(.merchant-promotion-button):not(.merchant-shell-btn):not(.merchant-filter-chip):not(.merchant-dialog-close) {
      background: var(--night); border: 0; border-radius: 100px; color: white; cursor: pointer;
      font: inherit; font-weight: 700; min-height: 44px; padding: 11px 18px;
    }
    .restaurant-workspace button:not(.merchant-promotion-button):not(.merchant-shell-btn):not(.merchant-filter-chip):not(.merchant-dialog-close):hover {
      background: var(--sunset-start);
    }
    .restaurant-workspace button.secondary { background: var(--sand-warm); color: var(--night); }
    .restaurant-workspace button.secondary:hover { background: var(--sunset-end); }
    .restaurant-workspace button:disabled { cursor: default; opacity: 0.6; }
    .restaurant-workspace button:focus-visible,
    .restaurant-workspace a:focus-visible,
    .restaurant-workspace input:focus-visible,
    .restaurant-workspace textarea:focus-visible,
    .restaurant-workspace select:focus-visible {
      outline: 3px solid var(--sunset-start); outline-offset: 3px;
    }

    .status { color: var(--night-soft); font-size: 0.88rem; font-weight: 600; min-height: 1.3em; }
    .status.error { color: #B91C1C; }

    .pill {
      align-self: flex-start; border-radius: 100px; display: inline-block; font-size: 0.72rem;
      font-weight: 700; letter-spacing: 0.04em; padding: 5px 12px; text-transform: uppercase;
    }
    .pill.pending { background: #FEF3C7; color: #92400E; }
    .pill.verified { background: #DCFCE7; color: #166534; }
    .pill.denied { background: #FEE2E2; color: #991B1B; }

    .venue-results { display: grid; gap: 6px; margin-top: 10px; max-height: 220px; overflow-y: auto; }
    .venue-result {
      align-items: center; background: var(--sand); border: 1px solid var(--sand-warm);
      border-radius: var(--radius-sm); cursor: pointer; display: flex; font-size: 0.9rem;
      gap: 10px; justify-content: space-between; min-height: 48px; padding: 10px 12px;
    }
    .restaurant-workspace .venue-result { background: var(--sand); color: var(--night); text-align: left; }
    .venue-result:hover { background: var(--sand-warm); }
    .venue-result.claimed { cursor: default; opacity: 0.6; }
    .venue-result strong { display: block; }
    .venue-result span { color: var(--night-soft); font-size: 0.8rem; }
    .venue-result .tag {
      color: var(--night-soft); font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    }

    .claim-card {
      background: var(--sand);
      border-radius: 14px;
      margin-bottom: 14px;
      padding: 16px;
    }
    .claim-card[data-verified-workspace="true"] {
      background: transparent;
      border-radius: 0;
      margin: 0;
      padding: 0;
    }
    .claim-card-head {
      align-items: center; display: flex; flex-wrap: wrap; gap: 10px;
      justify-content: space-between; margin-bottom: 8px;
    }
    .claim-card-head h3 { font-family: var(--font-display); font-size: 1.05rem; margin: 0; }
    .claim-card > .status { margin-bottom: 8px; }

    .verify-block { margin-top: 8px; }
    .code-entry { display: flex; gap: 8px; margin-top: 8px; }
    .code-entry input { max-width: 150px; }
    details > summary { cursor: pointer; }
    details form { margin-top: 10px; }
    .hidden { display: none !important; }

    .loading-row { align-items: center; display: flex; gap: 12px; }
    .loading-row .status { margin: 0; }

    .restaurant-section-title {
      font-family: var(--font-display);
      font-size: 1.15rem;
      margin: 0 0 12px;
    }

    .merchant-metrics {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-bottom: 20px;
    }
    .merchant-metric-card {
      background: var(--sand);
      border: 1px solid rgba(32, 18, 56, 0.06);
      border-radius: 14px;
      display: grid;
      gap: 6px;
      min-height: 104px;
      padding: 16px 17px;
    }
    .merchant-metric-card .label {
      color: var(--night-soft);
      font-size: 0.72rem;
      font-weight: 850;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .merchant-metric-card .value {
      color: var(--night);
      font-family: var(--font-display);
      font-size: clamp(1.2rem, 2vw, 1.55rem);
      font-weight: 700;
      line-height: 1.15;
    }
    .merchant-metric-card .meta {
      color: var(--night-soft);
      font-size: 0.8rem;
      font-weight: 650;
    }
    .merchant-metric-card .meta.is-live { color: #166534; }

    .merchant-filter-row {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .merchant-filter-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }
    .merchant-filter-chip {
      background: transparent !important;
      border: 0 !important;
      border-radius: 999px !important;
      color: var(--night-soft) !important;
      cursor: pointer;
      font: inherit !important;
      font-size: 0.8rem !important;
      font-weight: 750 !important;
      min-height: 36px !important;
      padding: 7px 12px !important;
    }
    .merchant-filter-chip.is-active {
      background: var(--sand-warm) !important;
      color: var(--night) !important;
    }
    .merchant-filter-chip:hover { color: var(--night) !important; }

    .merchant-promo-table-wrap { overflow-x: auto; }
    .merchant-promo-table {
      border-collapse: collapse;
      width: 100%;
    }
    .merchant-promo-table th {
      color: var(--night-soft);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      padding: 10px 12px;
      text-align: left;
      text-transform: uppercase;
    }
    .merchant-promo-table th:last-child,
    .merchant-promo-table td:last-child { text-align: right; }
    .merchant-promo-table td {
      border-top: 1px solid rgba(32, 18, 56, 0.08);
      padding: 14px 12px;
      vertical-align: top;
    }
    .merchant-promo-table .promo-title {
      color: var(--night);
      font-size: 0.95rem;
      font-weight: 800;
      margin: 0 0 4px;
    }
    .merchant-promo-table .promo-sub {
      color: var(--night-soft);
      font-size: 0.78rem;
      margin: 0;
    }
    .merchant-promo-table .promo-window-day {
      color: var(--night);
      font-size: 0.88rem;
      font-weight: 750;
      margin: 0 0 2px;
    }
    .merchant-promo-table .promo-window-time {
      color: var(--night-soft);
      font-size: 0.78rem;
      margin: 0;
    }
    .merchant-promo-table .promo-actions {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      justify-content: flex-end;
    }
    .merchant-promo-table .merchant-promotion-button {
      font-size: 0.78rem;
      min-height: 36px;
      padding: 7px 12px;
    }
    .merchant-promo-empty {
      color: var(--night-soft);
      font-size: 0.9rem;
      margin: 18px 0 0;
      text-align: center;
    }

    .claim-panel {
      background: var(--sand);
      border-radius: 14px;
      margin-top: 18px;
      padding: 18px;
    }
    .claim-panel h2 { font-family: var(--font-display); font-size: 1.1rem; margin: 0 0 10px; }
    .unverified-stack { display: grid; gap: 12px; }

    @media (max-width: 900px) {
      .merchant-metrics { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .restaurant-page { padding-left: 14px; padding-right: 14px; }
      .code-entry { align-items: stretch; flex-direction: column; }
      .code-entry input { max-width: none; }
      .merchant-promo-table .promo-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-top: 8px;
      }
    }
  </style>

  <div class="restaurant-page">
    <MerchantShell
      activeTab="promotions"
      venueName="Restaurant workspace"
      hideTabs={true}
    >
      <button
        slot="primary-cta"
        class="merchant-shell-btn"
        type="button"
        data-promotion-action="create"
        data-merchant-shell-primary-cta
        id="shell-create-promotion"
        hidden
      >
        Create Promotion
      </button>

      <div class="restaurant-workspace">
        <section id="loading-panel">
          <div class="loading-row" role="status" aria-live="polite">
            <img class="drink-loader drink-loader--sm" src="/cocktail-loader.svg" alt="" aria-hidden="true">
            <p class="status">Loading your listings…</p>
          </div>
        </section>

        <section class="hidden" id="error-panel">
          <h2 class="restaurant-section-title">Couldn't load your dashboard</h2>
          <p class="status" id="error-text"></p>
          <button type="button" id="retry-btn">Try again</button>
        </section>

        <div id="dashboard" class="hidden">
          <div id="claims-list"></div>
          <p class="status hidden" id="no-claims">
            You haven't claimed a listing yet — search for it below.
          </p>

          <section class="claim-panel" id="claim-listing-panel">
            <h2>Claim a listing</h2>
            <p class="status claim-listing-help">
              Signing in with an email at your restaurant's own website domain verifies you instantly.
              Otherwise verify by phone (if we have a number on file) or submit for manual review.
              Venues that are not on the public site yet (no verified happy hour) still appear here so you can claim them.
            </p>
            <label for="venue-search" class="hidden">Search restaurants</label>
            <input type="search" id="venue-search" placeholder="Search by restaurant name…" autocomplete="off">
            <div class="venue-results" id="venue-results"></div>
          </section>
        </div>
      </div>
    </MerchantShell>
  </div>

  <MerchantPromotionUI />

  <script>
    import {
      createServerAnchoredClock,
      formatSanDiegoDateTime,
      formatSanDiegoDateTimeInput,
      resolveSanDiegoDateTimeLocal,
      type ServerAnchoredClock,
    } from '../lib/promotionClientTime';
    import {
      formatMerchantPromotionState,
      formatMerchantPromotionType,
      formatMerchantQuotaEntitlement,
      getTodayHappyHourPresentation,
      groupMerchantPromotions,
      type MerchantPromotionDto,
      type MerchantPromotionEntitlementDto,
    } from '../lib/merchantPromotionDashboard';
    import {
      getHappyHourOccurrenceForDate,
      getSanDiegoDateKey,
      parseInstant,
    } from '../lib/sanDiegoTime';
    import { accountSignInHref } from '../lib/authRedirect';

    interface DashboardClaim {
      id: string;
      venueId: number;
      status: 'pending' | 'verified' | 'denied';
      verificationMethod?: string | null;
      claimNote?: string | null;
      denialReason?: string | null;
      venueName?: string | null;
      venueSlug?: string | null;
      venueNeighborhood?: string | null;
      venuePhoneAvailable?: boolean;
      happyHourSchedule?: {
        id: number;
        days: string[];
        startTime: string;
        endTime: string;
      } | null;
      accessRole?: 'owner' | 'full_admin' | 'promotions';
    }

    interface VenuePromotionState {
      promotions: MerchantPromotionDto[];
      entitlement: MerchantPromotionEntitlementDto | null;
      clock: ServerAnchoredClock | null;
      loading: boolean;
      error: string;
      message: string;
      messageKind: '' | 'error' | 'success';
      requestVersion: number;
      boundaryTimer: number | null;
    }

    type EditorIntent = 'create' | 'edit' | 'publish' | 'start-now';
    type WhenMode = 'now' | 'schedule';

    interface EditorContext {
      venueId: number;
      promotionId: string | null;
      intent: EditorIntent;
      stateAtOpen: MerchantPromotionDto['state'] | null;
    }

    interface ActionContext {
      venueId: number;
      promotionId: string;
      action: 'delete' | 'cancel' | 'end';
    }

    interface ApiResult<T = any> {
      data: T;
      requestStartedAt: number;
      responseReceivedAt: number;
    }

    class MerchantApiError extends Error {
      status: number;
      code: string;
      details: Record<string, unknown> | null;

      constructor(status: number, body: any) {
        super(Array.isArray(body?.errors) ? body.errors.join(' ') : 'Something went wrong.');
        this.name = 'MerchantApiError';
        this.status = status;
        this.code = typeof body?.code === 'string' ? body.code : '';
        this.details = body?.details && typeof body.details === 'object' ? body.details : null;
      }
    }

    function quotaEntitlementFromError(
      error: unknown
    ): MerchantPromotionEntitlementDto | null {
      if (!(error instanceof MerchantApiError) || error.code !== 'promotion_quota_exhausted') {
        return null;
      }
      const value = error.details?.entitlement;
      if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
      const entitlement = value as Partial<MerchantPromotionEntitlementDto>;
      const allowanceIsValid = entitlement.allowance === null ||
        (Number.isSafeInteger(entitlement.allowance) && Number(entitlement.allowance) > 0);
      const remainingIsValid = entitlement.remainingThisMonth === null ||
        (Number.isSafeInteger(entitlement.remainingThisMonth) && Number(entitlement.remainingThisMonth) >= 0);
      if (
        typeof entitlement.monthKey !== 'string' ||
        !allowanceIsValid ||
        !remainingIsValid ||
        !Number.isSafeInteger(entitlement.consumed) ||
        Number(entitlement.consumed) < 0 ||
        !Number.isSafeInteger(entitlement.reserved) ||
        Number(entitlement.reserved) < 0 ||
        typeof entitlement.isUnlimited !== 'boolean'
      ) {
        return null;
      }
      return value as MerchantPromotionEntitlementDto;
    }

    type PromoFilter = 'all' | 'active' | 'scheduled' | 'drafts' | 'past';

    let currentUser: any = null;
    let claims: DashboardClaim[] = [];
    let claimsClock: ServerAnchoredClock | null = null;
    let dashboardRequestVersion = 0;
    let selectedVenueId: number | null = null;
    let promoFilter: PromoFilter = 'all';
    const promotionStates = new Map<number, VenuePromotionState>();

    let editorContext: EditorContext | null = null;
    let actionContext: ActionContext | null = null;
    let returnFocusElement: HTMLElement | null = null;
    let returnFocusSelector = '';

    const claimsListEl = document.getElementById('claims-list')!;
    const promotionDialog = document.getElementById('merchant-promotion-dialog') as HTMLDialogElement;
    const promotionForm = document.getElementById('merchant-promotion-form') as HTMLFormElement;
    const actionDialog = document.getElementById('merchant-promotion-action-dialog') as HTMLDialogElement;

    function setQuickEnd(hours: number | null): void {
      promotionDialog.querySelectorAll<HTMLButtonElement>('[data-quick-end]').forEach((button) => {
        button.setAttribute('aria-pressed', String(hours !== null && Number(button.dataset.quickEnd) === hours));
      });
    }

    function setPromotionImage(imageKey = '', imageUrl = ''): void {
      const keyInput = promotionForm.elements.namedItem('imageKey') as HTMLInputElement;
      const preview = promotionDialog.querySelector('[data-promotion-image-preview]') as HTMLImageElement;
      const remove = promotionDialog.querySelector('[data-promotion-image-remove]') as HTMLButtonElement;
      keyInput.value = imageKey;
      preview.src = imageUrl;
      preview.hidden = !imageUrl;
      remove.hidden = !imageUrl;
      (promotionDialog.querySelector('[data-promotion-image-status]') as HTMLElement).textContent = '';
    }

    function escapeHTML(value: unknown): string {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      } as Record<string, string>)[char]);
    }

    function ensurePromotionState(venueId: number): VenuePromotionState {
      let state = promotionStates.get(venueId);
      if (!state) {
        state = {
          promotions: [], entitlement: null, clock: null, loading: true, error: '',
          message: '', messageKind: '', requestVersion: 0, boundaryTimer: null,
        };
        promotionStates.set(venueId, state);
      }
      return state;
    }

    function claimForVenue(venueId: number): DashboardClaim | null {
      return claims.find((claim) => claim.venueId === venueId) || null;
    }

    function selectedClaim(): DashboardClaim | null {
      if (selectedVenueId == null) return null;
      return claimForVenue(selectedVenueId);
    }

    function roleLabel(role: DashboardClaim['accessRole'] | null | undefined): string {
      if (role === 'owner') return 'Owner';
      if (role === 'full_admin') return 'Full Admin';
      if (role === 'promotions') return 'Promotions';
      return '';
    }

    function readVenueIdFromUrl(): number | null {
      const raw = new URLSearchParams(window.location.search).get('venueId');
      if (!raw) return null;
      const value = Number(raw);
      return Number.isSafeInteger(value) && value > 0 ? value : null;
    }

    function writeVenueIdToUrl(venueId: number | null): void {
      const url = new URL(window.location.href);
      if (venueId == null) url.searchParams.delete('venueId');
      else url.searchParams.set('venueId', String(venueId));
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    }

    function pickSelectedVenueId(): number | null {
      if (!claims.length) return null;
      const fromUrl = readVenueIdFromUrl();
      if (fromUrl != null && claims.some((claim) => claim.venueId === fromUrl)) return fromUrl;
      const verified = claims.find((claim) => claim.status === 'verified');
      return (verified || claims[0]).venueId;
    }

    function formatAllowanceReset(monthKey: string): string {
      const match = /^(\d{4})-(\d{2})$/.exec(monthKey);
      if (!match) return 'Resets next month';
      const year = Number(match[1]);
      const month = Number(match[2]); // 1-12
      const nextMonthIndex = month === 12 ? 0 : month;
      const nextYear = month === 12 ? year + 1 : year;
      const label = new Intl.DateTimeFormat('en-US', {
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
      }).format(new Date(Date.UTC(nextYear, nextMonthIndex, 1)));
      return `Resets ${label}`;
    }

    function formatPromotionWindow(promotion: MerchantPromotionDto): { day: string; time: string } {
      const start = promotion.startsAt;
      const end = promotion.effectiveEndsAt || promotion.endsAt;
      if (!start && !end) {
        return {
          day: promotion.state === 'draft' ? 'Not set' : '—',
          time: '',
        };
      }
      const dayFormatter = new Intl.DateTimeFormat('en-US', {
        month: 'short',
        day: 'numeric',
        timeZone: 'America/Los_Angeles',
      });
      const timeFormatter = new Intl.DateTimeFormat('en-US', {
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
        timeZone: 'America/Los_Angeles',
      });
      const startDate = start ? new Date(start) : null;
      const endDate = end ? new Date(end) : null;
      if (startDate && Number.isNaN(startDate.getTime())) {
        return { day: '—', time: '' };
      }
      const day = startDate
        ? dayFormatter.format(startDate)
        : endDate
          ? dayFormatter.format(endDate)
          : '—';
      const startText = startDate ? timeFormatter.format(startDate).toLowerCase().replace(' ', '') : '';
      const endText = endDate && !Number.isNaN(endDate.getTime())
        ? timeFormatter.format(endDate).toLowerCase().replace(' ', '')
        : '';
      const time = startText && endText ? `${startText}–${endText}` : startText || endText;
      return { day, time };
    }

    function shellTabHref(tab: string, claim: DashboardClaim | null): string {
      const id = claim?.venueId;
      const slug = claim?.venueSlug ? encodeURIComponent(claim.venueSlug) : '';
      switch (tab) {
        case 'promotions':
          return id != null ? `/restaurant/?venueId=${id}` : '/restaurant/';
        case 'listing':
          return slug ? `/restaurant/manage/${slug}/?tab=listing` : '#';
        case 'photos':
          return slug ? `/restaurant/manage/${slug}/?tab=photos` : '#';
        case 'menu':
          return slug ? `/restaurant/manage/${slug}/?tab=menu` : '#';
        case 'audience':
          return id != null ? `/restaurant/audience/?venueId=${id}` : '/restaurant/audience/';
        case 'reports':
          return id != null ? `/restaurant/reports/?venueId=${id}` : '/restaurant/reports/';
        case 'billing':
          return id != null ? `/restaurant/billing/?venueId=${id}` : '/restaurant/billing/';
        case 'team':
          return slug ? `/restaurant/manage/${slug}/users/` : '#';
        default:
          return '#';
      }
    }

    function syncMerchantShell(claim: DashboardClaim | null): void {
      const shell = document.querySelector<HTMLElement>('[data-merchant-shell]');
      if (!shell) return;
      const nameEl = shell.querySelector('[data-merchant-shell-venue-name]');
      const emailEl = shell.querySelector('[data-merchant-shell-email]');
      const roleEl = shell.querySelector('[data-merchant-shell-role]');
      const roleSep = shell.querySelector<HTMLElement>('[data-merchant-shell-role-sep]');
      const verifiedEl = shell.querySelector<HTMLElement>('[data-merchant-shell-verified]');
      const publicEl = shell.querySelector<HTMLAnchorElement>('[data-merchant-shell-public]');
      const tabsEl = shell.querySelector<HTMLElement>('[data-merchant-shell-tabs]');
      const switcher = shell.querySelector<HTMLSelectElement>('[data-merchant-shell-switcher]');
      const createBtn = document.getElementById('shell-create-promotion') as HTMLButtonElement | null;

      const email = currentUser?.email || '';
      if (emailEl) emailEl.textContent = email;

      if (!claim) {
        if (nameEl) nameEl.textContent = 'Restaurant workspace';
        if (roleEl) roleEl.textContent = '';
        if (roleSep) roleSep.hidden = true;
        if (verifiedEl) verifiedEl.hidden = true;
        if (publicEl) {
          publicEl.hidden = true;
          publicEl.href = '#';
        }
        if (tabsEl) tabsEl.hidden = true;
        if (switcher) {
          switcher.hidden = true;
          switcher.innerHTML = '';
        }
        if (createBtn) createBtn.hidden = true;
        shell.dataset.venueId = '';
        return;
      }

      if (nameEl) nameEl.textContent = claim.venueName || `Venue #${claim.venueId}`;
      const roleText = roleLabel(claim.accessRole);
      if (roleEl) roleEl.textContent = roleText;
      if (roleSep) roleSep.hidden = !(roleText && email);
      if (verifiedEl) verifiedEl.hidden = claim.status !== 'verified';
      shell.dataset.venueId = String(claim.venueId);

      if (publicEl) {
        if (claim.venueSlug) {
          publicEl.hidden = false;
          publicEl.href = `/venues/${encodeURIComponent(claim.venueSlug)}/`;
        } else {
          publicEl.hidden = true;
          publicEl.href = '#';
        }
      }

      if (createBtn) createBtn.hidden = claim.status !== 'verified';

      if (tabsEl) {
        const showTabs = Boolean(claim.accessRole) || claim.status === 'verified';
        tabsEl.hidden = !showTabs;
        const role = claim.accessRole || (claim.status === 'verified' ? 'promotions' : null);
        for (const tab of tabsEl.querySelectorAll<HTMLAnchorElement>('[data-merchant-shell-tab]')) {
          const tabId = tab.dataset.merchantShellTab || '';
          let visible = true;
          if (role === 'promotions') visible = tabId === 'promotions';
          else if (role === 'full_admin') visible = tabId !== 'team';
          else if (role === 'owner') visible = true;
          else visible = tabId === 'promotions';
          tab.hidden = !visible;
          tab.classList.toggle('is-active', tabId === 'promotions');
          if (tabId === 'promotions') tab.setAttribute('aria-current', 'page');
          else tab.removeAttribute('aria-current');
          const href = shellTabHref(tabId, claim);
          const needsSlug = tabId === 'listing' || tabId === 'photos' || tabId === 'menu' || tabId === 'team';
          const disabled = needsSlug && !claim.venueSlug;
          tab.href = disabled ? '#' : href;
          if (disabled) tab.setAttribute('aria-disabled', 'true');
          else tab.removeAttribute('aria-disabled');
        }
      }

      if (switcher) {
        if (claims.length > 1) {
          switcher.hidden = false;
          switcher.innerHTML = claims.map((entry) => `
            <option value="${entry.venueId}" ${entry.venueId === claim.venueId ? 'selected' : ''}>
              ${escapeHTML(entry.venueName || `Venue #${entry.venueId}`)}
            </option>
          `).join('');
        } else {
          switcher.hidden = true;
          switcher.innerHTML = '';
        }
      }
    }

    function promotionFor(venueId: number, promotionId: string): MerchantPromotionDto | null {
      return ensurePromotionState(venueId).promotions.find((promotion) => promotion.id === promotionId) || null;
    }

    function anchorClock(result: ApiResult, serverNow: unknown): ServerAnchoredClock | null {
      if (typeof serverNow !== 'string') return null;
      try {
        return createServerAnchoredClock({
          serverNow,
          requestStartedAt: result.requestStartedAt,
          responseReceivedAt: result.responseReceivedAt,
        });
      } catch {
        return null;
      }
    }

    async function api<T = any>(path: string, options: RequestInit = {}): Promise<ApiResult<T>> {
      const headers = new Headers(options.headers || {});
      headers.set('Accept', 'application/json');
      if (options.body && !(options.body instanceof FormData) && !headers.has('Content-Type')) {
        headers.set('Content-Type', 'application/json');
      }
      const requestStartedAt = performance.now();
      const response = await fetch(path, {
        ...options,
        headers,
        credentials: 'same-origin',
        cache: 'no-store',
      });
      const responseReceivedAt = performance.now();
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new MerchantApiError(response.status, data);
      return { data, requestStartedAt, responseReceivedAt };
    }

    async function postJson(path: string, body: unknown, method = 'POST'): Promise<any> {
      return (await api(path, { method, body: JSON.stringify(body) })).data;
    }

