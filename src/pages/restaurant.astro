    function render(): void {
      if (!currentUser) return;
      document.getElementById('loading-panel')!.classList.add('hidden');
      document.getElementById('error-panel')!.classList.add('hidden');
      document.getElementById('dashboard')!.classList.remove('hidden');

      selectedVenueId = pickSelectedVenueId();
      writeVenueIdToUrl(selectedVenueId);
      const claim = selectedClaim();
      syncMerchantShell(claim);

      const noClaimsEl = document.getElementById('no-claims')!;
      const claimPanel = document.getElementById('claim-listing-panel')!;

      if (!claims.length) {
        claimsListEl.innerHTML = '';
        noClaimsEl.classList.remove('hidden');
        claimPanel.classList.remove('hidden');
        return;
      }

      noClaimsEl.classList.add('hidden');

      if (claim && claim.status === 'verified') {
        claimsListEl.innerHTML = verifiedWorkspaceHTML(claim);
        claimPanel.classList.remove('hidden');
      } else {
        const unverified = claims.filter((entry) => entry.status !== 'verified');
        const selectedUnverified = claim && claim.status !== 'verified' ? [claim] : unverified;
        claimsListEl.innerHTML = `
          <div class="unverified-stack">
            ${selectedUnverified.map(unverifiedClaimCardHTML).join('')}
