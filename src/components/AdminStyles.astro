---
/** Shared admin pill-button centering. Imported from Layout so every admin
    page picks it up without duplicating the fix across a dozen Astro files. */
---
<style is:global>
  /* Flex rows default to stretch, which leaves single-line labels pinned to
     the top when a sibling wraps or a native <button> gets font: inherit. */
  .admin-subnav,
  .ce-nav,
  .ai-nav {
    align-items: center;
    flex-wrap: wrap;
  }

  .admin-subnav a,
  .ce-nav a,
  .ai-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .preview-actions,
  .draft-actions,
  .admin-actions,
  .admin-filters,
  .actions,
  .photo-actions,
  .ai-actions,
  .ce-actions,
  .ce-tabs,
  .ce-card-actions,
  .ce-preview-chrome,
  .edit-panel .edit-actions {
    align-items: center;
  }

  .preview-actions button,
  .preview-actions a,
  .draft-actions a,
  .draft-actions button,
  .admin-filters button,
  .actions button,
  .photo-actions button,
  .code-form button,
  .edit-panel .edit-actions button,
  .ai-actions button,
  .ce-actions button,
  .ce-button,
  .ce-tabs button,
  .ce-card-actions button,
  .ce-preview-chrome button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
  }

  button.secondary,
  .secondary,
  .primary,
  .danger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    .admin-bar,
    .ai-header,
    .ce-header {
      position: static !important;
      padding-inline: 16px !important;
    }

    .admin-bar-inner,
    .ai-header-inner,
    .ce-header-inner {
      align-items: stretch !important;
      flex-direction: column;
      min-width: 0;
    }

    .admin-actions,
    .ai-actions,
    .ce-actions {
      flex-wrap: wrap !important;
      justify-content: flex-start;
      min-width: 0;
      width: 100%;
    }

    .admin-user,
    .ai-actions > span,
    .ce-actions > span {
      overflow-wrap: anywhere;
      width: 100%;
    }

    .admin-subnav,
    .ce-nav,
    .ai-nav {
      flex-wrap: nowrap !important;
      margin-inline: 0 !important;
      max-width: 100%;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      padding: 0 0 6px !important;
      scrollbar-width: none;
      scroll-padding-inline: 0;
    }
    .admin-subnav::-webkit-scrollbar,
    .ce-nav::-webkit-scrollbar,
    .ai-nav::-webkit-scrollbar { display: none; }
    .admin-subnav a,
    .ce-nav a,
    .ai-nav a { min-height: 44px; }

    .admin-main,
    .ai-costs,
    .ce-shell { padding-inline: 16px !important; }

    .admin-actions button,
    .admin-filters button,
    .actions button,
    .photo-actions button,
    .ai-actions button,
    .ce-actions button,
    .ce-button,
    .ce-tabs button,
    .ce-card-actions button,
    .preview-actions button,
    .preview-actions a,
    .draft-actions button,
    .draft-actions a,
    .edit-panel .edit-actions button {
      min-height: 44px;
    }

    .ce-preview-chrome { flex-wrap: wrap; }
  }
</style>
