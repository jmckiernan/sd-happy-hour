---
export interface Props {
  title: string;
  description: string;
  image?: string;
  transparentNav?: boolean;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  transparentNav = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --sunset-start: #FF6B35;
      --sunset-mid: #F7931E;
      --sunset-end: #FFD23F;
      --ocean: #0891B2;
      --ocean-deep: #164E63;
      --palm: #22C55E;
      --night: #0F172A;
      --night-soft: #1E293B;
      --sand: #FFFBF5;
      --sand-warm: #FEF3E2;
      --coral: #FF6B6B;
      --violet: #8B5CF6;

      --font-display: 'Playfair Display', Georgia, serif;
      --font-body: 'Outfit', -apple-system, sans-serif;

      --radius: 24px;
      --radius-sm: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      background: var(--sand);
      color: var(--night);
      min-height: 100vh;
    }

    a { color: inherit; }

    .site-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1400px;
      margin: 0 auto;
      padding: 20px 24px;
      position: sticky;
      top: 0;
      z-index: 200;
      background: rgba(255, 251, 245, 0.85);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    }

    .site-nav .brand {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.35rem;
      text-decoration: none;
      background: linear-gradient(135deg, var(--sunset-start), var(--ocean));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .site-nav .links {
      display: flex;
      gap: 8px;
      font-size: 0.875rem;
    }

    .site-nav .links a {
      text-decoration: none;
      font-weight: 600;
      color: var(--night);
      padding: 8px 18px;
      border-radius: 100px;
      background: var(--sand-warm);
      transition: background-color 0.2s, color 0.2s;
    }

    .site-nav .links a:hover { background: var(--sunset-end); }
    .site-nav .links a[aria-current="page"] { background: var(--night); color: white; }

    /* Overlay variant: floats transparently on top of a hero image/gradient
       instead of sitting in its own bar, so the hero reaches the very top. */
    .site-nav.transparent {
      position: absolute;
      top: 0; left: 0; right: 0;
      background: transparent;
      backdrop-filter: none;
      border-bottom: none;
    }

    .site-nav.transparent .brand {
      background: none;
      -webkit-text-fill-color: white;
      color: white;
      text-shadow: 0 2px 12px rgba(0,0,0,0.35);
    }

    .site-nav.transparent .links a {
      background: rgba(255, 255, 255, 0.92);
      color: var(--night);
    }

    .site-nav.transparent .links a:hover { background: white; }
    .site-nav.transparent .links a[aria-current="page"] { background: var(--night); color: white; }

    footer.site-footer {
      background: var(--night);
      color: white;
      text-align: center;
      padding: 48px 24px;
    }

    footer.site-footer p { opacity: 0.7; font-size: 0.9rem; }
    footer.site-footer a { color: var(--sunset-end); text-decoration: none; font-weight: 600; }
    footer.site-footer a:hover { text-decoration: underline; }
    footer.site-footer .disclaimer { margin-top: 16px; font-size: 0.8rem; opacity: 0.5; }
  </style>
</head>
<body>
  <nav class={`site-nav ${transparentNav ? 'transparent' : ''}`}>
    <a class="brand" href="/">SD Happy Hours</a>
    <div class="links">
      <a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
      <a href="/submit/" aria-current={Astro.url.pathname === '/submit/' ? 'page' : undefined}>Submit a Spot</a>
      <a href="/account/" id="account-nav-link" aria-current={Astro.url.pathname === '/account/' ? 'page' : undefined}>Sign In</a>
      <a href="/admin/" id="admin-nav-link" style="display:none;" aria-current={Astro.url.pathname === '/admin/' ? 'page' : undefined}>Admin</a>
    </div>
  </nav>

  <slot />

  <footer class="site-footer">
    <p>Built by Shane & John in San Diego | <a href="/submit/">Submit a spot</a></p>
    <p class="disclaimer">Happy hour details are community-sourced. Always verify with the venue before visiting.</p>
  </footer>

  <script>
    // Site-wide: reflect sign-in state in the nav, and only show the Admin
    // link when an admin session is active. Runs on every page (this layout
    // wraps all of them) so login status stays consistent site-wide, unlike
    // the original single-page version which only showed this on the homepage.
    (async () => {
      try {
        const res = await fetch('/api/account/me');
        const session = await res.json();
        const link = document.getElementById('account-nav-link');
        if (link && session.authenticated) {
          link.textContent = 'My Spots';
        }
      } catch {
        // Not signed in / KV not configured yet — leave the default "Sign In".
      }

      try {
        const res = await fetch('/api/admin/me');
        const session = await res.json();
        const adminLink = document.getElementById('admin-nav-link') as HTMLElement | null;
        if (adminLink && session.authenticated) {
          adminLink.style.display = '';
        }
      } catch {
        // Not an admin session — leave the Admin link hidden.
      }
    })();
  </script>
</body>
</html>
