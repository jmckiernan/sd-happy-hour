---
export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  structuredData?: import('../lib/seo').JsonLd | import('../lib/seo').JsonLd[];
  transparentNav?: boolean;
  analyticsContentType?: 'blog_index' | 'blog_post';
  analyticsContentSlug?: string;
  analyticsContentTitle?: string;
  analyticsContentId?: string;
}

const {
  title,
  description,
  image = '/images/backdrop.webp',
  imageAlt = 'San Diego sunset and happy hour drinks',
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex,
  structuredData = [],
  transparentNav = false,
  analyticsContentType,
  analyticsContentSlug,
  analyticsContentTitle,
  analyticsContentId,
} = Astro.props;

import { ClientRouter } from 'astro:transitions';
import AdminStyles from '../components/AdminStyles.astro';
import AppDialog from '../components/AppDialog.astro';
import { organizationSchema, serializeJsonLd, SITE_NAME, websiteSchema } from '../lib/seo';
import { getSession } from '../lib/session';
import { isAdminEmail } from '../lib/admins';
import { getUserById } from '../lib/store';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Check auth state server-side to render correct nav immediately (no flash)
let isAuthenticated = false;
let isAdmin = false;
try {
  const session = await getSession(Astro.cookies);
  if (session?.userId) {
    isAuthenticated = true;
    const user = await getUserById(session.userId);
    if (user) {
      isAdmin = isAdminEmail(user.email);
    }
  }
} catch {
  // Auth check failed - render as signed out (safe default)
}
const privatePathPrefixes = ['/account/', '/admin/', '/alerts/', '/lists/', '/restaurant/'];
const privateExactPaths = ['/account', '/admin', '/alerts', '/lists', '/restaurant', '/submit', '/submit/'];
const routeIsPrivate = privateExactPaths.includes(Astro.url.pathname)
  || privatePathPrefixes.some((prefix) => Astro.url.pathname.startsWith(prefix));
const shouldNoIndex = noindex ?? routeIsPrivate;
const pageSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemas = shouldNoIndex ? [] : [organizationSchema, websiteSchema, ...pageSchemas];

// The homepage owns its own full-bleed sunset scene (stars, sun, ocean) from
// the very top of the page, so the site-wide backdrop is suppressed there —
// layering faint contours and sun rays over that hero would only muddy it.
const isHome = Astro.url.pathname === '/';
// Soft-nav + persisted merchant chrome only on restaurant workspace routes.
const isRestaurantRoute = Astro.url.pathname === '/restaurant'
  || Astro.url.pathname.startsWith('/restaurant/');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {isRestaurantRoute && <ClientRouter fallback="swap" />}
  <meta name="description" content={description} />
  <meta
    name="robots"
    content={shouldNoIndex
      ? 'noindex,follow'
      : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
  />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} Blog`} href="/rss.xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta property="og:image:alt" content={imageAlt} />
  {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:image:alt" content={imageAlt} />

  {schemas.map((schema) => <script type="application/ld+json" set:html={serializeJsonLd(schema)} />)}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&family=Bricolage+Grotesque:wght@600;700;800&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --sunset-start: #FF6B35;
      --sunset-mid: #F7931E;
      --sunset-end: #FFD23F;
      --ocean: #0891B2;
      --ocean-deep: #164E63;
      --palm: #22C55E;
      --night: #0F172A;
      --night-soft: #1E293B;
      --sand: #FFFBF5;
      --sand-warm: #FEF3E2;
      --coral: #FF6B6B;
      --violet: #8B5CF6;

      --font-display: 'Playfair Display', Georgia, serif;
      --font-body: 'Outfit', -apple-system, sans-serif;

      --radius: 24px;
      --radius-sm: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      background: var(--sand);
      color: var(--night);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a { color: inherit; }

    /* One branded loading treatment for every page. Each loader is assigned
       one of the animated drink SVGs by the site-wide script below. */
    .drink-loader {
      display: inline-block;
      filter: drop-shadow(0 5px 7px rgba(15, 23, 42, 0.12));
      flex: 0 0 auto;
      height: 46px;
      object-fit: contain;
      vertical-align: middle;
      width: 40px;
    }
    .drink-loader--sm { height: 26px; width: 22px; }
    .drink-loader--lg { height: 72px; width: 62px; }
    .drink-loader--inline { margin-right: 8px; }

    .site-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      max-width: 1400px;
      width: 100%;
      margin: 0 auto;
      padding: 20px 24px;
      position: relative;
      z-index: 200;
      background: transparent;
      flex-shrink: 0;
    }

    .site-nav .links a[aria-current="page"] {
      cursor: default;
      pointer-events: none;
    }

    /* Plain block wrapper (NOT itself a flex container) so every page's own
       max-width + margin: auto centering keeps working unmodified — only
       this single wrapper needs to be a flex item of body, to grow and
       push the footer to the bottom on short pages. */
    .page-content {
      flex: 1 0 auto;
      width: 100%;
    }

    /* ---------------------------------------------------------------------
       Site backdrop (every page except the homepage).

       A single semi-transparent San Diego beach-and-happy-hour scene sits
       behind all content, in place of the old per-page gradient header
       bands. The image itself is generated and promoted by
       scripts/generate-backdrop.js — see that file for the prompt and for
       the other art directions.

       It's a <body> child and it's positioned, which matters twice over: it
       keeps it out of body's column flex flow (an unpositioned div would
       become a flex item and take up real space), and negative z-index puts
       it behind every page's content while still painting on top of the sand
       canvas background. It isn't interactive, so it's aria-hidden with
       pointer-events: none.

       Fixed rather than scrolling, so the horizon in the scene stays put and
       the page reads as a translucent sheet laid over a poster.
       --------------------------------------------------------------------- */
    .sd-backdrop {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      /* Checked by compositing the image over --sand with real header text
         and a form card over it: legible with room to spare at 0.30, a bare
         whisper at 0.18. This sits between the two. */
      opacity: 0.26;
      background-image: url('/images/backdrop.webp');
      background-repeat: no-repeat;
      background-position: center center;
      background-size: cover;
    }

    /* On a portrait viewport, `cover` on a 16:9 scene crops so hard that the
       palms and the glasses — the whole point of the image — fall outside
       the frame entirely. Show the full width instead and let it sit as a
       band in the upper part of the page, with plain sand below it. */
    @media (max-aspect-ratio: 1 / 1) {
      .sd-backdrop {
        background-size: 100% auto;
        background-position: center 24%;
      }
    }

    /* ---------------------------------------------------------------------
       Shared page header.

       One centred, background-free header for every page, matching the blog
       index (which is where this treatment started). Defined once here
       rather than copied per page so the pages can't drift apart again the
       way the five gradient headers did.
       --------------------------------------------------------------------- */
    .page-header {
      max-width: 900px;
      margin: 0 auto;
      padding: 48px 24px 8px;
      text-align: center;
      position: relative;
    }

    .page-header h1 {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 6vw, 3.25rem);
      line-height: 1.12;
      margin-bottom: 14px;
    }

    .page-header p {
      color: var(--night-soft);
      font-size: 1.1rem;
      line-height: 1.6;
      max-width: 640px;
      margin: 0 auto;
    }

    @media (max-width: 640px) {
      .page-header { padding: 28px 20px 4px; }
      .page-header p { font-size: 1rem; }
    }

    .site-nav .brand {
      font-family: 'Bricolage Grotesque', var(--font-display);
      font-weight: 800;
      font-size: 1.35rem;
      text-decoration: none;
      color: var(--night);
    }

    .site-nav .links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: flex-end;
      font-size: 0.875rem;
    }

    .mobile-nav-toggle,
    .mobile-nav-backdrop {
      display: none;
    }

    .site-nav .links a {
      text-decoration: none;
      font-weight: 600;
      color: var(--night);
      padding: 8px 18px;
      border-radius: 100px;
      background: var(--sand-warm);
      transition: background-color 0.2s, color 0.2s;
    }

    .site-nav .links a:hover { background: var(--sunset-end); }
    .site-nav .links a[aria-current="page"] { background: var(--night); color: white; }

    /* Venue-owner link — distinct from the consumer-facing nav pills. */
    .site-nav .links a#restaurant-nav-link {
      background: rgba(255, 107, 53, 0.16);
      color: #C2410C;
    }
    .site-nav .links a#restaurant-nav-link:hover {
      background: rgba(255, 107, 53, 0.28);
    }
    .site-nav .links a#restaurant-nav-link[aria-current="page"] {
      background: rgba(255, 107, 53, 0.92);
      color: white;
    }
    .site-nav .links a#restaurant-nav-link[aria-current="page"]:hover {
      background: var(--sunset-start);
    }

    /* Admin-only links (visible only to signed-in admin emails) get a
       distinct teal tint so they read as different from the regular nav. */
    .site-nav .links a#admin-nav-link {
      background: rgba(8, 145, 178, 0.14);
      color: var(--ocean-deep);
    }
    .site-nav .links a#admin-nav-link:hover {
      background: rgba(8, 145, 178, 0.26);
    }
    .site-nav .links a#admin-nav-link[aria-current="page"] {
      background: var(--night);
      color: white;
    }

    /* Overlay variant: floats transparently on top of a hero image/gradient
       instead of sitting in its own bar, so the hero reaches the very top. */
    .site-nav.transparent {
      position: absolute;
      top: 0; left: 0; right: 0;
      background: transparent;
      backdrop-filter: none;
      border-bottom: none;
    }

    .site-nav.transparent .brand {
      background: none;
      -webkit-text-fill-color: white;
      color: white;
      text-shadow: 0 2px 12px rgba(0,0,0,0.35);
    }

    .site-nav.transparent .links a {
      background: rgba(255, 255, 255, 0.92);
      color: var(--night);
    }

    .site-nav.transparent .links a:hover { background: white; }
    .site-nav.transparent .links a[aria-current="page"] { background: var(--night); color: white; }
    .site-nav.transparent .links a#restaurant-nav-link {
      background: rgba(255, 107, 53, 0.92);
      color: white;
    }
    .site-nav.transparent .links a#restaurant-nav-link:hover {
      background: var(--sunset-start);
    }
    .site-nav.transparent .links a#restaurant-nav-link[aria-current="page"] {
      background: rgba(255, 107, 53, 0.92);
      color: white;
    }
    .site-nav.transparent .links a#restaurant-nav-link[aria-current="page"]:hover {
      background: var(--sunset-start);
    }

    @media (max-width: 720px) {
      .site-nav {
        align-items: center;
        flex-direction: row;
        min-height: 72px;
        padding: max(14px, env(safe-area-inset-top)) 16px 14px;
      }

      .site-nav .brand {
        font-size: 1.2rem;
        max-width: calc(100% - 64px);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .site-nav .mobile-nav-toggle {
        align-items: center;
        appearance: none;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(32, 18, 56, 0.12);
        border-radius: 14px;
        color: var(--night);
        cursor: pointer;
        display: inline-flex;
        flex: 0 0 46px;
        height: 46px;
        justify-content: center;
        margin-left: auto;
        padding: 0;
        position: relative;
        width: 46px;
        z-index: 303;
      }

      /* Page-level form/button themes also see slotted layout controls. Keep
         the shared menu button deterministic so account/admin button rules
         cannot shrink its middle bar or recolor it after a tap. */
      .site-nav .mobile-nav-toggle:hover,
      .site-nav .mobile-nav-toggle:focus-visible {
        background: rgba(255, 255, 255, 0.9);
      }
      .site-nav .mobile-nav-toggle:focus-visible {
        border-color: var(--ocean);
        box-shadow: 0 0 0 4px rgba(8, 145, 178, .14);
        outline: none;
      }

      .mobile-nav-toggle-icon,
      .mobile-nav-toggle-icon::before,
      .mobile-nav-toggle-icon::after {
        background: currentColor;
        border-radius: 999px;
        content: '';
        display: block;
        height: 2px;
        position: absolute;
        transition: transform 0.2s ease, opacity 0.2s ease;
        width: 21px;
      }

      .mobile-nav-toggle-icon {
        flex: 0 0 21px;
        position: relative;
      }

      .mobile-nav-toggle-icon::before { transform: translateY(-7px); }
      .mobile-nav-toggle-icon::after { transform: translateY(7px); }
      .mobile-nav-toggle[aria-expanded="true"] .mobile-nav-toggle-icon { background: transparent; }
      .mobile-nav-toggle[aria-expanded="true"] .mobile-nav-toggle-icon::before { transform: rotate(45deg); }
      .mobile-nav-toggle[aria-expanded="true"] .mobile-nav-toggle-icon::after { transform: rotate(-45deg); }

      .site-nav.transparent .mobile-nav-toggle,
      .site-nav.transparent .mobile-nav-toggle:hover,
      .site-nav.transparent .mobile-nav-toggle:focus-visible {
        background: rgba(15, 23, 42, 0.44);
        border-color: rgba(255, 255, 255, 0.48);
        color: white;
        backdrop-filter: blur(12px);
      }

      .mobile-nav-backdrop {
        appearance: none;
        background: rgba(15, 23, 42, 0.5);
        border: 0;
        border-radius: 0;
        box-shadow: none;
        cursor: pointer;
        display: block;
        inset: 0;
        opacity: 0;
        pointer-events: none;
        position: fixed;
        padding: 0;
        transition: opacity 0.2s ease;
        visibility: hidden;
        z-index: 301;
      }

      .site-nav .links {
        align-content: flex-start;
        background: #fffdfa;
        box-shadow: -18px 0 54px rgba(15, 23, 42, 0.22);
        flex-direction: column;
        flex-wrap: nowrap;
        gap: 8px;
        inset: 0 0 0 auto;
        justify-content: flex-start;
        margin: 0;
        max-width: 340px;
        overflow-x: hidden;
        overflow-y: auto;
        padding: calc(max(82px, env(safe-area-inset-top) + 68px)) 20px max(28px, env(safe-area-inset-bottom));
        pointer-events: none;
        position: fixed;
        scrollbar-width: thin;
        transform: translateX(104%);
        transition: transform 0.24s ease, visibility 0.24s ease;
        visibility: hidden;
        width: min(86vw, 340px);
        z-index: 302;
      }

      .site-nav .links a {
        align-items: center;
        display: inline-flex;
        flex: 0 0 auto;
        font-size: 1rem;
        justify-content: space-between;
        min-height: 44px;
        padding: 11px 14px;
        width: 100%;
      }

      .site-nav.transparent .links a {
        background: var(--sand-warm);
        color: var(--night);
      }

      .site-nav.is-mobile-open .links {
        pointer-events: auto;
        transform: translateX(0);
        visibility: visible;
      }

      .site-nav.is-mobile-open .mobile-nav-backdrop {
        opacity: 1;
        pointer-events: auto;
        visibility: visible;
      }

      body.mobile-menu-open {
        overflow: hidden;
      }

      /* iOS Safari zooms the visual viewport when a focused form control is
         smaller than 16px. Keep every text-like control stable across the
         public, account, merchant, and admin surfaces. */
      input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
      select,
      textarea {
        font-size: 16px !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .mobile-nav-toggle-icon,
      .mobile-nav-toggle-icon::before,
      .mobile-nav-toggle-icon::after,
      .mobile-nav-backdrop,
      .site-nav .links { transition: none; }
    }

    footer.site-footer {
      background: var(--night);
      color: white;
      text-align: center;
      padding: 48px 24px max(48px, env(safe-area-inset-bottom));
      flex-shrink: 0;
    }

    footer.site-footer p { opacity: 0.7; font-size: 0.9rem; }
    footer.site-footer a { color: var(--sunset-end); text-decoration: none; font-weight: 600; }
    footer.site-footer a:hover { text-decoration: underline; }
    footer.site-footer .disclaimer { margin-top: 16px; font-size: 0.8rem; opacity: 0.5; }
  </style>
</head>
<body
  data-analytics-content-type={analyticsContentType}
  data-analytics-content-slug={analyticsContentSlug}
  data-analytics-content-title={analyticsContentTitle}
  data-analytics-content-id={analyticsContentId}
>
  {!isHome && <div class="sd-backdrop" aria-hidden="true"></div>}

  <nav class={`site-nav ${transparentNav ? 'transparent' : ''}`}>
    <a class="brand" href="/">{SITE_NAME}</a>
    <button
      class="mobile-nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-links"
      aria-label="Open menu"
    >
      <span class="mobile-nav-toggle-icon" aria-hidden="true"></span>
    </button>
    <button class="mobile-nav-backdrop" type="button" aria-label="Close menu" tabindex="-1"></button>
    <div class="links" id="site-nav-links">
      <a href="/live-deals/" aria-current={Astro.url.pathname === '/live-deals/' ? 'page' : undefined}>Live Deals</a>
      <a href="/neighborhoods/" aria-current={Astro.url.pathname.startsWith('/neighborhoods/') ? 'page' : undefined}>Neighborhoods</a>
      <a href="/blog/" aria-current={Astro.url.pathname === '/blog/' ? 'page' : undefined}>Blog</a>
      <a href="/submit/" aria-current={Astro.url.pathname === '/submit/' ? 'page' : undefined}>Submit a Spot</a>
      <a href="/restaurant/" id="restaurant-nav-link" aria-current={isRestaurantRoute ? 'page' : undefined}>For Restaurants</a>
      <a href="/account/" id="account-nav-link" aria-current={Astro.url.pathname === '/account/' ? 'page' : undefined}>{isAuthenticated ? 'My Stuff' : 'Sign In'}</a>
      <a href="/admin/" id="admin-nav-link" data-admin-only style={isAdmin ? '' : 'display:none;'} aria-current={Astro.url.pathname === '/admin/' ? 'page' : undefined}>Admin</a>
    </div>
  </nav>

  <div class="page-content">
    {(Astro.url.pathname === '/admin' || Astro.url.pathname.startsWith('/admin/')) && <AdminStyles />}
    <slot />
  </div>

  <AppDialog />

  <footer class="site-footer">
    <p>Built by Shane & John in San Diego | <a href="/submit/">Submit a spot</a> · <a href="/report-a-bug/">Report a bug</a> · <a href="/features/">Request a feature</a></p>
    <p class="footer-discovery"><a href="/neighborhoods/">Browse neighborhoods</a> · <a href="/neighborhoods/little-italy/">Little Italy</a> · <a href="/neighborhoods/north-park/">North Park</a> · <a href="/neighborhoods/pacific-beach/">Pacific Beach</a> · <a href="/neighborhoods/la-jolla/">La Jolla</a> · <a href="/neighborhoods/hillcrest/">Hillcrest</a> · <a href="/blog/">Local guides</a> · <a href="/about/">About &amp; editorial policy</a></p>
    <p class="disclaimer">Happy hour details are community-sourced. Always verify with the venue before visiting.</p>
  </footer>

  <script>
    const mobileNav = document.querySelector<HTMLElement>('.site-nav');
    const mobileNavToggle = mobileNav?.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
    const mobileNavBackdrop = mobileNav?.querySelector<HTMLButtonElement>('.mobile-nav-backdrop');
    const mobileNavLinks = mobileNav?.querySelector<HTMLElement>('.links');
    const mobileNavMedia = window.matchMedia('(max-width: 720px)');

    function setMobileNavOpen(open: boolean, restoreFocus = false) {
      if (!mobileNav || !mobileNavToggle) return;
      const shouldOpen = open && mobileNavMedia.matches;
      mobileNav.classList.toggle('is-mobile-open', shouldOpen);
      mobileNavToggle.setAttribute('aria-expanded', String(shouldOpen));
      mobileNavToggle.setAttribute('aria-label', shouldOpen ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('mobile-menu-open', shouldOpen);
      if (!shouldOpen && restoreFocus) mobileNavToggle.focus();
    }

    mobileNavToggle?.addEventListener('click', () => {
      setMobileNavOpen(mobileNavToggle.getAttribute('aria-expanded') !== 'true');
    });
    mobileNavBackdrop?.addEventListener('click', () => setMobileNavOpen(false, true));
    mobileNavLinks?.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setMobileNavOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileNav?.classList.contains('is-mobile-open')) {
        setMobileNavOpen(false, true);
        return;
      }
      if (event.key === 'Tab' && mobileNav?.classList.contains('is-mobile-open') && mobileNavToggle && mobileNavLinks) {
        const links = [...mobileNavLinks.querySelectorAll<HTMLAnchorElement>('a')]
          .filter((link) => getComputedStyle(link).display !== 'none');
        const last = links.at(-1) || mobileNavToggle;
        if (event.shiftKey && document.activeElement === mobileNavToggle) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          mobileNavToggle.focus();
        }
      }
    });
    mobileNavMedia.addEventListener('change', () => setMobileNavOpen(false));

    const DRINK_LOADER_IMAGES = [
      '/cocktail-loader.svg',
      '/beer-loader.svg',
      '/wine-loader.svg',
    ] as const;

    function randomDrinkLoaderImage() {
      return DRINK_LOADER_IMAGES[Math.floor(Math.random() * DRINK_LOADER_IMAGES.length)];
    }

    function assignDrinkLoaderImage(image: HTMLImageElement) {
      if (image.dataset.drinkLoaderAssigned === 'true') return;
      image.src = randomDrinkLoaderImage();
      image.dataset.drinkLoaderAssigned = 'true';
    }

    function syncPseudoDrinkLoader(element: HTMLElement) {
      const isLoading = element.classList.contains('is-loading');
      const wasAssigned = element.dataset.drinkLoaderLoading === 'true';

      if (isLoading && !wasAssigned) {
        element.style.setProperty('--drink-loader-image', `url("${randomDrinkLoaderImage()}")`);
        element.dataset.drinkLoaderLoading = 'true';
      } else if (!isLoading && wasAssigned) {
        element.style.removeProperty('--drink-loader-image');
        delete element.dataset.drinkLoaderLoading;
      }
    }

    function syncDrinkLoaders(root: Element) {
      if (root.matches('img.drink-loader')) {
        assignDrinkLoaderImage(root as HTMLImageElement);
      }
      for (const image of root.querySelectorAll<HTMLImageElement>('img.drink-loader')) {
        assignDrinkLoaderImage(image);
      }

      if (root.matches('.is-loading')) syncPseudoDrinkLoader(root as HTMLElement);
      for (const element of root.querySelectorAll<HTMLElement>('.is-loading')) {
        syncPseudoDrinkLoader(element);
      }
    }

    syncDrinkLoaders(document.documentElement);

    // Loading messages are often rendered with innerHTML after a fetch begins.
    // Observe both those additions and loading-class transitions so each new
    // loading cycle gets a fresh random drink without reacting to our own src,
    // data-attribute, or custom-property updates.
    const drinkLoaderObserver = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.type === 'childList') {
          for (const node of mutation.addedNodes) {
            if (node instanceof Element) syncDrinkLoaders(node);
          }
          continue;
        }

        const element = mutation.target as Element;
        if (element.matches('img.drink-loader')) {
          assignDrinkLoaderImage(element as HTMLImageElement);
        } else if (element instanceof HTMLImageElement) {
          delete element.dataset.drinkLoaderAssigned;
        }
        syncPseudoDrinkLoader(element as HTMLElement);
      }
    });

    drinkLoaderObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
      childList: true,
      subtree: true,
    });

    // Blog analytics is optional and only belongs on blog pages. Load it in
    // its own asynchronous boundary so a blocked/stale analytics dependency
    // can never prevent the site-wide auth navigation below from starting.
    if (window.location.pathname.startsWith('/blog/')) {
      import('../lib/browserAnalytics')
        .then(({ initBrowserAnalytics }) => initBrowserAnalytics())
        .catch(() => {
          // Analytics must never interfere with account or navigation UI.
        });
    }

    // Site-wide: reflect sign-in state in the nav, and only show the Admin
    // links when an admin session is active.
    //
    // For SSR pages: server renders correct state from session cookie.
    // For prerendered pages: we use localStorage to cache the last known
    // auth state and apply it synchronously on load (no flash).
    //
    // Login/logout on account.astro dispatches AUTH_CHANGED_EVENT to update
    // the nav without a page reload.
    const AUTH_CHANGED_EVENT = 'sdhh:auth-changed';
    const AUTH_CACHE_KEY = 'sdhh_auth_nav';

    interface AuthNavState {
      authenticated: boolean;
      isAdmin: boolean;
    }

    function applyAuthNav(state: AuthNavState) {
      const accountLink = document.getElementById('account-nav-link');
      if (accountLink) accountLink.textContent = state.authenticated ? 'My Stuff' : 'Sign In';

      for (const el of document.querySelectorAll<HTMLElement>('[data-admin-only]')) {
        el.style.display = state.isAdmin ? '' : 'none';
      }
    }

    function getCachedAuthState(): AuthNavState | null {
      try {
        const cached = localStorage.getItem(AUTH_CACHE_KEY);
        if (!cached) return null;
        return JSON.parse(cached);
      } catch {
        return null;
      }
    }

    function cacheAuthState(state: AuthNavState) {
      try {
        localStorage.setItem(AUTH_CACHE_KEY, JSON.stringify(state));
      } catch {
        // localStorage unavailable
      }
    }

    async function getAuthNavState(): Promise<AuthNavState> {
      const { fetchBrowserSession } = await import('../lib/browserSession');
      const session = await fetchBrowserSession();
      const state = {
        authenticated: session.authenticated,
        isAdmin: session.isAdmin,
      };
      cacheAuthState(state);
      return state;
    }

    let authSyncVersion = 0;
    async function syncAuthNav() {
      const version = ++authSyncVersion;
      const state = await getAuthNavState();
      if (version !== authSyncVersion) return;
      applyAuthNav(state);
    }

    // For prerendered pages, apply cached auth state immediately (sync, no flash).
    // SSR pages already have correct state from server, so this is a no-op unless
    // the session changed since page was rendered (edge case).
    const cached = getCachedAuthState();
    if (cached) applyAuthNav(cached);
    async function touchActivity() {
      if (document.visibilityState !== 'visible') return;
      try {
        await fetch('/api/activity', { method: 'POST', keepalive: true });
      } catch {
        // Activity reporting must never interfere with navigation or auth.
      }
    }
    touchActivity();
    window.setInterval(touchActivity, 5 * 60 * 1000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') touchActivity();
    });
    window.addEventListener(AUTH_CHANGED_EVENT, (event) => {
      const detail = (event as CustomEvent<Partial<AuthNavState>>).detail;
      if (typeof detail?.authenticated === 'boolean' && typeof detail?.isAdmin === 'boolean') {
        authSyncVersion += 1;
        applyAuthNav({ authenticated: detail.authenticated, isAdmin: detail.isAdmin });
      } else {
        syncAuthNav();
      }
      touchActivity();
    });
  </script>
</body>
</html>
