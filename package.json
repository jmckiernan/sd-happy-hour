    "import:venues:refresh-happy-hour": "node --env-file-if-exists=.env.local scripts/import-google-venues/refresh-happy-hour.mjs",
    "import:venues:compress-deals": "node --env-file-if-exists=.env.local scripts/import-google-venues/compress-deals.mjs",
    "fix:all-day-windows": "node scripts/import-google-venues/bound-all-day-windows.mjs",
    "menus:render": "node scripts/import-google-venues/render-menu-boards.mjs",
    "menus:attach-local-pdfs": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-google-venues/attach-local-hh-menu-pdfs.mjs",
    "audit:deals-menus": "node scripts/import-google-venues/audit-deal-menu-quality.mjs",
    "audit:empty-listings": "node scripts/import-google-venues/audit-empty-listings.mjs",
    "recover:empty-listings": "node scripts/import-google-venues/recover-empty-listings.mjs",
    "transcribe:empty-listings": "node scripts/import-google-venues/transcribe-window-only-offers.mjs",
    "menus:audit": "node scripts/import-google-venues/audit-menu-coverage.mjs",
    "menus:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-happy-hour-menus.mjs",
