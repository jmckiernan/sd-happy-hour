{
  "name": "sd-happy-hours",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ulimit -n 65535 2>/dev/null; astro dev",
    "dev:netlify": "ulimit -n 65535 2>/dev/null; astro dev --port 8888",
    "start": "ulimit -n 65535 2>/dev/null; astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:data": "node scripts/validate-data.js",
    "audit:county": "node scripts/import-google-venues/audit-county.mjs",
    "audit:missed": "node scripts/import-google-venues/audit-missed-happy-hours.mjs",
    "recover:missed": "node --env-file-if-exists=.env.local scripts/import-google-venues/recover-missed.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:venues": "node --env-file-if-exists=.env.local scripts/audit-venues.mjs",
    "backfill:google-hh": "node scripts/backfill-google-happy-hour.mjs",
    "test:venue-audit": "node tests/venue-audit.test.mjs",
    "browser:warm": "node scripts/import-google-venues/warm-browser-profile.mjs",
    "import:venues:refresh-happy-hour": "node --env-file-if-exists=.env.local scripts/import-google-venues/refresh-happy-hour.mjs",
    "import:venues:compress-deals": "node --env-file-if-exists=.env.local scripts/import-google-venues/compress-deals.mjs",
    "menus:render": "node scripts/import-google-venues/render-menu-boards.mjs",
    "menus:audit": "node scripts/import-google-venues/audit-menu-coverage.mjs",
    "menus:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-happy-hour-menus.mjs",
    "pull:images": "node scripts/pull-images.js",
    "fetch:vibe-images": "node scripts/fetch-vibe-images.js",
    "generate:backdrop": "node --env-file-if-exists=.env scripts/generate-backdrop.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed:merchant-analytics": "node --env-file-if-exists=.env scripts/seed-merchant-analytics.mjs",
    "import:venues": "node --env-file-if-exists=.env scripts/import-google-venues/run.mjs",
    "import:venues:discover": "node --env-file-if-exists=.env scripts/import-google-venues/discover.mjs",
    "import:venues:enrich": "node --env-file-if-exists=.env scripts/import-google-venues/enrich.mjs",
    "import:venues:extract": "node --env-file-if-exists=.env scripts/import-google-venues/extract-happy-hour.mjs",
    "import:venues:stage": "node --env-file-if-exists=.env scripts/import-google-venues/build-staging.mjs",
    "import:venues:merge": "node --env-file-if-exists=.env scripts/import-google-venues/merge.mjs",
    "import:venues:cleanup": "node --env-file-if-exists=.env scripts/import-google-venues/cleanup-listings.mjs",
    "import:venues:refresh-deals": "node --env-file-if-exists=.env scripts/import-google-venues/refresh-deals.mjs",
    "import:venues:classify-neighborhoods": "node --env-file-if-exists=.env scripts/import-google-venues/classify-neighborhoods.mjs",
    "test": "npm run validate:data && npm run test:images && npm run test:venue-management && npm run test:shared-lists && npm run test:user-intelligence && npm run test:blog-analytics && npm run test:content-engine && npm run test:live-promotions && npm run test:live-promotions:phase3:ui && npm run test:merchant-reporting && npm run test:live-promotions:migration:guard && npm run test:live-promotions:phase2:db:guard",
    "test:images": "esbuild tests/image-sanitize.test.mjs --bundle --platform=node --format=esm --outfile=.data/tests/image-sanitize.bundle.mjs && node .data/tests/image-sanitize.bundle.mjs",
    "test:venue-management": "node tests/build-venue-management-test.mjs && node .data/tests/venue-management.bundle.mjs",
    "test:shared-lists": "node tests/build-shared-lists-test.mjs && node .data/tests/shared-lists.bundle.mjs && node tests/unified-saved-lists-migration.test.mjs",
    "test:user-intelligence": "node tests/build-admin-user-intelligence-test.mjs && node .data/tests/admin-user-intelligence.bundle.mjs",
    "test:blog-analytics": "esbuild tests/blog-analytics.test.mjs --bundle --platform=node --format=esm --outfile=.data/tests/blog-analytics.bundle.mjs && node .data/tests/blog-analytics.bundle.mjs",
    "test:content-engine": "esbuild tests/content-engine.test.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env.PROD=false --outfile=.data/tests/content-engine.bundle.mjs && node --test .data/tests/content-engine.bundle.mjs",
    "test:live-promotions": "esbuild tests/live-promotions.test.mjs --bundle --platform=node --format=esm --outfile=.data/tests/live-promotions.bundle.mjs && node .data/tests/live-promotions.bundle.mjs",
    "test:live-promotions:phase3:ui": "esbuild tests/live-promotions-phase3-ui.test.mjs --bundle --platform=node --format=esm --outfile=.data/tests/live-promotions-phase3-ui.bundle.mjs && node .data/tests/live-promotions-phase3-ui.bundle.mjs",
    "test:merchant-reporting": "esbuild tests/merchant-reporting.test.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env.PROD=false --outfile=.data/tests/merchant-reporting.bundle.mjs && node .data/tests/merchant-reporting.bundle.mjs",
    "test:live-promotions:phase3:e2e": "playwright test",
    "test:live-promotions:migration:guard": "node tests/live-promotions-migration.test.mjs --guard-only",
    "test:live-promotions:migration": "node tests/live-promotions-migration.test.mjs",
    "test:live-promotions:phase2:db:guard": "esbuild tests/live-promotions-phase2-db.test.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env.PROD=false --outfile=.data/tests/live-promotions-phase2-db.bundle.mjs && node .data/tests/live-promotions-phase2-db.bundle.mjs --guard-only",
    "test:live-promotions:phase2:db": "esbuild tests/live-promotions-phase2-db.test.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env.PROD=false --outfile=.data/tests/live-promotions-phase2-db.bundle.mjs && node .data/tests/live-promotions-phase2-db.bundle.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "SD Happy Hours - real-time San Diego happy hour directory, blog, and venue pages.",
  "dependencies": {
    "@astrojs/netlify": "^8.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "@netlify/blobs": "^10.7.11",
    "@netlify/functions": "^5.3.0",
    "@octokit/rest": "^21.0.2",
    "astro": "^7.1.3",
    "google-auth-library": "^10.9.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "posthog-js": "^1.418.16"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@playwright/test": "^1.62.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "netlify-cli": "^27.0.1",
    "nodemon": "^3.1.14",
    "pdfjs-dist": "^6.2.108"
  }
}
