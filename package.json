{
  "name": "sd-happy-hours",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:netlify": "netlify dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:data": "node scripts/validate-data.js",
    "pull:images": "node scripts/pull-images.js",
    "fetch:vibe-images": "node scripts/fetch-vibe-images.js",
    "generate:backdrop": "node --env-file-if-exists=.env scripts/generate-backdrop.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "npm run validate:data && npm run test:images && npm run test:venue-management && npm run test:live-promotions && npm run test:live-promotions:phase3:ui && npm run test:live-promotions:migration:guard && npm run test:live-promotions:phase2:db:guard",
    "test:images": "esbuild tests/image-sanitize.test.mjs --bundle --platform=node --format=esm --outfile=.data/tests/image-sanitize.bundle.mjs && node .data/tests/image-sanitize.bundle.mjs",
    "test:venue-management": "node tests/build-venue-management-test.mjs && node .data/tests/venue-management.bundle.mjs",
    "test:live-promotions": "esbuild tests/live-promotions.test.mjs --bundle --platform=node --format=esm --outfile=.data/tests/live-promotions.bundle.mjs && node .data/tests/live-promotions.bundle.mjs",
    "test:live-promotions:phase3:ui": "esbuild tests/live-promotions-phase3-ui.test.mjs --bundle --platform=node --format=esm --outfile=.data/tests/live-promotions-phase3-ui.bundle.mjs && node .data/tests/live-promotions-phase3-ui.bundle.mjs",
    "test:live-promotions:phase3:e2e": "playwright test",
    "test:live-promotions:migration:guard": "node tests/live-promotions-migration.test.mjs --guard-only",
    "test:live-promotions:migration": "node tests/live-promotions-migration.test.mjs",
    "test:live-promotions:phase2:db:guard": "esbuild tests/live-promotions-phase2-db.test.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env.PROD=false --outfile=.data/tests/live-promotions-phase2-db.bundle.mjs && node .data/tests/live-promotions-phase2-db.bundle.mjs --guard-only",
    "test:live-promotions:phase2:db": "esbuild tests/live-promotions-phase2-db.test.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env.PROD=false --outfile=.data/tests/live-promotions-phase2-db.bundle.mjs && node .data/tests/live-promotions-phase2-db.bundle.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "SD Happy Hours - real-time San Diego happy hour directory, blog, and venue pages.",
  "dependencies": {
    "@astrojs/netlify": "^8.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "@netlify/blobs": "^10.7.11",
    "@netlify/functions": "^5.3.0",
    "@octokit/rest": "^21.0.2",
    "astro": "^7.1.3",
    "google-auth-library": "^10.9.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.21.0",
    "netlify-cli": "^27.0.1",
    "nodemon": "^3.1.14"
  }
}
