{
  "name": "sd-happy-hours",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ulimit -n 65535 2>/dev/null; astro dev",
    "dev:netlify": "ulimit -n 65535 2>/dev/null; export NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=4096}\"; astro dev --port 8888",
    "start": "ulimit -n 65535 2>/dev/null; astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:data": "node scripts/validate-data.js",
    "import:stubs": "node scripts/import-google-venues/import-claimable-stubs.mjs",
    "purge:chains": "node scripts/import-google-venues/purge-chains.mjs",
    "clean:deals": "node scripts/import-google-venues/clean-deal-text.mjs",
    "rederive:deal-types": "node scripts/import-google-venues/rederive-deal-types.mjs",
    "rederive:venue-kind": "node scripts/import-google-venues/rederive-venue-kind.mjs",
    "audit:county": "node scripts/import-google-venues/audit-county.mjs",
    "audit:missed": "node scripts/import-google-venues/audit-missed-happy-hours.mjs",
    "recover:missed": "node --env-file-if-exists=.env.local scripts/import-google-venues/recover-missed.mjs",
    "seed:locators": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/import-google-venues/seed-from-locators.mjs",
    "discover:adaptive": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/import-google-venues/discover-adaptive.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:venues": "node --env-file-if-exists=.env.local scripts/audit-venues.mjs",
    "newsletters:inventory": "node scripts/newsletters/build-inventory.mjs",
    "newsletters:signup": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/newsletters/signup.mjs",
    "newsletters:sync": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/newsletters/sync-inventory.mjs",
    "backfill:google-hh": "node scripts/backfill-google-happy-hour.mjs",
    "test:venue-audit": "node tests/venue-audit.test.mjs",
    "test:no-overnight-windows": "node tests/no-overnight-windows.test.mjs",
    "test:menu-price": "node --test tests/menu-price.test.mjs",
    "test:venue-id-bands": "node tests/venue-id-bands.test.mjs",
    "test:venue-crawl:live": "node tests/venue-crawl-live.test.mjs",
