    "images:review": "node scripts/import-google-venues/render-venue-image-review.mjs",
    "images:ai": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/import-google-venues/backfill-ai-venue-images.mjs",
    "test:venue-images": "node --test tests/venue-images.test.mjs",
    "generate:backdrop": "node --env-file-if-exists=.env scripts/generate-backdrop.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed:merchant-analytics": "node --env-file-if-exists=.env scripts/seed-merchant-analytics.mjs",
    "seed:bot-traffic": "node --env-file-if-exists=.env scripts/seed-merchant-analytics.mjs -- --with-audience",
    "import:venues": "node --env-file-if-exists=.env scripts/import-google-venues/run.mjs",
    "import:venues:discover": "node --env-file-if-exists=.env scripts/import-google-venues/discover.mjs",
    "import:venues:enrich": "node --env-file-if-exists=.env scripts/import-google-venues/enrich.mjs",
    "import:venues:backfill-atmosphere": "node --env-file-if-exists=.env scripts/import-google-venues/backfill-atmosphere.mjs",
    "import:venues:link-place-ids": "node --env-file-if-exists=.env scripts/import-google-venues/link-place-ids.mjs",
