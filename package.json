    "test:site-loaders": "node tests/site-loaders.test.mjs",
    "test:venue-listing-helpers": "esbuild tests/venue-listing-helpers.test.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env.PROD=false --outfile=.data/tests/venue-listing-helpers.bundle.mjs && node .data/tests/venue-listing-helpers.bundle.mjs",
    "test:venue-featured-image": "esbuild tests/venue-featured-image.test.mjs --bundle --platform=node --format=esm --packages=external --define:import.meta.env.PROD=false --outfile=.data/tests/venue-featured-image.bundle.mjs && node .data/tests/venue-featured-image.bundle.mjs",
