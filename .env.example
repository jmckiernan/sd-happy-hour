# Copy to .env for local dev, or set these in your Vercel project's Environment Variables.
# See README-BLOG-SETUP.md for how to obtain each of these.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=sd-happy-hour
GITHUB_BRANCH=main

# --- Accounts, saved lists, and venue submissions (see README-ACCOUNTS-SETUP.md) ---

# Vercel KV (or an Upstash Redis add-on connected via the Vercel Marketplace)
# stores user accounts, saved lists, and pending submissions. Once you connect
# a store to this project in the Vercel dashboard, these are injected
# automatically in Vercel deployments. For local dev, run:
#   vercel env pull .env.development.local
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Google Sign-In client ID (console.cloud.google.com -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application). This is public/embedded
# in the page, not a secret. Leave blank to fall back to email/password login.
GOOGLE_CLIENT_ID=

# No separate admin login — whoever signs in at /account/ (Google or
# email/password) with an email listed in src/lib/admins.ts (ADMIN_EMAILS)
# gets full admin rights: review/approve/deny submissions, generate blog
# posts. Edit that file directly to add/remove admins.
