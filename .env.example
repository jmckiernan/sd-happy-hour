# Copy to .env for local dev, or set these in your Netlify site's Environment Variables.
# See README-BLOG-SETUP.md for how to obtain each of these.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# AI hero-image generation/editing on the "Add Blog Post" / "Posts" admin
# screens. Get a key at aistudio.google.com/apikey. gemini-2.5-flash-image
# ("Nano Banana") handles both text-to-image generation and image+text
# editing through the same endpoint, so one key covers both features.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=sd-happy-hour
GITHUB_BRANCH=main

# --- Accounts, saved lists, and venue submissions (see README-ACCOUNTS-SETUP.md
# --- and README-NEON-MIGRATION.md for the data-layer design) ---

# Neon Postgres stores user accounts, saved lists, alerts, restaurant
# accounts, live overrides, promotions, submissions, and the notification
# log — everything that used to live in Upstash Redis (via @vercel/kv, now
# removed). Create a free project at neon.tech and paste both connection
# strings below (Neon's dashboard shows both — "pooled" for the app,
# "direct"/unpooled for migrations). Run `npm run migrate` once to create
# the schema.
#
# Local dev needs none of this set: `astro dev` (via Netlify's dev
# middleware) runs a real local Postgres automatically — see
# README-NEON-MIGRATION.md §10.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional product analytics. The application database remains authoritative;
# PostHog receives only allowlisted events, a pseudonymous user UUID, and
# coarse market-area keys. Names, emails, phone numbers, comments, list titles,
# and exact coordinates are never sent. Leave the key blank to keep all
# first-party reporting working without a third-party provider.
POSTHOG_ENABLED=true
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Public ingestion settings used by the deliberately limited browser tracker
# on /blog/. PostHog project tokens are designed to be public; never put a
# PostHog personal API key here. Browser autocapture and replay stay disabled.
PUBLIC_POSTHOG_ENABLED=true
PUBLIC_POSTHOG_PROJECT_API_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Keep local page loads out of production analytics unless deliberately testing.
PUBLIC_POSTHOG_ALLOW_LOCAL=false

# --- Merchant promotion entitlements ---
# Each plan's included Live promotions per San Diego calendar month is
# configured independently. Use a strictly positive integer or `unlimited`.
# Founding-partner status is assigned by comma-separated venue ids; payment
# processing is intentionally outside this phase.
PROMOTION_FREE_MONTHLY_LIMIT=1
PROMOTION_PRO_MONTHLY_LIMIT=unlimited
PROMOTION_FOUNDING_PARTNER_MONTHLY_LIMIT=unlimited
PROMOTION_FOUNDING_PARTNER_VENUE_IDS=

# Image storage (blog featured images) uses Netlify Blobs, which needs no
# env vars at all — it's built into every Netlify deploy automatically.

# Google Sign-In client ID (console.cloud.google.com -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application). This is public/embedded
# in the page, not a secret. Leave blank to fall back to email/password login.
GOOGLE_CLIENT_ID=

# No separate admin login — whoever signs in at /account/ (Google or
# email/password) with an email listed in src/lib/admins.ts (ADMIN_EMAILS)
# gets full admin rights: review/approve/deny submissions, generate blog
# posts. Edit that file directly to add/remove admins.

# --- Live alerts: email + text notifications (see README-NOTIFICATIONS-SETUP.md) ---

# Resend sends the email side of alerts — free and unlimited per user,
# unlike text. Create a free account at resend.com, verify a sending
# domain (or use their shared onboarding domain for testing), and paste an
# API key below. Without this set, emails are logged instead of sent (see
# src/lib/email.ts) — the whole alert pipeline still runs and is testable.
RESEND_API_KEY=
RESEND_FROM_EMAIL="SD Happy Hours <alerts@sdhappyhours.com>"

# Twilio sends the text side of alerts. Use a toll-free number with toll-free
# verification rather than a full 10DLC campaign registration — cheaper and
# faster to stand up for this app's volume (see the notification cost
# breakdown in README-NOTIFICATIONS-SETUP.md). Without these set, texts are
# logged instead of sent (see src/lib/sms.ts).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Hard cap on text messages per user per day, regardless of how many happy
# hours match their alerts in that window — the main lever that keeps SMS
# cost predictable. Defaults to 2 if unset. Email has no cap.
SMS_DAILY_CAP_PER_USER=2
