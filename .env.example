# Copy to .env for local dev, or set these in your Netlify site's Environment Variables.
# See README-BLOG-SETUP.md for how to obtain each of these.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# AI hero-image generation/editing on the "Add Blog Post" / "Posts" admin
# screens. Get a key at aistudio.google.com/apikey. gemini-2.5-flash-image
# ("Nano Banana") handles both text-to-image generation and image+text
# editing through the same endpoint, so one key covers both features.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=sd-happy-hour
GITHUB_BRANCH=main

# --- Accounts, saved lists, and venue submissions (see README-ACCOUNTS-SETUP.md) ---

# Upstash Redis (talked to via its plain REST API, so it works from any
# host) stores user accounts, saved lists, and pending submissions. Create a
# free database at upstash.com and paste its REST URL/token below. For
# local dev against the real store instead of the .data/ fallback, run:
#   netlify link
#   netlify env:pull .env.development.local
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Image storage (blog featured images) uses Netlify Blobs, which needs no
# env vars at all — it's built into every Netlify deploy automatically.

# Google Sign-In client ID (console.cloud.google.com -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application). This is public/embedded
# in the page, not a secret. Leave blank to fall back to email/password login.
GOOGLE_CLIENT_ID=

# No separate admin login — whoever signs in at /account/ (Google or
# email/password) with an email listed in src/lib/admins.ts (ADMIN_EMAILS)
# gets full admin rights: review/approve/deny submissions, generate blog
# posts. Edit that file directly to add/remove admins.
